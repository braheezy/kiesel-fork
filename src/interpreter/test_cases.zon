    // For-in/of statement
    .{
        .source =
        \\var sum = 0;
        \\for (var x of [1, 2, 3]) {
        \\  sum = sum + x;
        \\}
        \\sum;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       zero
        \\  %1: [  1..1  ]                       set_binding @0 ("sum"), %0
        \\  %2: [  2..5  ]                       one
        \\  %3: [  3..5  ]                       number 2
        \\  %4: [  4..5  ]                       number 3
        \\  %5: [  5..7  ]                       array [%2, %3, %4]
        \\  %6: [  6..8  ]                       undefined
        \\  %7: [  7..20 ]                       get_iterator %5
        \\  %8: [  8..8  ]                       br %9, %6
        \\  %9: [  9..22 ]                       label
        \\ %10: [ 10..15 ]                       iterator_step_value %7
        \\ %11: [ 11..12 ]                       iterator_is_done %7
        \\ %12: [ 12..13 ]                       logical_not %11
        \\ %13: [ 13..13 ]                       br_cond %12, %14, %21
        \\ %14: [ 14..14 ]                       label
        \\ %15: [ 15..15 ]                       set_binding @1 ("x"), %10
        \\ %16: [ 16..18 ]                       get_binding @0 ("sum")
        \\ %17: [ 17..18 ]                       get_binding @1 ("x")
        \\ %18: [ 18..19 ]                       add %16, %17
        \\ %19: [ 19..20 ]                       set_binding @0 ("sum"), %18
        \\ %20: [ 20..20 ]                       br %9, %19
        \\ %21: [ 21..21 ]                       label
        \\ %22: [ 22..22 ]                       br %23, %9
        \\ %23: [ 23..23 ]                       label
        \\ %24: [ 24..25 ]                       get_binding @0 ("sum")
        \\ %25: [ 25..25 ]                       return %24
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 00 00 00 00             load_number_i32 r0, 0
        \\   7: 46 00 00 00 00 00 00             set_binding @0 ("sum"), r0
        \\  14: 0b 01 00 00 00                   move r1, r0
        \\  19: 07 00 00 01 00 00 00             load_number_i32 r0, 1
        \\  26: 07 01 00 02 00 00 00             load_number_i32 r1, 2
