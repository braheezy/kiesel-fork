    // Try statement
    .{
        .source =
        \\try {} catch {}
        \\
        ,
        .expected_result = .{ .value = .undefined },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..5  ]                       label
        \\  %1: [  1..3  ]                       undefined
        \\  %2: [  2..5  ]                       label
        \\  %3: [  3..3  ]                       br %8, %1
        \\  %4: [  4..5  ]                       label
        \\  %5: [  5..5  ]                       exception_handler %0, %2, %4, 0
        \\  %6: [  6..7  ]                       undefined
        \\  %7: [  7..7  ]                       br %8, %6
        \\  %8: [  8..9  ]                       label
        \\  %9: [  9..9  ]                       return %8
