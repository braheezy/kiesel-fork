        \\ %36: [ 36..36 ]                       br_cond %35, %37, %45
        \\ %37: [ 37..37 ]                       label
        \\ %38: [ 38..38 ]                       push_scope
        \\ %39: [ 39..39 ]                       create_immutable_binding @4 ("_")
        \\ %40: [ 40..40 ]                       add_disposable_resource_sync %33
        \\ %41: [ 41..41 ]                       initialize_binding @4 ("_"), %33
        \\ %42: [ 42..42 ]                       dispose_resources
        \\ %43: [ 43..43 ]                       pop_scope
        \\ %44: [ 44..44 ]                       br %32, %29
        \\ %45: [ 45..45 ]                       label
        \\ %46: [ 46..46 ]                       br %47, %32
