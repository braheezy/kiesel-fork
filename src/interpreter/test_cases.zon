    // Break and continue
    .{
        .source =
        \\var x = 0;
        \\while(true) { x = x + 1; if (x >= 5) break; }
        \\for(;;) { x = x + 1; if (x >= 10) break; }
        \\while(x < 20) { x = x + 1; if (x % 2 === 0) continue; x = x + 10; }
        \\foo: { x = x + 100; break foo; x = x + 200; }
        \\x;
