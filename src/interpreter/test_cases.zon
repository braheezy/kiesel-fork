        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 03 01 00                         load_undefined r1
        \\   3: 0c 00 00 01 00                   move r0, r1
        \\   8: 91 00 00                         return r0
        \\  11: 03 00 00                         load_undefined r0
        \\  14: 00 f5 ff ff ff                   jump -11
        \\
        \\Exception handlers
        \\  [   0..3   ) →   11, r3, 0
        \\
        ,
    },
    .{
        .source =
        \\var x = 0;
        \\try {
        \\  throw 1;
        \\} catch (e) {
        \\  x += e;
        \\}
        \\try {
        \\  x += 2;
        \\} finally {
        \\  x += 3;
        \\}
        \\try {
        \\  throw 4;
        \\} catch (e) {
        \\  x += e;
        \\} finally {
        \\  x += 5;
        \\}
        \\x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 15 } },
        .expected_ir =
