        \\ 161: 4a 02 00 01 00 06 00 00 00 05 00 get_property r2, r1, @6 ("value"), @5
        \\ 172: 2a 01 00 00 00 02 00             add r1, r0, r2
        \\ 179: 78 01 00                         return r1
        \\
        \\IR (g)
