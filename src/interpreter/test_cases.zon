        \\  10: 62 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  17: 07 00 00 01                      load_number_i8 r0, 1
        \\  21: 29 01 00 02 00 00 00             add r1, r2, r0
        \\  28: 77 01 00                         return r1
