    // Switch statement
    .{
        .source =
        \\var x = 0;
        \\switch("b") {
        \\    case "a": x = 1; break;
        \\    case "b": let y = 2; x = y;
        \\    case "c": x = x + 3; break;
        \\    default: x = 100;
        \\}
        \\x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       zero
