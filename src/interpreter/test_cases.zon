    // Template literal
    .{
        .source =
        \\var empty = ``;
        \\`${empty}a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       string @0 ("")
        \\  %1: [  1..1  ]                       set_binding @1 ("empty"), %0
        \\  %2: [  2..3  ]                       get_binding @1 ("empty")
        \\  %3: [  3..5  ]                       to_string %2
        \\  %4: [  4..5  ]                       string @2 ("a")
        \\  %5: [  5..8  ]                       add %3, %4
        \\  %6: [  6..7  ]                       string @3 ("b")
        \\  %7: [  7..8  ]                       to_string %6
        \\  %8: [  8..10 ]                       add %5, %7
        \\  %9: [  9..10 ]                       string @4 ("c")
        \\ %10: [ 10..11 ]                       add %8, %9
        \\ %11: [ 11..11 ]                       return %10
        \\
        \\Bytecode (test)
        \\   0: 0a 00 00 00 00 00 00             load_string r0, @0 ("")
        \\   7: 4e 01 00 00 00 00 00             set_binding @1 ("empty"), r0
        \\  14: 49 00 00 01 00 00 00             get_binding r0, @1 ("empty")
        \\  21: 20 01 00 00 00                   to_string r1, r0
        \\  26: 0a 00 00 02 00 00 00             load_string r0, @2 ("a")
        \\  33: 2a 02 00 01 00 00 00             add r2, r1, r0
        \\  40: 0a 00 00 03 00 00 00             load_string r0, @3 ("b")
        \\  47: 20 01 00 00 00                   to_string r1, r0
        \\  52: 2a 00 00 02 00 01 00             add r0, r2, r1
        \\  59: 0a 01 00 04 00 00 00             load_string r1, @4 ("c")
        \\  66: 2a 02 00 00 00 01 00             add r2, r0, r1
        \\  73: 78 02 00                         return r2
        \\
        ,
    },

    // Tagged template
    .{
        .source =
        \\String.raw`a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..14 ]                       get_binding @0 ("String")
        \\  %1: [  1..14 ]                       get_property %0, @1 ("raw")
        \\  %2: [  2..12 ]                       array_create 2
        \\  %3: [  3..4  ]                       string @2 ("a")
        \\  %4: [  4..4  ]                       array_push %2, %3
        \\  %5: [  5..6  ]                       string @3 ("c")
        \\  %6: [  6..6  ]                       array_push %2, %5
        \\  %7: [  7..12 ]                       array_create 2
        \\  %8: [  8..9  ]                       string @2 ("a")
        \\  %9: [  9..9  ]                       array_push %7, %8
        \\ %10: [ 10..11 ]                       string @3 ("c")
        \\ %11: [ 11..11 ]                       array_push %7, %10
        \\ %12: [ 12..14 ]                       get_template_object %2, %7, 0
        \\ %13: [ 13..14 ]                       string @4 ("b")
        \\ %14: [ 14..15 ]                       call %1, %0, [%12, %13]
        \\ %15: [ 15..15 ]                       return %14
        \\
        \\Bytecode (test)
        \\   0: 49 00 00 00 00 00 00             get_binding r0, @0 ("String")
        \\   7: 4a 01 00 00 00 01 00 00 00 00 00 get_property r1, r0, @1 ("raw"), @0
        \\  18: 0d 02 00 02 00 00 00             array_create r2, 2
        \\  25: 0a 03 00 02 00 00 00             load_string r3, @2 ("a")
        \\  32: 10 02 00 03 00 00 00 00 00       array_set r2, r3, 0
        \\  41: 0a 03 00 03 00 00 00             load_string r3, @3 ("c")
        \\  48: 10 02 00 03 00 01 00 00 00       array_set r2, r3, 1
        \\  57: 0d 03 00 02 00 00 00             array_create r3, 2
        \\  64: 0a 04 00 02 00 00 00             load_string r4, @2 ("a")
        \\  71: 10 03 00 04 00 00 00 00 00       array_set r3, r4, 0
        \\  80: 0a 04 00 03 00 00 00             load_string r4, @3 ("c")
        \\  87: 10 03 00 04 00 01 00 00 00       array_set r3, r4, 1
        \\  96: 6c 04 00 02 00 03 00 00 00       get_template_object r4, r2, r3, 0
        \\ 105: 0a 02 00 04 00 00 00             load_string r2, @4 ("b")
        \\ 112: 65 03 00 01 00 00 00 04 00 02 00 call_property2 r3, r1, r0, r4, r2
        \\ 123: 78 03 00                         return r3
        \\
        ,
    },

    // Functions
    .{
        .source =
        \\var f = ({a}, b = 0, ...rest) => a + b + rest.length;
        \\f({a: 1}, 2, 3, 4);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       create_function @0
        \\  %1: [  1..1  ]                       set_binding @0 ("f"), %0
        \\  %2: [  2..9  ]                       get_binding @0 ("f")
        \\  %3: [  3..9  ]                       object_create
        \\  %4: [  4..5  ]                       number 1
        \\  %5: [  5..5  ]                       object_set %3, @1 ("a"), %4
        \\  %6: [  6..9  ]                       number 2
        \\  %7: [  7..9  ]                       number 3
        \\  %8: [  8..9  ]                       number 4
        \\  %9: [  9..10 ]                       call %2, none, [%3, %6, %7, %8]
        \\ %10: [ 10..10 ]                       return %9
        \\
        \\Bytecode (test)
        \\   0: 7c 00 00 00 00                   create_function r0, @0
        \\   5: 4e 00 00 00 00 00 00             set_binding @0 ("f"), r0
        \\  12: 49 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\  19: 12 01 00                         object_create r1
        \\  22: 07 02 00 01                      load_number_i8 r2, 1
        \\  26: 13 01 00 01 00 00 00 02 00       object_set r1, @1 ("a"), r2
        \\  35: 07 02 00 02                      load_number_i8 r2, 2
        \\  39: 07 03 00 03                      load_number_i8 r3, 3
        \\  43: 07 04 00 04                      load_number_i8 r4, 4
        \\  47: 0d 06 00 00 00 00 00             array_create r6, 0
        \\  54: 0e 06 00 01 00                   array_push r6, r1
        \\  59: 0e 06 00 02 00                   array_push r6, r2
        \\  64: 0e 06 00 03 00                   array_push r6, r3
        \\  69: 0e 06 00 04 00                   array_push r6, r4
        \\  74: 5e 05 00 00 00 06 00             call r5, r0, r6
        \\  81: 78 05 00                         return r5
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       create_mutable_binding @0 ("a")
        \\  %2: [  2..2  ]                       create_mutable_binding @1 ("b")
        \\  %3: [  3..3  ]                       create_mutable_binding @2 ("rest")
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..7  ]                       get_property %5, @0 ("a")
        \\  %7: [  7..7  ]                       initialize_binding @0 ("a"), %6
        \\  %8: [  8..16 ]                       get_argument 1
        \\  %9: [  9..10 ]                       undefined
        \\ %10: [ 10..11 ]                       eq_strict %8, %9
        \\ %11: [ 11..11 ]                       br_cond %10, %12, %15
        \\ %12: [ 12..12 ]                       label
        \\ %13: [ 13..14 ]                       number 0
        \\ %14: [ 14..14 ]                       br %17, %13
        \\ %15: [ 15..15 ]                       label
        \\ %16: [ 16..16 ]                       br %17, %8
        \\ %17: [ 17..18 ]                       label
        \\ %18: [ 18..18 ]                       initialize_binding @1 ("b"), %17
        \\ %19: [ 19..20 ]                       get_rest_arguments 2
        \\ %20: [ 20..20 ]                       initialize_binding @2 ("rest"), %19
        \\ %21: [ 21..21 ]                       push_var_scope
        \\ %22: [ 22..22 ]                       push_scope
        \\ %23: [ 23..25 ]                       get_binding @0 ("a")
        \\ %24: [ 24..25 ]                       get_binding @1 ("b")
        \\ %25: [ 25..28 ]                       add %23, %24
        \\ %26: [ 26..27 ]                       get_binding @2 ("rest")
        \\ %27: [ 27..28 ]                       get_property %26, @3 ("length")
        \\ %28: [ 28..29 ]                       add %25, %27
        \\ %29: [ 29..29 ]                       return %28
        \\ %30: [ 30..30 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 40                               push_scope
        \\   1: 45 00 00 00 00                   create_mutable_binding @0 ("a")
        \\   6: 45 01 00 00 00                   create_mutable_binding @1 ("b")
        \\  11: 45 02 00 00 00                   create_mutable_binding @2 ("rest")
        \\  16: 81 00 00 00 00                   get_argument r0, 0
        \\  21: 21 01 00 00 00                   to_object r1, r0
        \\  26: 4a 00 00 01 00 00 00 00 00 00 00 get_property r0, r1, @0 ("a"), @0
        \\  37: 47 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  44: 81 00 00 01 00                   get_argument r0, 1
        \\  49: 03 01 00                         load_undefined r1
        \\  52: 3e 02 00 00 00 01 00             eq_strict r2, r0, r1
        \\  59: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  66: 00 0e 00 00 00                   jump 14
        \\  71: 07 01 00 00                      load_number_i8 r1, 0
        \\  75: 0c 00 00 01 00                   move r0, r1
        \\  80: 00 00 00 00 00                   jump 0
        \\  85: 47 01 00 00 00 00 00             initialize_binding @1 ("b"), r0
        \\  92: 82 00 00 02 00                   get_rest_arguments r0, 2
        \\  97: 47 02 00 00 00 00 00             initialize_binding @2 ("rest"), r0
        \\ 104: 41                               push_var_scope
        \\ 105: 40                               push_scope
        \\ 106: 49 00 00 00 00 00 00             get_binding r0, @0 ("a")
        \\ 113: 49 01 00 01 00 00 00             get_binding r1, @1 ("b")
        \\ 120: 2a 02 00 00 00 01 00             add r2, r0, r1
        \\ 127: 49 00 00 02 00 00 00             get_binding r0, @2 ("rest")
        \\ 134: 4a 01 00 00 00 03 00 00 00 01 00 get_property r1, r0, @3 ("length"), @1
        \\ 145: 2a 00 00 02 00 01 00             add r0, r2, r1
        \\ 152: 78 00 00                         return r0
        \\
        ,
    },

    // Arguments object
    .{
        .source =
        \\function mapped(a) {
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\function unmapped(a) {
        \\  "use strict";
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\mapped(1) - unmapped(1);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 98 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..2  ]                       get_binding @0 ("mapped")
        \\  %1: [  1..2  ]                       number 1
        \\  %2: [  2..6  ]                       call %0, none, [%1]
        \\  %3: [  3..5  ]                       get_binding @1 ("unmapped")
        \\  %4: [  4..5  ]                       number 1
        \\  %5: [  5..6  ]                       call %3, none, [%4]
        \\  %6: [  6..7  ]                       sub %2, %5
        \\  %7: [  7..7  ]                       return %6
        \\
        \\Bytecode (test)
        \\   0: 49 00 00 00 00 00 00             get_binding r0, @0 ("mapped")
        \\   7: 07 01 00 01                      load_number_i8 r1, 1
        \\  11: 60 02 00 00 00 01 00             call1 r2, r0, r1
        \\  18: 49 00 00 01 00 00 00             get_binding r0, @1 ("unmapped")
        \\  25: 07 01 00 01                      load_number_i8 r1, 1
        \\  29: 60 03 00 00 00 01 00             call1 r3, r0, r1
        \\  36: 2b 00 00 02 00 03 00             sub r0, r2, r3
        \\  43: 78 00 00                         return r0
        \\
        \\IR (mapped)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("a")
        \\  %1: [  1..3  ]                       create_mapped_arguments_object
        \\  %2: [  2..2  ]                       create_mutable_binding @1 ("arguments")
        \\  %3: [  3..3  ]                       initialize_binding @1 ("arguments"), %1
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ]                       push_scope
        \\  %7: [  7..8  ]                       number 99
        \\  %8: [  8..8  ]                       set_binding @0 ("a"), %7
        \\  %9: [  9..10 ]                       get_binding @1 ("arguments")
        \\ %10: [ 10..11 ]                       get_property_indexed %9, 0
        \\ %11: [ 11..11 ]                       return %10
        \\ %12: [ 12..12 ] dead                  return none
        \\
        \\Bytecode (mapped)
        \\   0: 45 00 00 00 00                   create_mutable_binding @0 ("a")
        \\   5: 80 00 00                         create_mapped_arguments_object r0
        \\   8: 45 01 00 00 00                   create_mutable_binding @1 ("arguments")
        \\  13: 47 01 00 00 00 00 00             initialize_binding @1 ("arguments"), r0
        \\  20: 81 00 00 00 00                   get_argument r0, 0
        \\  25: 47 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  32: 40                               push_scope
        \\  33: 07 00 00 63                      load_number_i8 r0, 99
        \\  37: 4e 00 00 00 00 00 00             set_binding @0 ("a"), r0
        \\  44: 49 00 00 01 00 00 00             get_binding r0, @1 ("arguments")
        \\  51: 4c 01 00 00 00 00 00 00 00       get_property_indexed r1, r0, 0
        \\  60: 78 01 00                         return r1
        \\
        \\IR (unmapped)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("a")
        \\  %1: [  1..3  ]                       create_unmapped_arguments_object
        \\  %2: [  2..2  ]                       create_immutable_binding @1 ("arguments")
        \\  %3: [  3..3  ]                       initialize_binding @1 ("arguments"), %1
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ] dead                  string @2 ("use strict")
        \\  %7: [  7..8  ]                       number 99
        \\  %8: [  8..8  ]                       set_binding_strict @0 ("a"), %7
        \\  %9: [  9..10 ]                       get_binding @1 ("arguments")
        \\ %10: [ 10..11 ]                       get_property_indexed %9, 0
        \\ %11: [ 11..11 ]                       return %10
        \\ %12: [ 12..12 ] dead                  return none
        \\
        \\Bytecode (unmapped)
        \\   0: 7f 00 00                         create_unmapped_arguments_object r0
        \\   3: 4d 01 00 00 00                   set_local l1, r0
        \\   8: 81 00 00 00 00                   get_argument r0, 0
        \\  13: 4d 00 00 00 00                   set_local l0, r0
        \\  18: 07 00 00 63                      load_number_i8 r0, 99
        \\  22: 4d 00 00 00 00                   set_local l0, r0
        \\  27: 48 00 00 01 00                   get_local r0, l1
        \\  32: 4c 01 00 00 00 00 00 00 00       get_property_indexed r1, r0, 0
        \\  41: 78 01 00                         return r1
        \\
        ,
    },

    // Getter/setter
    .{
        .source =
        \\var o = {
        \\  get x() { return this._x; },
        \\  set x(v) { this._x = v; },
        \\};
        \\o.x = 42;
        \\o.x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 42 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..7  ]                       object_create
        \\  %1: [  1..2  ]                       create_function @0
        \\  %2: [  2..3  ]                       getter %1
        \\  %3: [  3..3  ]                       object_set %0, @0 ("x"), %2
        \\  %4: [  4..5  ]                       create_function @1
        \\  %5: [  5..6  ]                       setter %4
        \\  %6: [  6..6  ]                       object_set %0, @0 ("x"), %5
        \\  %7: [  7..7  ]                       set_binding @3 ("o"), %0
        \\  %8: [  8..10 ]                       get_binding @3 ("o")
        \\  %9: [  9..10 ]                       number 42
        \\ %10: [ 10..10 ]                       set_property %8, @0 ("x"), %9
        \\ %11: [ 11..12 ]                       get_binding @3 ("o")
        \\ %12: [ 12..13 ]                       get_property %11, @0 ("x")
        \\ %13: [ 13..13 ]                       return %12
        \\
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 7c 01 00 00 00                   create_function r1, @0
        \\   8: 0c 02 00 01 00                   move r2, r1
        \\  13: 7e 02 00 00 00                   set_home_object r2, r0
        \\  18: 15 00 00 00 00 00 00 02 00       object_set_getter r0, @0 ("x"), r2
        \\  27: 7c 01 00 01 00                   create_function r1, @1
        \\  32: 0c 02 00 01 00                   move r2, r1
        \\  37: 7e 02 00 00 00                   set_home_object r2, r0
        \\  42: 17 00 00 00 00 00 00 02 00       object_set_setter r0, @0 ("x"), r2
        \\  51: 4e 03 00 00 00 00 00             set_binding @3 ("o"), r0
        \\  58: 49 00 00 03 00 00 00             get_binding r0, @3 ("o")
        \\  65: 07 01 00 2a                      load_number_i8 r1, 42
        \\  69: 50 00 00 01 00 00 00 00 00 00 00 set_property r0, r1, @0 ("x"), @0
        \\  80: 49 00 00 03 00 00 00             get_binding r0, @3 ("o")
        \\  87: 4a 01 00 00 00 00 00 00 00 00 00 get_property r1, r0, @0 ("x"), @0
        \\  98: 78 01 00                         return r1
        \\
        \\IR (get x)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..2  ]                       this
        \\  %2: [  2..3  ]                       get_property %1, @0 ("_x")
        \\  %3: [  3..3  ]                       return %2
        \\  %4: [  4..4  ] dead                  return none
        \\
        \\Bytecode (get x)
        \\   0: 40                               push_scope
        \\   1: 1c 00 00                         resolve_this_binding r0
        \\   4: 4a 01 00 00 00 00 00 00 00 00 00 get_property r1, r0, @0 ("_x"), @0
        \\  15: 78 01 00                         return r1
        \\
        \\IR (set x)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("v")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("v"), %1
        \\  %3: [  3..3  ]                       push_scope
        \\  %4: [  4..6  ]                       this
        \\  %5: [  5..6  ]                       get_binding @0 ("v")
        \\  %6: [  6..6  ]                       set_property %4, @1 ("_x"), %5
        \\  %7: [  7..7  ]                       return none
        \\
        \\Bytecode (set x)
        \\   0: 81 00 00 00 00                   get_argument r0, 0
        \\   5: 4d 00 00 00 00                   set_local l0, r0
        \\  10: 40                               push_scope
        \\  11: 1c 00 00                         resolve_this_binding r0
        \\  14: 48 01 00 00 00                   get_local r1, l0
        \\  19: 50 00 00 01 00 01 00 00 00 00 00 set_property r0, r1, @1 ("_x"), @0
        \\  30: 78 ff ff                         return
        \\
        ,
    },

    // Generator
    .{
        .source =
        \\function* h() {
        \\  yield 4;
        \\  yield 5;
        \\}
        \\function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\  yield* h();
        \\}
        \\function f() {
        \\  var gen = g();
        \\  var sum = 0;
        \\  while (true) {
        \\    var result = gen.next();
        \\    if (result.done) break;
        \\    sum += result.value;
        \\  }
        \\  return sum;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 15 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       get_binding @0 ("f")
        \\  %1: [  1..2  ]                       call %0, none, []
        \\  %2: [  2..2  ]                       return %1
        \\
        \\Bytecode (test)
        \\   0: 49 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\   7: 5f 01 00 00 00                   call0 r1, r0
        \\  12: 78 01 00                         return r1
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       create_var_binding @0 ("gen")
        \\  %1: [  1..1  ]                       create_var_binding @1 ("sum")
        \\  %2: [  2..2  ]                       create_var_binding @2 ("result")
        \\  %3: [  3..3  ]                       push_scope
        \\  %4: [  4..5  ]                       get_binding @3 ("g")
        \\  %5: [  5..6  ]                       call %4, none, []
        \\  %6: [  6..6  ]                       set_binding @0 ("gen"), %5
        \\  %7: [  7..8  ]                       number 0
        \\  %8: [  8..8  ]                       set_binding @1 ("sum"), %7
        \\  %9: [  9..37 ]                       undefined
        \\ %10: [ 10..10 ]                       br %11, %9
        \\ %11: [ 11..39 ]                       label
        \\ %12: [ 12..13 ]                       true
        \\ %13: [ 13..14 ]                       to_boolean %12
        \\ %14: [ 14..14 ]                       br_cond %13, %15, %38
        \\ %15: [ 15..15 ]                       label
        \\ %16: [ 16..18 ]                       get_binding @0 ("gen")
        \\ %17: [ 17..18 ]                       get_property %16, @4 ("next")
        \\ %18: [ 18..19 ]                       call %17, %16, []
        \\ %19: [ 19..19 ]                       set_binding @2 ("result"), %18
        \\ %20: [ 20..21 ]                       get_binding @2 ("result")
        \\ %21: [ 21..22 ]                       get_property %20, @5 ("done")
        \\ %22: [ 22..23 ]                       to_boolean %21
        \\ %23: [ 23..23 ]                       br_cond %22, %24, %28
        \\ %24: [ 24..24 ]                       label
        \\ %25: [ 25..25 ]                       br %40, %9
        \\ %26: [ 26..27 ] dead                  undefined
        \\ %27: [ 27..27 ] dead                  br %31, %26
        \\ %28: [ 28..28 ]                       label
        \\ %29: [ 29..30 ]                       undefined
        \\ %30: [ 30..30 ]                       br %31, %29
        \\ %31: [ 31..31 ]                       label
        \\ %32: [ 32..35 ]                       get_binding @1 ("sum")
        \\ %33: [ 33..34 ]                       get_binding @2 ("result")
        \\ %34: [ 34..35 ]                       get_property %33, @6 ("value")
        \\ %35: [ 35..36 ]                       add %32, %34
        \\ %36: [ 36..37 ]                       set_binding @1 ("sum"), %35
        \\ %37: [ 37..37 ]                       br %11, %36
        \\ %38: [ 38..38 ]                       label
        \\ %39: [ 39..39 ]                       br %40, %11
        \\ %40: [ 40..40 ]                       label
        \\ %41: [ 41..42 ]                       get_binding @1 ("sum")
        \\ %42: [ 42..42 ]                       return %41
        \\ %43: [ 43..43 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 40                               push_scope
        \\   1: 49 00 00 03 00 00 00             get_binding r0, @3 ("g")
        \\   8: 5f 01 00 00 00                   call0 r1, r0
        \\  13: 4d 00 00 01 00                   set_local l0, r1
        \\  18: 07 00 00 00                      load_number_i8 r0, 0
        \\  22: 4d 01 00 00 00                   set_local l1, r0
        \\  27: 03 00 00                         load_undefined r0
        \\  30: 0c 01 00 00 00                   move r1, r0
        \\  35: 05 02 00                         load_true r2
        \\  38: 1d 03 00 02 00                   to_boolean r3, r2
        \\  43: 01 03 00 05 00 00 00             jump_if_true r3, 5
        \\  50: 00 75 00 00 00                   jump 117
        \\  55: 48 02 00 00 00                   get_local r2, l0
        \\  60: 4a 03 00 02 00 04 00 00 00 00 00 get_property r3, r2, @4 ("next"), @0
        \\  71: 63 04 00 03 00 02 00             call_property0 r4, r3, r2
        \\  78: 4d 02 00 04 00                   set_local l2, r4
        \\  83: 48 02 00 02 00                   get_local r2, l2
        \\  88: 4a 03 00 02 00 05 00 00 00 01 00 get_property r3, r2, @5 ("done"), @1
        \\  99: 1d 02 00 03 00                   to_boolean r2, r3
        \\ 104: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 111: 00 05 00 00 00                   jump 5
        \\ 116: 00 33 00 00 00                   jump 51
        \\ 121: 03 02 00                         load_undefined r2
        \\ 124: 48 02 00 01 00                   get_local r2, l1
        \\ 129: 48 03 00 02 00                   get_local r3, l2
        \\ 134: 4a 04 00 03 00 06 00 00 00 02 00 get_property r4, r3, @6 ("value"), @2
        \\ 145: 2a 03 00 02 00 04 00             add r3, r2, r4
        \\ 152: 4d 01 00 03 00                   set_local l1, r3
        \\ 157: 0c 02 00 03 00                   move r2, r3
        \\ 162: 0c 01 00 02 00                   move r1, r2
        \\ 167: 00 77 ff ff ff                   jump -137
        \\ 172: 48 00 00 01 00                   get_local r0, l1
        \\ 177: 78 00 00                         return r0
        \\
        \\IR (g)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       number 1
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 2
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..7  ]                       number 3
        \\  %7: [  7..7  ]                       yield %6
        \\  %8: [  8..9  ]                       get_binding @0 ("h")
        \\  %9: [  9..10 ]                       call %8, none, []
        \\ %10: [ 10..11 ]                       get_iterator %9
        \\ %11: [ 11..11 ]                       yield_star %10
        \\ %12: [ 12..12 ]                       return none
        \\
        \\Bytecode (g)
        \\   0: 40                               push_scope
        \\   1: 7a ff ff ff ff                   yield
        \\   6: 07 00 00 01                      load_number_i8 r0, 1
        \\  10: 7a 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 02                      load_number_i8 r0, 2
        \\  19: 7a 01 00 00 00                   yield r1, r0
        \\  24: 07 00 00 03                      load_number_i8 r0, 3
        \\  28: 7a 01 00 00 00                   yield r1, r0
        \\  33: 49 00 00 00 00 00 00             get_binding r0, @0 ("h")
        \\  40: 5f 01 00 00 00                   call0 r1, r0
        \\  45: 6d 00 00 01 00                   get_iterator r0, r1
        \\  50: 03 01 00                         load_undefined r1
        \\  53: 7b 01 00 00 00                   yield_star r1, r0
        \\  58: 78 ff ff                         return
        \\
        \\IR (h)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       number 4
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 5
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..6  ]                       return none
        \\
        \\Bytecode (h)
        \\   0: 40                               push_scope
        \\   1: 7a ff ff ff ff                   yield
        \\   6: 07 00 00 04                      load_number_i8 r0, 4
        \\  10: 7a 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 05                      load_number_i8 r0, 5
        \\  19: 7a 01 00 00 00                   yield r1, r0
        \\  24: 78 ff ff                         return
        \\
        ,
    },

    // Async Generator
    .{
        .source =
        \\async function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\}
        \\async function f() {
        \\  var gen = g();
        \\  var a = await gen.next();
        \\  var b = await gen.next();
        \\  var c = await gen.next();
        \\  return a.value + b.value + c.value;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .promise = .{ .fulfilled = .{ .number = 6 } } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       get_binding @0 ("f")
        \\  %1: [  1..2  ]                       call %0, none, []
        \\  %2: [  2..2  ]                       return %1
        \\
        \\Bytecode (test)
        \\   0: 49 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\   7: 5f 01 00 00 00                   call0 r1, r0
        \\  12: 78 01 00                         return r1
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       create_var_binding @0 ("gen")
        \\  %1: [  1..1  ]                       create_var_binding @1 ("a")
        \\  %2: [  2..2  ]                       create_var_binding @2 ("b")
        \\  %3: [  3..3  ]                       create_var_binding @3 ("c")
        \\  %4: [  4..4  ]                       push_scope
        \\  %5: [  5..6  ]                       get_binding @4 ("g")
        \\  %6: [  6..7  ]                       call %5, none, []
        \\  %7: [  7..7  ]                       set_binding @0 ("gen"), %6
        \\  %8: [  8..10 ]                       get_binding @0 ("gen")
        \\  %9: [  9..10 ]                       get_property %8, @5 ("next")
        \\ %10: [ 10..11 ]                       call %9, %8, []
        \\ %11: [ 11..12 ]                       await %10
        \\ %12: [ 12..12 ]                       set_binding @1 ("a"), %11
        \\ %13: [ 13..15 ]                       get_binding @0 ("gen")
        \\ %14: [ 14..15 ]                       get_property %13, @5 ("next")
        \\ %15: [ 15..16 ]                       call %14, %13, []
        \\ %16: [ 16..17 ]                       await %15
        \\ %17: [ 17..17 ]                       set_binding @2 ("b"), %16
        \\ %18: [ 18..20 ]                       get_binding @0 ("gen")
        \\ %19: [ 19..20 ]                       get_property %18, @5 ("next")
        \\ %20: [ 20..21 ]                       call %19, %18, []
        \\ %21: [ 21..22 ]                       await %20
        \\ %22: [ 22..22 ]                       set_binding @3 ("c"), %21
        \\ %23: [ 23..24 ]                       get_binding @1 ("a")
        \\ %24: [ 24..27 ]                       get_property %23, @6 ("value")
        \\ %25: [ 25..26 ]                       get_binding @2 ("b")
        \\ %26: [ 26..27 ]                       get_property %25, @6 ("value")
        \\ %27: [ 27..30 ]                       add %24, %26
        \\ %28: [ 28..29 ]                       get_binding @3 ("c")
        \\ %29: [ 29..30 ]                       get_property %28, @6 ("value")
        \\ %30: [ 30..31 ]                       add %27, %29
        \\ %31: [ 31..31 ]                       return %30
        \\ %32: [ 32..32 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 40                               push_scope
        \\   1: 49 00 00 04 00 00 00             get_binding r0, @4 ("g")
        \\   8: 5f 01 00 00 00                   call0 r1, r0
        \\  13: 4d 00 00 01 00                   set_local l0, r1
        \\  18: 48 00 00 00 00                   get_local r0, l0
        \\  23: 4a 01 00 00 00 05 00 00 00 00 00 get_property r1, r0, @5 ("next"), @0
        \\  34: 63 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  41: 79 00 00 02 00                   await r0, r2
        \\  46: 4d 01 00 00 00                   set_local l1, r0
        \\  51: 48 00 00 00 00                   get_local r0, l0
        \\  56: 4a 01 00 00 00 05 00 00 00 01 00 get_property r1, r0, @5 ("next"), @1
        \\  67: 63 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  74: 79 00 00 02 00                   await r0, r2
        \\  79: 4d 02 00 00 00                   set_local l2, r0
        \\  84: 48 00 00 00 00                   get_local r0, l0
        \\  89: 4a 01 00 00 00 05 00 00 00 02 00 get_property r1, r0, @5 ("next"), @2
        \\ 100: 63 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\ 107: 79 00 00 02 00                   await r0, r2
        \\ 112: 4d 03 00 00 00                   set_local l3, r0
        \\ 117: 48 00 00 01 00                   get_local r0, l1
        \\ 122: 4a 01 00 00 00 06 00 00 00 03 00 get_property r1, r0, @6 ("value"), @3
        \\ 133: 48 00 00 02 00                   get_local r0, l2
        \\ 138: 4a 02 00 00 00 06 00 00 00 04 00 get_property r2, r0, @6 ("value"), @4
        \\ 149: 2a 00 00 01 00 02 00             add r0, r1, r2
