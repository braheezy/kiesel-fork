    // For-in/of statement
    .{
        .source =
        \\var sum = 0;
        \\for (var x of [1, 2, 3]) {
        \\  sum = sum + x;
        \\}
        \\sum;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       number 0
