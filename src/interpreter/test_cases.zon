        \\  11: 03 00 00                         load_undefined r0
        \\  14: 00 f5 ff ff ff                   jump -11
        \\
        \\Exception handlers
        \\  [   0..3   ) →   11, r3, 0
        \\
        ,
    },
    .{
        .source =
        \\var x = 0;
        \\try {
        \\  throw 1;
        \\} catch (e) {
        \\  x += e;
        \\}
        \\try {
        \\  x += 2;
        \\} finally {
        \\  x += 3;
        \\}
        \\try {
        \\  throw 4;
        \\} catch (e) {
        \\  x += e;
        \\} finally {
        \\  x += 5;
        \\}
        \\x;
        \\
        ,
