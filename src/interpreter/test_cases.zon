    // For-in/of statement
    .{
        .source =
        \\var sum = 0;
        \\for (var x of [1, 2, 3]) {
        \\  sum = sum + x;
        \\}
        \\sum;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       zero
        \\  %1: [  1..1  ]                       set_binding @0 ("sum"), %0
        \\  %2: [  2..10 ]                       array_create 3
        \\  %3: [  3..4  ]                       one
        \\  %4: [  4..4  ]                       array_push %2, %3
        \\  %5: [  5..6  ]                       number 2
        \\  %6: [  6..6  ]                       array_push %2, %5
        \\  %7: [  7..8  ]                       number 3
        \\  %8: [  8..8  ]                       array_push %2, %7
        \\  %9: [  9..11 ]                       undefined
        \\ %10: [ 10..23 ]                       get_iterator %2
        \\ %11: [ 11..11 ]                       br %12, %9
        \\ %12: [ 12..25 ]                       label
        \\ %13: [ 13..18 ]                       iterator_step_value %10
        \\ %14: [ 14..15 ]                       iterator_is_done %10
        \\ %15: [ 15..16 ]                       logical_not %14
        \\ %16: [ 16..16 ]                       br_cond %15, %17, %24
        \\ %17: [ 17..17 ]                       label
        \\ %18: [ 18..18 ]                       set_binding @1 ("x"), %13
        \\ %19: [ 19..21 ]                       get_binding @0 ("sum")
        \\ %20: [ 20..21 ]                       get_binding @1 ("x")
        \\ %21: [ 21..22 ]                       add %19, %20
        \\ %22: [ 22..23 ]                       set_binding @0 ("sum"), %21
        \\ %23: [ 23..23 ]                       br %12, %22
        \\ %24: [ 24..24 ]                       label
        \\ %25: [ 25..25 ]                       br %26, %12
        \\ %26: [ 26..26 ]                       label
        \\ %27: [ 27..28 ]                       get_binding @0 ("sum")
        \\ %28: [ 28..28 ]                       return %27
        \\
        \\Bytecode (test)
        \\   0: 07 00 00 00                      load_number_i8 r0, 0
        \\   4: 4d 00 00 00 00 00 00             set_binding @0 ("sum"), r0
        \\  11: 0d 00 00 03 00 00 00             array_create r0, 3
        \\  18: 07 01 00 01                      load_number_i8 r1, 1
        \\  22: 10 00 00 01 00 00 00 00 00       array_set r0, r1, 0
        \\  31: 07 01 00 02                      load_number_i8 r1, 2
        \\  35: 10 00 00 01 00 01 00 00 00       array_set r0, r1, 1
        \\  44: 07 01 00 03                      load_number_i8 r1, 3
        \\  48: 10 00 00 01 00 02 00 00 00       array_set r0, r1, 2
        \\  57: 03 01 00                         load_undefined r1
        \\  60: 6c 02 00 00 00                   get_iterator r2, r0
        \\  65: 0c 00 00 01 00                   move r0, r1
        \\  70: 70 01 00 02 00                   iterator_step_value r1, r2
        \\  75: 73 03 00 02 00                   iterator_is_done r3, r2
        \\  80: 25 04 00 03 00                   logical_not r4, r3
        \\  85: 01 04 00 05 00 00 00             jump_if_true r4, 5
        \\  92: 00 32 00 00 00                   jump 50
        \\  97: 4d 01 00 00 00 01 00             set_binding @1 ("x"), r1
        \\ 104: 48 01 00 00 00 00 00             get_binding r1, @0 ("sum")
        \\ 111: 48 03 00 01 00 00 00             get_binding r3, @1 ("x")
        \\ 118: 29 04 00 01 00 03 00             add r4, r1, r3
        \\ 125: 4d 00 00 00 00 04 00             set_binding @0 ("sum"), r4
        \\ 132: 0c 01 00 04 00                   move r1, r4
        \\ 137: 0c 00 00 01 00                   move r0, r1
        \\ 142: 00 b3 ff ff ff                   jump -77
        \\ 147: 48 00 00 00 00 00 00             get_binding r0, @0 ("sum")
        \\ 154: 77 00 00                         return r0
        \\
        ,
    },

    // For-in/of with member expression LHS
    .{
        .source =
        \\var x = {};
        \\for (x.last in {a: 1, b: 2, c: 3});
        \\x.last;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "c" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       object_create
        \\  %1: [  1..1  ]                       set_binding @0 ("x"), %0
        \\  %2: [  2..14 ]                       object_create
        \\  %3: [  3..4  ]                       one
        \\  %4: [  4..4  ]                       object_set %2, @1 ("a"), %3
        \\  %5: [  5..6  ]                       number 2
        \\  %6: [  6..6  ]                       object_set %2, @2 ("b"), %5
        \\  %7: [  7..8  ]                       number 3
        \\  %8: [  8..8  ]                       object_set %2, @3 ("c"), %7
        \\  %9: [  9..28 ]                       undefined
        \\ %10: [ 10..11 ]                       null
        \\ %11: [ 11..12 ]                       eq %2, %10
        \\ %12: [ 12..12 ]                       br_cond %11, %27, %13
        \\ %13: [ 13..13 ]                       label
        \\ %14: [ 14..24 ]                       get_for_in_iterator %2
        \\ %15: [ 15..15 ]                       br %16, %9
        \\ %16: [ 16..26 ]                       label
        \\ %17: [ 17..23 ]                       iterator_step_value %14
        \\ %18: [ 18..19 ]                       iterator_is_done %14
        \\ %19: [ 19..20 ]                       logical_not %18
        \\ %20: [ 20..20 ]                       br_cond %19, %21, %25
        \\ %21: [ 21..21 ]                       label
        \\ %22: [ 22..23 ]                       get_binding @0 ("x")
        \\ %23: [ 23..23 ]                       set_property %22, @4 ("last"), %17
        \\ %24: [ 24..24 ]                       br %16, %9
        \\ %25: [ 25..25 ]                       label
        \\ %26: [ 26..26 ]                       br %29, %16
        \\ %27: [ 27..27 ]                       label
        \\ %28: [ 28..28 ]                       br %29, %9
        \\ %29: [ 29..29 ]                       label
        \\ %30: [ 30..31 ]                       get_binding @0 ("x")
        \\ %31: [ 31..32 ]                       get_property %30, @4 ("last")
        \\ %32: [ 32..32 ]                       return %31
        \\
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 4d 00 00 00 00 00 00             set_binding @0 ("x"), r0
        \\  10: 12 00 00                         object_create r0
        \\  13: 07 01 00 01                      load_number_i8 r1, 1
        \\  17: 13 00 00 01 00 00 00 01 00       object_set r0, @1 ("a"), r1
        \\  26: 07 01 00 02                      load_number_i8 r1, 2
        \\  30: 13 00 00 02 00 00 00 01 00       object_set r0, @2 ("b"), r1
        \\  39: 07 01 00 03                      load_number_i8 r1, 3
        \\  43: 13 00 00 03 00 00 00 01 00       object_set r0, @3 ("c"), r1
        \\  52: 03 01 00                         load_undefined r1
        \\  55: 04 02 00                         load_null r2
        \\  58: 3b 03 00 00 00 02 00             eq r3, r0, r2
        \\  65: 01 03 00 05 00 00 00             jump_if_true r3, 5
        \\  72: 00 05 00 00 00                   jump 5
        \\  77: 00 41 00 00 00                   jump 65
        \\  82: 6e 02 00 00 00                   get_for_in_iterator r2, r0
        \\  87: 0c 00 00 01 00                   move r0, r1
        \\  92: 70 03 00 02 00                   iterator_step_value r3, r2
        \\  97: 73 04 00 02 00                   iterator_is_done r4, r2
        \\ 102: 25 05 00 04 00                   logical_not r5, r4
        \\ 107: 01 05 00 05 00 00 00             jump_if_true r5, 5
        \\ 114: 00 1c 00 00 00                   jump 28
        \\ 119: 48 04 00 00 00 00 00             get_binding r4, @0 ("x")
        \\ 126: 4f 04 00 03 00 04 00 00 00 00 00 set_property r4, r3, @4 ("last"), @0
        \\ 137: 0c 00 00 01 00                   move r0, r1
        \\ 142: 00 c9 ff ff ff                   jump -55
        \\ 147: 48 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\ 154: 49 01 00 00 00 04 00 00 00 00 00 get_property r1, r0, @4 ("last"), @0
        \\ 165: 77 01 00                         return r1
        \\
        ,
    },

    // With statement
    .{
        .source =
        \\var o = {x: 1};
        \\with (o) { x }
        \\
        ,
        .expected_result = .{ .value = .{ .number = 1 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..3  ]                       object_create
        \\  %1: [  1..2  ]                       one
        \\  %2: [  2..2  ]                       object_set %0, @0 ("x"), %1
        \\  %3: [  3..3  ]                       set_binding @1 ("o"), %0
        \\  %4: [  4..5  ]                       get_binding @1 ("o")
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..6  ]                       push_with_scope %5
        \\  %7: [  7..9  ]                       get_binding @0 ("x")
        \\  %8: [  8..8  ]                       pop_scope
        \\  %9: [  9..9  ]                       return %7
        \\
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 07 01 00 01                      load_number_i8 r1, 1
        \\   7: 13 00 00 00 00 00 00 01 00       object_set r0, @0 ("x"), r1
        \\  16: 4d 01 00 00 00 00 00             set_binding @1 ("o"), r0
        \\  23: 48 00 00 01 00 00 00             get_binding r0, @1 ("o")
        \\  30: 20 01 00 00 00                   to_object r1, r0
        \\  35: 41 01 00                         push_with_scope r1
        \\  38: 48 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  45: 42                               pop_scope
        \\  46: 77 00 00                         return r0
        \\
        ,
    },

    // Optional expression
    .{
        .source =
        \\var o = {a: {b: 123}};
        \\o.x?.y ?? o.a?.["b"];
        \\
        ,
        .expected_result = .{ .value = .{ .number = 123 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..5  ]                       object_create
        \\  %1: [  1..4  ]                       object_create
        \\  %2: [  2..3  ]                       number 123
        \\  %3: [  3..3  ]                       object_set %1, @1 ("b"), %2
        \\  %4: [  4..4  ]                       object_set %0, @0 ("a"), %1
        \\  %5: [  5..5  ]                       set_binding @2 ("o"), %0
        \\  %6: [  6..7  ]                       get_binding @2 ("o")
        \\  %7: [  7..12 ]                       get_property %6, @3 ("x")
        \\  %8: [  8..9  ]                       null
        \\  %9: [  9..10 ]                       eq %7, %8
        \\ %10: [ 10..10 ]                       br_cond %9, %14, %11
        \\ %11: [ 11..11 ]                       label
        \\ %12: [ 12..13 ]                       get_property %7, @4 ("y")
        \\ %13: [ 13..13 ]                       br %17, %12
        \\ %14: [ 14..14 ]                       label
        \\ %15: [ 15..16 ]                       undefined
        \\ %16: [ 16..16 ]                       br %17, %15
        \\ %17: [ 17..22 ]                       label
        \\ %18: [ 18..19 ]                       null
        \\ %19: [ 19..20 ]                       eq %17, %18
        \\ %20: [ 20..20 ]                       br_cond %19, %23, %21
        \\ %21: [ 21..21 ]                       label
        \\ %22: [ 22..22 ]                       br %37, %17
        \\ %23: [ 23..23 ]                       label
        \\ %24: [ 24..25 ]                       get_binding @2 ("o")
        \\ %25: [ 25..30 ]                       get_property %24, @0 ("a")
        \\ %26: [ 26..27 ]                       null
        \\ %27: [ 27..28 ]                       eq %25, %26
        \\ %28: [ 28..28 ]                       br_cond %27, %32, %29
        \\ %29: [ 29..29 ]                       label
        \\ %30: [ 30..31 ]                       get_property %25, @1 ("b")
        \\ %31: [ 31..31 ]                       br %35, %30
        \\ %32: [ 32..32 ]                       label
        \\ %33: [ 33..34 ]                       undefined
        \\ %34: [ 34..34 ]                       br %35, %33
        \\ %35: [ 35..36 ]                       label
        \\ %36: [ 36..36 ]                       br %37, %35
        \\ %37: [ 37..38 ]                       label
        \\ %38: [ 38..38 ]                       return %37
        \\
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 12 01 00                         object_create r1
        \\   6: 07 02 00 7b                      load_number_i8 r2, 123
        \\  10: 13 01 00 01 00 00 00 02 00       object_set r1, @1 ("b"), r2
        \\  19: 13 00 00 00 00 00 00 01 00       object_set r0, @0 ("a"), r1
        \\  28: 4d 02 00 00 00 00 00             set_binding @2 ("o"), r0
        \\  35: 48 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\  42: 49 01 00 00 00 03 00 00 00 00 00 get_property r1, r0, @3 ("x"), @0
        \\  53: 04 00 00                         load_null r0
        \\  56: 3b 02 00 01 00 00 00             eq r2, r1, r0
        \\  63: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  70: 00 08 00 00 00                   jump 8
        \\  75: 03 00 00                         load_undefined r0
        \\  78: 00 0b 00 00 00                   jump 11
        \\  83: 49 00 00 01 00 04 00 00 00 01 00 get_property r0, r1, @4 ("y"), @1
        \\  94: 04 01 00                         load_null r1
        \\  97: 3b 02 00 00 00 01 00             eq r2, r0, r1
        \\ 104: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 111: 00 40 00 00 00                   jump 64
        \\ 116: 48 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\ 123: 49 01 00 00 00 00 00 00 00 02 00 get_property r1, r0, @0 ("a"), @2
        \\ 134: 04 00 00                         load_null r0
        \\ 137: 3b 02 00 01 00 00 00             eq r2, r1, r0
        \\ 144: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 151: 00 08 00 00 00                   jump 8
        \\ 156: 03 00 00                         load_undefined r0
        \\ 159: 00 0b 00 00 00                   jump 11
        \\ 164: 49 00 00 01 00 01 00 00 00 03 00 get_property r0, r1, @1 ("b"), @3
        \\ 175: 00 00 00 00 00                   jump 0
        \\ 180: 77 00 00                         return r0
        \\
        ,
    },

    // Template literal
    .{
        .source =
        \\var empty = ``;
        \\`${empty}a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       string @0 ("")
        \\  %1: [  1..1  ]                       set_binding @1 ("empty"), %0
        \\  %2: [  2..3  ]                       get_binding @1 ("empty")
        \\  %3: [  3..5  ]                       to_string %2
        \\  %4: [  4..5  ]                       string @2 ("a")
        \\  %5: [  5..8  ]                       add %3, %4
        \\  %6: [  6..7  ]                       string @3 ("b")
        \\  %7: [  7..8  ]                       to_string %6
        \\  %8: [  8..10 ]                       add %5, %7
        \\  %9: [  9..10 ]                       string @4 ("c")
        \\ %10: [ 10..11 ]                       add %8, %9
        \\ %11: [ 11..11 ]                       return %10
        \\
        \\Bytecode (test)
        \\   0: 0a 00 00 00 00 00 00             load_string r0, @0 ("")
        \\   7: 4d 01 00 00 00 00 00             set_binding @1 ("empty"), r0
        \\  14: 48 00 00 01 00 00 00             get_binding r0, @1 ("empty")
        \\  21: 1f 01 00 00 00                   to_string r1, r0
        \\  26: 0a 00 00 02 00 00 00             load_string r0, @2 ("a")
        \\  33: 29 02 00 01 00 00 00             add r2, r1, r0
        \\  40: 0a 00 00 03 00 00 00             load_string r0, @3 ("b")
        \\  47: 1f 01 00 00 00                   to_string r1, r0
        \\  52: 29 00 00 02 00 01 00             add r0, r2, r1
        \\  59: 0a 01 00 04 00 00 00             load_string r1, @4 ("c")
        \\  66: 29 02 00 00 00 01 00             add r2, r0, r1
        \\  73: 77 02 00                         return r2
        \\
        ,
    },

    // Tagged template
    .{
        .source =
        \\String.raw`a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..14 ]                       get_binding @0 ("String")
        \\  %1: [  1..14 ]                       get_property %0, @1 ("raw")
        \\  %2: [  2..12 ]                       array_create 2
        \\  %3: [  3..4  ]                       string @2 ("a")
        \\  %4: [  4..4  ]                       array_push %2, %3
        \\  %5: [  5..6  ]                       string @3 ("c")
        \\  %6: [  6..6  ]                       array_push %2, %5
        \\  %7: [  7..12 ]                       array_create 2
        \\  %8: [  8..9  ]                       string @2 ("a")
        \\  %9: [  9..9  ]                       array_push %7, %8
        \\ %10: [ 10..11 ]                       string @3 ("c")
        \\ %11: [ 11..11 ]                       array_push %7, %10
        \\ %12: [ 12..14 ]                       get_template_object %2, %7, 0
        \\ %13: [ 13..14 ]                       string @4 ("b")
        \\ %14: [ 14..15 ]                       call %1, %0, [%12, %13]
        \\ %15: [ 15..15 ]                       return %14
        \\
        \\Bytecode (test)
        \\   0: 48 00 00 00 00 00 00             get_binding r0, @0 ("String")
        \\   7: 49 01 00 00 00 01 00 00 00 00 00 get_property r1, r0, @1 ("raw"), @0
        \\  18: 0d 02 00 02 00 00 00             array_create r2, 2
        \\  25: 0a 03 00 02 00 00 00             load_string r3, @2 ("a")
        \\  32: 10 02 00 03 00 00 00 00 00       array_set r2, r3, 0
        \\  41: 0a 03 00 03 00 00 00             load_string r3, @3 ("c")
        \\  48: 10 02 00 03 00 01 00 00 00       array_set r2, r3, 1
        \\  57: 0d 03 00 02 00 00 00             array_create r3, 2
        \\  64: 0a 04 00 02 00 00 00             load_string r4, @2 ("a")
        \\  71: 10 03 00 04 00 00 00 00 00       array_set r3, r4, 0
        \\  80: 0a 04 00 03 00 00 00             load_string r4, @3 ("c")
        \\  87: 10 03 00 04 00 01 00 00 00       array_set r3, r4, 1
        \\  96: 6b 04 00 02 00 03 00 00 00       get_template_object r4, r2, r3, 0
        \\ 105: 0a 02 00 04 00 00 00             load_string r2, @4 ("b")
        \\ 112: 64 03 00 01 00 00 00 04 00 02 00 call_property2 r3, r1, r0, r4, r2
        \\ 123: 77 03 00                         return r3
        \\
        ,
    },

    // Functions
    .{
        .source =
        \\var f = ({a}, b = 0, ...rest) => a + b + rest.length;
        \\f({a: 1}, 2, 3, 4);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       create_function @0
        \\  %1: [  1..1  ]                       set_binding @0 ("f"), %0
        \\  %2: [  2..9  ]                       get_binding @0 ("f")
        \\  %3: [  3..9  ]                       object_create
        \\  %4: [  4..5  ]                       one
        \\  %5: [  5..5  ]                       object_set %3, @1 ("a"), %4
        \\  %6: [  6..9  ]                       number 2
        \\  %7: [  7..9  ]                       number 3
        \\  %8: [  8..9  ]                       number 4
        \\  %9: [  9..10 ]                       call %2, none, [%3, %6, %7, %8]
        \\ %10: [ 10..10 ]                       return %9
        \\
        \\Bytecode (test)
        \\   0: 7b 00 00 00 00                   create_function r0, @0
        \\   5: 4d 00 00 00 00 00 00             set_binding @0 ("f"), r0
        \\  12: 48 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\  19: 12 01 00                         object_create r1
        \\  22: 07 02 00 01                      load_number_i8 r2, 1
        \\  26: 13 01 00 01 00 00 00 02 00       object_set r1, @1 ("a"), r2
        \\  35: 07 02 00 02                      load_number_i8 r2, 2
        \\  39: 07 03 00 03                      load_number_i8 r3, 3
        \\  43: 07 04 00 04                      load_number_i8 r4, 4
        \\  47: 0d 06 00 00 00 00 00             array_create r6, 0
        \\  54: 0e 06 00 01 00                   array_push r6, r1
        \\  59: 0e 06 00 02 00                   array_push r6, r2
        \\  64: 0e 06 00 03 00                   array_push r6, r3
        \\  69: 0e 06 00 04 00                   array_push r6, r4
        \\  74: 5d 05 00 00 00 06 00             call r5, r0, r6
        \\  81: 77 05 00                         return r5
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       create_mutable_binding @0 ("a")
        \\  %2: [  2..2  ]                       create_mutable_binding @1 ("b")
        \\  %3: [  3..3  ]                       create_mutable_binding @2 ("rest")
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..7  ]                       get_property %5, @0 ("a")
        \\  %7: [  7..7  ]                       initialize_binding @0 ("a"), %6
        \\  %8: [  8..16 ]                       get_argument 1
        \\  %9: [  9..10 ]                       undefined
        \\ %10: [ 10..11 ]                       eq_strict %8, %9
        \\ %11: [ 11..11 ]                       br_cond %10, %12, %15
        \\ %12: [ 12..12 ]                       label
        \\ %13: [ 13..14 ]                       zero
        \\ %14: [ 14..14 ]                       br %17, %13
        \\ %15: [ 15..15 ]                       label
        \\ %16: [ 16..16 ]                       br %17, %8
        \\ %17: [ 17..18 ]                       label
        \\ %18: [ 18..18 ]                       initialize_binding @1 ("b"), %17
        \\ %19: [ 19..20 ]                       get_rest_arguments 2
        \\ %20: [ 20..20 ]                       initialize_binding @2 ("rest"), %19
        \\ %21: [ 21..21 ]                       push_var_scope
        \\ %22: [ 22..22 ]                       push_scope
        \\ %23: [ 23..25 ]                       get_binding @0 ("a")
        \\ %24: [ 24..25 ]                       get_binding @1 ("b")
        \\ %25: [ 25..28 ]                       add %23, %24
        \\ %26: [ 26..27 ]                       get_binding @2 ("rest")
        \\ %27: [ 27..28 ]                       get_property %26, @3 ("length")
        \\ %28: [ 28..29 ]                       add %25, %27
        \\ %29: [ 29..29 ]                       return %28
        \\ %30: [ 30..30 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 3f                               push_scope
        \\   1: 44 00 00 00 00                   create_mutable_binding @0 ("a")
        \\   6: 44 01 00 00 00                   create_mutable_binding @1 ("b")
        \\  11: 44 02 00 00 00                   create_mutable_binding @2 ("rest")
        \\  16: 80 00 00 00 00                   get_argument r0, 0
        \\  21: 20 01 00 00 00                   to_object r1, r0
        \\  26: 49 00 00 01 00 00 00 00 00 00 00 get_property r0, r1, @0 ("a"), @0
        \\  37: 46 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  44: 80 00 00 01 00                   get_argument r0, 1
        \\  49: 03 01 00                         load_undefined r1
        \\  52: 3d 02 00 00 00 01 00             eq_strict r2, r0, r1
        \\  59: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  66: 00 0e 00 00 00                   jump 14
        \\  71: 07 01 00 00                      load_number_i8 r1, 0
        \\  75: 0c 00 00 01 00                   move r0, r1
        \\  80: 00 00 00 00 00                   jump 0
        \\  85: 46 01 00 00 00 00 00             initialize_binding @1 ("b"), r0
        \\  92: 81 00 00 02 00                   get_rest_arguments r0, 2
        \\  97: 46 02 00 00 00 00 00             initialize_binding @2 ("rest"), r0
        \\ 104: 40                               push_var_scope
        \\ 105: 3f                               push_scope
        \\ 106: 48 00 00 00 00 00 00             get_binding r0, @0 ("a")
        \\ 113: 48 01 00 01 00 00 00             get_binding r1, @1 ("b")
        \\ 120: 29 02 00 00 00 01 00             add r2, r0, r1
        \\ 127: 48 00 00 02 00 00 00             get_binding r0, @2 ("rest")
        \\ 134: 49 01 00 00 00 03 00 00 00 01 00 get_property r1, r0, @3 ("length"), @1
        \\ 145: 29 00 00 02 00 01 00             add r0, r2, r1
        \\ 152: 77 00 00                         return r0
        \\
        ,
    },

    // Arguments object
    .{
        .source =
        \\function mapped(a) {
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\function unmapped(a) {
        \\  "use strict";
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\mapped(1) - unmapped(1);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 98 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..2  ]                       get_binding @0 ("mapped")
        \\  %1: [  1..2  ]                       one
        \\  %2: [  2..6  ]                       call %0, none, [%1]
        \\  %3: [  3..5  ]                       get_binding @1 ("unmapped")
        \\  %4: [  4..5  ]                       one
        \\  %5: [  5..6  ]                       call %3, none, [%4]
        \\  %6: [  6..7  ]                       sub %2, %5
        \\  %7: [  7..7  ]                       return %6
        \\
        \\Bytecode (test)
        \\   0: 48 00 00 00 00 00 00             get_binding r0, @0 ("mapped")
        \\   7: 07 01 00 01                      load_number_i8 r1, 1
        \\  11: 5f 02 00 00 00 01 00             call1 r2, r0, r1
        \\  18: 48 00 00 01 00 00 00             get_binding r0, @1 ("unmapped")
        \\  25: 07 01 00 01                      load_number_i8 r1, 1
        \\  29: 5f 03 00 00 00 01 00             call1 r3, r0, r1
        \\  36: 2a 00 00 02 00 03 00             sub r0, r2, r3
        \\  43: 77 00 00                         return r0
        \\
        \\IR (mapped)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("a")
        \\  %1: [  1..3  ]                       create_mapped_arguments_object
        \\  %2: [  2..2  ]                       create_mutable_binding @1 ("arguments")
        \\  %3: [  3..3  ]                       initialize_binding @1 ("arguments"), %1
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ]                       push_scope
        \\  %7: [  7..8  ]                       number 99
        \\  %8: [  8..8  ]                       set_binding @0 ("a"), %7
        \\  %9: [  9..10 ]                       get_binding @1 ("arguments")
        \\ %10: [ 10..11 ]                       get_property_indexed %9, 0
        \\ %11: [ 11..11 ]                       return %10
        \\ %12: [ 12..12 ] dead                  return none
        \\
        \\Bytecode (mapped)
        \\   0: 44 00 00 00 00                   create_mutable_binding @0 ("a")
        \\   5: 7f 00 00                         create_mapped_arguments_object r0
        \\   8: 44 01 00 00 00                   create_mutable_binding @1 ("arguments")
        \\  13: 46 01 00 00 00 00 00             initialize_binding @1 ("arguments"), r0
        \\  20: 80 00 00 00 00                   get_argument r0, 0
        \\  25: 46 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  32: 3f                               push_scope
        \\  33: 07 00 00 63                      load_number_i8 r0, 99
        \\  37: 4d 00 00 00 00 00 00             set_binding @0 ("a"), r0
        \\  44: 48 00 00 01 00 00 00             get_binding r0, @1 ("arguments")
        \\  51: 4b 01 00 00 00 00 00 00 00       get_property_indexed r1, r0, 0
        \\  60: 77 01 00                         return r1
        \\
        \\IR (unmapped)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("a")
        \\  %1: [  1..3  ]                       create_unmapped_arguments_object
        \\  %2: [  2..2  ]                       create_immutable_binding @1 ("arguments")
        \\  %3: [  3..3  ]                       initialize_binding @1 ("arguments"), %1
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ] dead                  string @2 ("use strict")
        \\  %7: [  7..8  ]                       number 99
        \\  %8: [  8..8  ]                       set_binding_strict @0 ("a"), %7
        \\  %9: [  9..10 ]                       get_binding @1 ("arguments")
        \\ %10: [ 10..11 ]                       get_property_indexed %9, 0
        \\ %11: [ 11..11 ]                       return %10
        \\ %12: [ 12..12 ] dead                  return none
        \\
        \\Bytecode (unmapped)
        \\   0: 7e 00 00                         create_unmapped_arguments_object r0
        \\   3: 4c 01 00 00 00                   set_local l1, r0
        \\   8: 80 00 00 00 00                   get_argument r0, 0
        \\  13: 4c 00 00 00 00                   set_local l0, r0
        \\  18: 07 00 00 63                      load_number_i8 r0, 99
        \\  22: 4c 00 00 00 00                   set_local l0, r0
        \\  27: 47 00 00 01 00                   get_local r0, l1
        \\  32: 4b 01 00 00 00 00 00 00 00       get_property_indexed r1, r0, 0
        \\  41: 77 01 00                         return r1
        \\
        ,
    },

    // Getter/setter
    .{
        .source =
        \\var o = {
        \\  get x() { return this._x; },
        \\  set x(v) { this._x = v; },
        \\};
        \\o.x = 42;
        \\o.x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 42 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..7  ]                       object_create
        \\  %1: [  1..2  ]                       create_function @0
        \\  %2: [  2..3  ]                       getter %1
        \\  %3: [  3..3  ]                       object_set %0, @0 ("x"), %2
        \\  %4: [  4..5  ]                       create_function @1
        \\  %5: [  5..6  ]                       setter %4
        \\  %6: [  6..6  ]                       object_set %0, @0 ("x"), %5
        \\  %7: [  7..7  ]                       set_binding @3 ("o"), %0
        \\  %8: [  8..10 ]                       get_binding @3 ("o")
        \\  %9: [  9..10 ]                       number 42
        \\ %10: [ 10..10 ]                       set_property %8, @0 ("x"), %9
        \\ %11: [ 11..12 ]                       get_binding @3 ("o")
        \\ %12: [ 12..13 ]                       get_property %11, @0 ("x")
        \\ %13: [ 13..13 ]                       return %12
        \\
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 7b 01 00 00 00                   create_function r1, @0
        \\   8: 0c 02 00 01 00                   move r2, r1
        \\  13: 7d 02 00 00 00                   set_home_object r2, r0
        \\  18: 15 00 00 00 00 00 00 02 00       object_set_getter r0, @0 ("x"), r2
        \\  27: 7b 01 00 01 00                   create_function r1, @1
        \\  32: 0c 02 00 01 00                   move r2, r1
        \\  37: 7d 02 00 00 00                   set_home_object r2, r0
        \\  42: 17 00 00 00 00 00 00 02 00       object_set_setter r0, @0 ("x"), r2
        \\  51: 4d 03 00 00 00 00 00             set_binding @3 ("o"), r0
        \\  58: 48 00 00 03 00 00 00             get_binding r0, @3 ("o")
        \\  65: 07 01 00 2a                      load_number_i8 r1, 42
        \\  69: 4f 00 00 01 00 00 00 00 00 00 00 set_property r0, r1, @0 ("x"), @0
        \\  80: 48 00 00 03 00 00 00             get_binding r0, @3 ("o")
        \\  87: 49 01 00 00 00 00 00 00 00 00 00 get_property r1, r0, @0 ("x"), @0
        \\  98: 77 01 00                         return r1
        \\
        \\IR (get x)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..2  ]                       this
        \\  %2: [  2..3  ]                       get_property %1, @0 ("_x")
        \\  %3: [  3..3  ]                       return %2
        \\  %4: [  4..4  ] dead                  return none
        \\
        \\Bytecode (get x)
        \\   0: 3f                               push_scope
        \\   1: 1c 00 00                         resolve_this_binding r0
        \\   4: 49 01 00 00 00 00 00 00 00 00 00 get_property r1, r0, @0 ("_x"), @0
        \\  15: 77 01 00                         return r1
        \\
        \\IR (set x)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("v")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("v"), %1
        \\  %3: [  3..3  ]                       push_scope
        \\  %4: [  4..6  ]                       this
        \\  %5: [  5..6  ]                       get_binding @0 ("v")
        \\  %6: [  6..6  ]                       set_property %4, @1 ("_x"), %5
        \\  %7: [  7..7  ]                       return none
        \\
        \\Bytecode (set x)
        \\   0: 80 00 00 00 00                   get_argument r0, 0
        \\   5: 4c 00 00 00 00                   set_local l0, r0
        \\  10: 3f                               push_scope
        \\  11: 1c 00 00                         resolve_this_binding r0
        \\  14: 47 01 00 00 00                   get_local r1, l0
        \\  19: 4f 00 00 01 00 01 00 00 00 00 00 set_property r0, r1, @1 ("_x"), @0
        \\  30: 77 ff ff                         return
        \\
        ,
    },

    // Generator
    .{
        .source =
        \\function* h() {
        \\  yield 4;
        \\  yield 5;
        \\}
        \\function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\  yield* h();
        \\}
        \\function f() {
        \\  var gen = g();
        \\  var sum = 0;
        \\  while (true) {
        \\    var result = gen.next();
        \\    if (result.done) break;
        \\    sum += result.value;
        \\  }
        \\  return sum;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 15 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       get_binding @0 ("f")
        \\  %1: [  1..2  ]                       call %0, none, []
        \\  %2: [  2..2  ]                       return %1
        \\
        \\Bytecode (test)
        \\   0: 48 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\   7: 5e 01 00 00 00                   call0 r1, r0
        \\  12: 77 01 00                         return r1
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       create_var_binding @0 ("gen")
        \\  %1: [  1..1  ]                       create_var_binding @1 ("sum")
        \\  %2: [  2..2  ]                       create_var_binding @2 ("result")
        \\  %3: [  3..3  ]                       push_scope
        \\  %4: [  4..5  ]                       get_binding @3 ("g")
        \\  %5: [  5..6  ]                       call %4, none, []
        \\  %6: [  6..6  ]                       set_binding @0 ("gen"), %5
        \\  %7: [  7..8  ]                       zero
        \\  %8: [  8..8  ]                       set_binding @1 ("sum"), %7
        \\  %9: [  9..35 ]                       undefined
        \\ %10: [ 10..10 ]                       br %11, %9
        \\ %11: [ 11..37 ]                       label
        \\ %12: [ 12..13 ]                       true
        \\ %13: [ 13..13 ]                       br_cond %12, %14, %36
        \\ %14: [ 14..14 ]                       label
        \\ %15: [ 15..17 ]                       get_binding @0 ("gen")
        \\ %16: [ 16..17 ]                       get_property %15, @4 ("next")
        \\ %17: [ 17..18 ]                       call %16, %15, []
        \\ %18: [ 18..18 ]                       set_binding @2 ("result"), %17
        \\ %19: [ 19..20 ]                       get_binding @2 ("result")
        \\ %20: [ 20..21 ]                       get_property %19, @5 ("done")
        \\ %21: [ 21..21 ]                       br_cond %20, %22, %26
        \\ %22: [ 22..22 ]                       label
        \\ %23: [ 23..23 ]                       br %38, %9
        \\ %24: [ 24..25 ] dead                  undefined
        \\ %25: [ 25..25 ] dead                  br %29, %24
        \\ %26: [ 26..26 ]                       label
        \\ %27: [ 27..28 ]                       undefined
        \\ %28: [ 28..28 ]                       br %29, %27
        \\ %29: [ 29..29 ]                       label
        \\ %30: [ 30..33 ]                       get_binding @1 ("sum")
        \\ %31: [ 31..32 ]                       get_binding @2 ("result")
        \\ %32: [ 32..33 ]                       get_property %31, @6 ("value")
        \\ %33: [ 33..34 ]                       add %30, %32
        \\ %34: [ 34..35 ]                       set_binding @1 ("sum"), %33
        \\ %35: [ 35..35 ]                       br %11, %34
        \\ %36: [ 36..36 ]                       label
        \\ %37: [ 37..37 ]                       br %38, %11
        \\ %38: [ 38..38 ]                       label
        \\ %39: [ 39..40 ]                       get_binding @1 ("sum")
        \\ %40: [ 40..40 ]                       return %39
        \\ %41: [ 41..41 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 3f                               push_scope
        \\   1: 48 00 00 03 00 00 00             get_binding r0, @3 ("g")
        \\   8: 5e 01 00 00 00                   call0 r1, r0
        \\  13: 4c 00 00 01 00                   set_local l0, r1
        \\  18: 07 00 00 00                      load_number_i8 r0, 0
        \\  22: 4c 01 00 00 00                   set_local l1, r0
        \\  27: 03 00 00                         load_undefined r0
        \\  30: 0c 01 00 00 00                   move r1, r0
        \\  35: 05 02 00                         load_true r2
        \\  38: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  45: 00 70 00 00 00                   jump 112
        \\  50: 47 02 00 00 00                   get_local r2, l0
        \\  55: 49 03 00 02 00 04 00 00 00 00 00 get_property r3, r2, @4 ("next"), @0
        \\  66: 62 04 00 03 00 02 00             call_property0 r4, r3, r2
        \\  73: 4c 02 00 04 00                   set_local l2, r4
        \\  78: 47 02 00 02 00                   get_local r2, l2
        \\  83: 49 03 00 02 00 05 00 00 00 01 00 get_property r3, r2, @5 ("done"), @1
        \\  94: 01 03 00 05 00 00 00             jump_if_true r3, 5
        \\ 101: 00 05 00 00 00                   jump 5
        \\ 106: 00 33 00 00 00                   jump 51
        \\ 111: 03 02 00                         load_undefined r2
        \\ 114: 47 02 00 01 00                   get_local r2, l1
        \\ 119: 47 03 00 02 00                   get_local r3, l2
        \\ 124: 49 04 00 03 00 06 00 00 00 02 00 get_property r4, r3, @6 ("value"), @2
        \\ 135: 29 03 00 02 00 04 00             add r3, r2, r4
        \\ 142: 4c 01 00 03 00                   set_local l1, r3
        \\ 147: 0c 02 00 03 00                   move r2, r3
        \\ 152: 0c 01 00 02 00                   move r1, r2
        \\ 157: 00 81 ff ff ff                   jump -127
        \\ 162: 47 00 00 01 00                   get_local r0, l1
        \\ 167: 77 00 00                         return r0
        \\
        \\IR (g)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       one
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 2
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..7  ]                       number 3
        \\  %7: [  7..7  ]                       yield %6
        \\  %8: [  8..9  ]                       get_binding @0 ("h")
        \\  %9: [  9..10 ]                       call %8, none, []
        \\ %10: [ 10..11 ]                       get_iterator %9
        \\ %11: [ 11..11 ]                       yield_star %10
        \\ %12: [ 12..12 ]                       return none
        \\
        \\Bytecode (g)
        \\   0: 3f                               push_scope
        \\   1: 79 ff ff ff ff                   yield
        \\   6: 07 00 00 01                      load_number_i8 r0, 1
        \\  10: 79 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 02                      load_number_i8 r0, 2
        \\  19: 79 01 00 00 00                   yield r1, r0
        \\  24: 07 00 00 03                      load_number_i8 r0, 3
        \\  28: 79 01 00 00 00                   yield r1, r0
        \\  33: 48 00 00 00 00 00 00             get_binding r0, @0 ("h")
        \\  40: 5e 01 00 00 00                   call0 r1, r0
        \\  45: 6c 00 00 01 00                   get_iterator r0, r1
        \\  50: 03 01 00                         load_undefined r1
        \\  53: 7a 01 00 00 00                   yield_star r1, r0
        \\  58: 77 ff ff                         return
        \\
        \\IR (h)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       number 4
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 5
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..6  ]                       return none
        \\
        \\Bytecode (h)
        \\   0: 3f                               push_scope
        \\   1: 79 ff ff ff ff                   yield
        \\   6: 07 00 00 04                      load_number_i8 r0, 4
        \\  10: 79 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 05                      load_number_i8 r0, 5
        \\  19: 79 01 00 00 00                   yield r1, r0
        \\  24: 77 ff ff                         return
        \\
        ,
    },

    // Async Generator
    .{
        .source =
        \\async function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\}
        \\async function f() {
        \\  var gen = g();
        \\  var a = await gen.next();
        \\  var b = await gen.next();
        \\  var c = await gen.next();
        \\  return a.value + b.value + c.value;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .promise = .{ .fulfilled = .{ .number = 6 } } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       get_binding @0 ("f")
        \\  %1: [  1..2  ]                       call %0, none, []
        \\  %2: [  2..2  ]                       return %1
        \\
        \\Bytecode (test)
        \\   0: 48 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\   7: 5e 01 00 00 00                   call0 r1, r0
        \\  12: 77 01 00                         return r1
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       create_var_binding @0 ("gen")
        \\  %1: [  1..1  ]                       create_var_binding @1 ("a")
        \\  %2: [  2..2  ]                       create_var_binding @2 ("b")
        \\  %3: [  3..3  ]                       create_var_binding @3 ("c")
        \\  %4: [  4..4  ]                       push_scope
        \\  %5: [  5..6  ]                       get_binding @4 ("g")
        \\  %6: [  6..7  ]                       call %5, none, []
        \\  %7: [  7..7  ]                       set_binding @0 ("gen"), %6
        \\  %8: [  8..10 ]                       get_binding @0 ("gen")
        \\  %9: [  9..10 ]                       get_property %8, @5 ("next")
        \\ %10: [ 10..11 ]                       call %9, %8, []
        \\ %11: [ 11..12 ]                       await %10
        \\ %12: [ 12..12 ]                       set_binding @1 ("a"), %11
        \\ %13: [ 13..15 ]                       get_binding @0 ("gen")
        \\ %14: [ 14..15 ]                       get_property %13, @5 ("next")
        \\ %15: [ 15..16 ]                       call %14, %13, []
        \\ %16: [ 16..17 ]                       await %15
        \\ %17: [ 17..17 ]                       set_binding @2 ("b"), %16
        \\ %18: [ 18..20 ]                       get_binding @0 ("gen")
        \\ %19: [ 19..20 ]                       get_property %18, @5 ("next")
        \\ %20: [ 20..21 ]                       call %19, %18, []
        \\ %21: [ 21..22 ]                       await %20
        \\ %22: [ 22..22 ]                       set_binding @3 ("c"), %21
        \\ %23: [ 23..24 ]                       get_binding @1 ("a")
        \\ %24: [ 24..27 ]                       get_property %23, @6 ("value")
        \\ %25: [ 25..26 ]                       get_binding @2 ("b")
        \\ %26: [ 26..27 ]                       get_property %25, @6 ("value")
        \\ %27: [ 27..30 ]                       add %24, %26
        \\ %28: [ 28..29 ]                       get_binding @3 ("c")
        \\ %29: [ 29..30 ]                       get_property %28, @6 ("value")
        \\ %30: [ 30..31 ]                       add %27, %29
        \\ %31: [ 31..31 ]                       return %30
        \\ %32: [ 32..32 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 3f                               push_scope
        \\   1: 48 00 00 04 00 00 00             get_binding r0, @4 ("g")
        \\   8: 5e 01 00 00 00                   call0 r1, r0
        \\  13: 4c 00 00 01 00                   set_local l0, r1
        \\  18: 47 00 00 00 00                   get_local r0, l0
        \\  23: 49 01 00 00 00 05 00 00 00 00 00 get_property r1, r0, @5 ("next"), @0
        \\  34: 62 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  41: 78 00 00 02 00                   await r0, r2
        \\  46: 4c 01 00 00 00                   set_local l1, r0
        \\  51: 47 00 00 00 00                   get_local r0, l0
        \\  56: 49 01 00 00 00 05 00 00 00 01 00 get_property r1, r0, @5 ("next"), @1
        \\  67: 62 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  74: 78 00 00 02 00                   await r0, r2
        \\  79: 4c 02 00 00 00                   set_local l2, r0
        \\  84: 47 00 00 00 00                   get_local r0, l0
        \\  89: 49 01 00 00 00 05 00 00 00 02 00 get_property r1, r0, @5 ("next"), @2
        \\ 100: 62 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\ 107: 78 00 00 02 00                   await r0, r2
        \\ 112: 4c 03 00 00 00                   set_local l3, r0
        \\ 117: 47 00 00 01 00                   get_local r0, l1
        \\ 122: 49 01 00 00 00 06 00 00 00 03 00 get_property r1, r0, @6 ("value"), @3
        \\ 133: 47 00 00 02 00                   get_local r0, l2
        \\ 138: 49 02 00 00 00 06 00 00 00 04 00 get_property r2, r0, @6 ("value"), @4
        \\ 149: 29 00 00 01 00 02 00             add r0, r1, r2
        \\ 156: 47 01 00 03 00                   get_local r1, l3
        \\ 161: 49 02 00 01 00 06 00 00 00 05 00 get_property r2, r1, @6 ("value"), @5
        \\ 172: 29 01 00 00 00 02 00             add r1, r0, r2
        \\ 179: 77 01 00                         return r1
        \\
        \\IR (g)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       one
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 2
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..7  ]                       number 3
        \\  %7: [  7..7  ]                       yield %6
        \\  %8: [  8..8  ]                       return none
        \\
        \\Bytecode (g)
        \\   0: 3f                               push_scope
        \\   1: 79 ff ff ff ff                   yield
        \\   6: 07 00 00 01                      load_number_i8 r0, 1
        \\  10: 79 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 02                      load_number_i8 r0, 2
        \\  19: 79 01 00 00 00                   yield r1, r0
        \\  24: 07 00 00 03                      load_number_i8 r0, 3
        \\  28: 79 01 00 00 00                   yield r1, r0
        \\  33: 77 ff ff                         return
        \\
        ,
    },

    // Classes
    .{
        .source =
        \\class Foo {
        \\  #x;
        \\  constructor(x) { this.#x = x; }
        \\  getX() { return this.#x; }
        \\}
        \\class Bar extends Foo {
        \\  constructor(x) { super(x); }
        \\  getX() { return super.getX() + 1; }
        \\}
        \\var bar = new Bar(42);
        \\bar.getX();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 43 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..0  ]                       push_private_scope
        \\  %1: [  1..3  ]                       create_private_element @1 ("x")
        \\  %2: [  2..3  ]                       string @2 ("getX")
        \\  %3: [  3..5  ]                       create_class @0, none, [%1, %2]
        \\  %4: [  4..4  ]                       pop_private_scope
        \\  %5: [  5..5  ]                       initialize_binding @0 ("Foo"), %3
        \\  %6: [  6..9  ]                       get_binding @0 ("Foo")
        \\  %7: [  7..7  ]                       push_private_scope
        \\  %8: [  8..9  ]                       string @2 ("getX")
        \\  %9: [  9..11 ]                       create_class @1, %6, [%8]
        \\ %10: [ 10..10 ]                       pop_private_scope
        \\ %11: [ 11..11 ]                       initialize_binding @3 ("Bar"), %9
        \\ %12: [ 12..14 ]                       get_binding @3 ("Bar")
        \\ %13: [ 13..14 ]                       number 42
        \\ %14: [ 14..15 ]                       construct %12, [%13]
        \\ %15: [ 15..15 ]                       set_binding @4 ("bar"), %14
        \\ %16: [ 16..18 ]                       get_binding @4 ("bar")
        \\ %17: [ 17..18 ]                       get_property %16, @2 ("getX")
        \\ %18: [ 18..19 ]                       call %17, %16, []
        \\ %19: [ 19..19 ]                       return %18
        \\
        \\Bytecode (test)
        \\   0: 8a                               push_private_scope
        \\   1: 8c 00 00 01 00 00 00             create_private_element r0, @1 ("x")
        \\   8: 0a 01 00 02 00 00 00             load_string r1, @2 ("getX")
        \\  15: 7c 02 00 00 00                   create_class r2, @0
        \\  20: 8b                               pop_private_scope
        \\  21: 46 00 00 00 00 02 00             initialize_binding @0 ("Foo"), r2
        \\  28: 48 00 00 00 00 00 00             get_binding r0, @0 ("Foo")
        \\  35: 8a                               push_private_scope
        \\  36: 0a 01 00 02 00 00 00             load_string r1, @2 ("getX")
        \\  43: 7c 02 00 01 00                   create_class r2, @1
        \\  48: 8b                               pop_private_scope
        \\  49: 46 03 00 00 00 02 00             initialize_binding @3 ("Bar"), r2
        \\  56: 48 00 00 03 00 00 00             get_binding r0, @3 ("Bar")
        \\  63: 07 01 00 2a                      load_number_i8 r1, 42
        \\  67: 69 02 00 00 00 01 00             construct1 r2, r0, r1
        \\  74: 4d 04 00 00 00 02 00             set_binding @4 ("bar"), r2
        \\  81: 48 00 00 04 00 00 00             get_binding r0, @4 ("bar")
        \\  88: 49 01 00 00 00 02 00 00 00 00 00 get_property r1, r0, @2 ("getX"), @0
        \\  99: 62 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\ 106: 77 02 00                         return r2
        \\
        \\IR (Bar)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("x")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("x"), %1
        \\  %3: [  3..4  ]                       get_binding @0 ("x")
        \\  %4: [  4..4  ]                       super_call [%3]
        \\  %5: [  5..5  ]                       return none
        \\
        \\Bytecode (Bar)
        \\   0: 80 00 00 00 00                   get_argument r0, 0
        \\   5: 4c 00 00 00 00                   set_local l0, r0
        \\  10: 47 00 00 00 00                   get_local r0, l0
        \\  15: 0d 02 00 00 00 00 00             array_create r2, 0
        \\  22: 0e 02 00 00 00                   array_push r2, r0
        \\  27: 83 01 00 02 00                   super_call r1, r2
        \\  32: 77 ff ff                         return
        \\
        \\IR (Foo)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("x")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("x"), %1
        \\  %3: [  3..5  ]                       this
        \\  %4: [  4..5  ]                       get_binding @0 ("x")
        \\  %5: [  5..5  ]                       set_private_element %3, @0 ("x"), %4
        \\  %6: [  6..6  ]                       return none
        \\
        \\Bytecode (Foo)
        \\   0: 80 00 00 00 00                   get_argument r0, 0
        \\   5: 4c 00 00 00 00                   set_local l0, r0
        \\  10: 1c 00 00                         resolve_this_binding r0
        \\  13: 47 01 00 00 00                   get_local r1, l0
        \\  18: 8f 00 00 00 00 00 00 01 00       set_private_element r0, @0 ("x"), r1
        \\  27: 77 ff ff                         return
        \\
        \\IR (getX)
        \\  %0: [  0..2  ]                       this
        \\  %1: [  1..2  ]                       get_super_property @0 ("getX")
        \\  %2: [  2..4  ]                       call %1, %0, []
        \\  %3: [  3..4  ]                       one
        \\  %4: [  4..5  ]                       add %2, %3
        \\  %5: [  5..5  ]                       return %4
        \\  %6: [  6..6  ] dead                  return none
        \\
        \\Bytecode (getX)
