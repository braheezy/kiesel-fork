    // Unbounded recursion
    .{
        .source =
        \\try {
        \\  (function f() { f(); })();
        \\} catch (e) {
        \\  e.toString();
        \\}
        \\
        ,
        .expected_result = .{ .value = .{ .string = "Error: Stack overflow" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..6  ]                       label
        \\  %1: [  1..2  ]                       create_function @0
        \\  %2: [  2..4  ]                       call %1, none, []
        \\  %3: [  3..6  ]                       label
        \\  %4: [  4..4  ]                       br %15, %2
        \\  %5: [  5..6  ]                       label
        \\  %6: [  6..9  ]                       exception_handler %0, %3, %5, 0
        \\  %7: [  7..7  ]                       push_scope
        \\  %8: [  8..8  ]                       create_mutable_binding @1 ("e")
        \\  %9: [  9..9  ]                       initialize_binding @1 ("e"), %6
        \\ %10: [ 10..12 ]                       get_binding @1 ("e")
        \\ %11: [ 11..12 ]                       get_property %10, @2 ("toString")
        \\ %12: [ 12..14 ]                       call %11, %10, []
        \\ %13: [ 13..13 ]                       pop_scope
        \\ %14: [ 14..14 ]                       br %15, %12
        \\ %15: [ 15..16 ]                       label
        \\ %16: [ 16..16 ]                       return %15
        \\
        \\Bytecode (test)
        \\   0: 78 01 00 00 00                   create_function r1, @0
        \\   5: 5b 02 00 01 00                   call0 r2, r1
        \\  10: 0c 00 00 02 00                   move r0, r2
        \\  15: 74 00 00                         return r0
        \\  18: 3e                               push_scope
        \\  19: 43 01 00 00 00                   create_mutable_binding @1 ("e")
        \\  24: 45 01 00 00 00 03 00             initialize_binding @1 ("e"), r3
        \\  31: 46 00 00 01 00 00 00             get_binding r0, @1 ("e")
        \\  38: 47 01 00 00 00 02 00 00 00 00 00 get_property r1, r0, @2 ("toString"), @0
        \\  49: 5f 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  56: 41                               pop_scope
        \\  57: 0c 00 00 02 00                   move r0, r2
        \\  62: 00 cc ff ff ff                   jump -52
        \\
        \\Exception handlers
        \\  [   0..10  ) →   18, r3, 0
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..2  ]                       get_binding @0 ("f")
        \\  %2: [  2..2  ]                       call %1, none, []
        \\  %3: [  3..3  ]                       return none
        \\
        \\Bytecode (f)
        \\   0: 3e                               push_scope
        \\   1: 46 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\   8: 5b 01 00 00 00                   call0 r1, r0
        \\  13: 74 ff ff                         return
        \\
        ,
    },

    // Explicit resource management
    .{
        .source =
        \\var log = [];
        \\
        \\class Disposable {
        \\  constructor(x) {
        \\    this.x = x;
        \\  }
        \\
        \\  [Symbol.dispose]() {
        \\    log.push(this.x);
        \\  }
        \\}
        \\
        \\(function () {
        \\  using _ = new Disposable(1);
        \\})();
        \\
        \\for (using _ = new Disposable(2); false; );
        \\
        \\for (using _ of [new Disposable(3), new Disposable(4)]);
        \\
        \\try {
        \\  using _ = new Disposable(5);
        \\  throw new Error();
        \\} catch {}
        \\
        \\log.join(",");
        \\
        ,
        .expected_result = .{ .value = .{ .string = "1,2,3,4,5" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       array_create 0
        \\  %1: [  1..1  ]                       set_binding @0 ("log"), %0
        \\  %2: [  2..2  ]                       push_private_scope
        \\  %3: [  3..4  ]                       get_binding @2 ("Symbol")
        \\  %4: [  4..5  ]                       get_property %3, @3 ("dispose")
        \\  %5: [  5..7  ]                       create_class @0, none, [%4]
        \\  %6: [  6..6  ]                       pop_private_scope
        \\  %7: [  7..7  ]                       initialize_binding @1 ("Disposable"), %5
        \\  %8: [  8..9  ]                       create_function @0
        \\  %9: [  9..9  ]                       call %8, none, []
        \\ %10: [ 10..10 ]                       push_scope
        \\ %11: [ 11..11 ]                       create_immutable_binding @4 ("_")
        \\ %12: [ 12..14 ]                       get_binding @1 ("Disposable")
        \\ %13: [ 13..14 ]                       number 2
        \\ %14: [ 14..16 ]                       construct %12, [%13]
        \\ %15: [ 15..15 ]                       add_disposable_resource_sync %14
        \\ %16: [ 16..16 ]                       initialize_binding @4 ("_"), %14
        \\ %17: [ 17..17 ]                       dispose_resources
        \\ %18: [ 18..18 ]                       pop_scope
        \\ %19: [ 19..19 ] dead                  undefined
        \\ %20: [ 20..30 ]                       array_create 2
        \\ %21: [ 21..23 ]                       get_binding @1 ("Disposable")
        \\ %22: [ 22..23 ]                       number 3
        \\ %23: [ 23..24 ]                       construct %21, [%22]
        \\ %24: [ 24..24 ]                       array_push %20, %23
        \\ %25: [ 25..27 ]                       get_binding @1 ("Disposable")
        \\ %26: [ 26..27 ]                       number 4
        \\ %27: [ 27..28 ]                       construct %25, [%26]
        \\ %28: [ 28..28 ]                       array_push %20, %27
        \\ %29: [ 29..44 ]                       undefined
        \\ %30: [ 30..44 ]                       get_iterator %20
        \\ %31: [ 31..31 ]                       br %32, %29
        \\ %32: [ 32..46 ]                       label
        \\ %33: [ 33..41 ]                       iterator_step_value %30
        \\ %34: [ 34..35 ]                       iterator_is_done %30
        \\ %35: [ 35..36 ]                       logical_not %34
        \\ %36: [ 36..36 ]                       br_cond %35, %37, %45
        \\ %37: [ 37..37 ]                       label
        \\ %38: [ 38..38 ]                       push_scope
        \\ %39: [ 39..39 ]                       create_immutable_binding @4 ("_")
        \\ %40: [ 40..40 ]                       add_disposable_resource_sync %33
        \\ %41: [ 41..41 ]                       initialize_binding @4 ("_"), %33
        \\ %42: [ 42..42 ]                       dispose_resources
        \\ %43: [ 43..43 ]                       pop_scope
        \\ %44: [ 44..44 ]                       br %32, %29
        \\ %45: [ 45..45 ]                       label
        \\ %46: [ 46..46 ]                       br %47, %32
        \\ %47: [ 47..47 ]                       label
        \\ %48: [ 48..65 ]                       label
        \\ %49: [ 49..49 ]                       push_scope
        \\ %50: [ 50..50 ]                       create_immutable_binding @4 ("_")
        \\ %51: [ 51..53 ]                       get_binding @1 ("Disposable")
        \\ %52: [ 52..53 ]                       number 5
        \\ %53: [ 53..55 ]                       construct %51, [%52]
        \\ %54: [ 54..54 ]                       add_disposable_resource_sync %53
        \\ %55: [ 55..55 ]                       initialize_binding @4 ("_"), %53
        \\ %56: [ 56..57 ]                       get_binding @5 ("Error")
        \\ %57: [ 57..58 ]                       construct %56, []
        \\ %58: [ 58..58 ]                       throw %57
        \\ %59: [ 59..59 ] dead                  dispose_resources
        \\ %60: [ 60..60 ] dead                  pop_scope
        \\ %61: [ 61..63 ] dead                  undefined
        \\ %62: [ 62..65 ]                       label
