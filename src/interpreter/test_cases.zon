.{
    // Empty script
    .{
        .source = "",
        .expected_result = .{ .value = null },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..0  ]                       return none
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 90 ff ff                         return
        \\
        ,
    },

    // Simple expression statement
    .{
        .source =
        \\42;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 42 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       number 42
        \\  %1: [  1..1  ]                       return %0
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 2a 00 00 00             load_number_i32 r0, 42
        \\   7: 90 00 00                         return r0
        \\
        ,
    },

    // Dead code elimination
    .{
        .source =
        \\1;
        \\while (true) {
        \\  2;
        \\  break;
        \\  3;
        \\}
        \\4;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 4 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..0  ] dead                  one
        \\  %1: [  1..2  ]                       undefined
        \\  %2: [  2..2  ]                       br %3, %1
        \\  %3: [  3..12 ]                       label
        \\  %4: [  4..5  ]                       true
        \\  %5: [  5..5  ]                       br_cond %4, %6, %11
        \\  %6: [  6..6  ]                       label
        \\  %7: [  7..8  ]                       number 2
        \\  %8: [  8..8  ]                       br %13, %7
        \\  %9: [  9..10 ] dead                  number 3
        \\ %10: [ 10..10 ] dead                  br %3, %9
        \\ %11: [ 11..11 ]                       label
        \\ %12: [ 12..12 ]                       br %13, %3
        \\ %13: [ 13..13 ]                       label
        \\ %14: [ 14..15 ]                       number 4
        \\ %15: [ 15..15 ]                       return %14
        \\
        ,
        .expected_bc = null,
    },

    // Constant folding and propagation
    .{
        .source =
        \\if (null ?? "foo") {
        \\  do {
        \\    1 + 2 + 3;
        \\  } while (0);
        \\}
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..8  ]                       label
        \\  %1: [  1..1  ] dead                  undefined
        \\  %2: [  2..3  ]                       number 6
        \\  %3: [  3..3  ]                       br %4, %2
        \\  %4: [  4..10 ]                       label
        \\  %5: [  5..6  ]                       zero
        \\  %6: [  6..6  ]                       br_cond %5, %7, %9
        \\  %7: [  7..7  ]                       label
        \\  %8: [  8..8  ]                       br %0, %4
        \\  %9: [  9..9  ]                       label
        \\ %10: [ 10..10 ]                       br %11, %4
        \\ %11: [ 11..12 ]                       label
        \\ %12: [ 12..12 ]                       return %11
        \\
        ,
        .expected_bc = null,
    },

    // Array literal
    .{
        .source =
        \\[1, , [2, 3], {x: 4}];
        \\
        ,
        .expected_result = .ignore,
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..7  ]                       one
        \\  %1: [  1..3  ]                       number 2
        \\  %2: [  2..3  ]                       number 3
        \\  %3: [  3..7  ]                       array [%1, %2]
        \\  %4: [  4..6  ]                       string @0 ("x")
        \\  %5: [  5..6  ]                       number 4
        \\  %6: [  6..7  ]                       object {%4: %5}
        \\  %7: [  7..8  ]                       array [%0, none, %3, %6]
        \\  %8: [  8..8  ]                       return %7
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 01 00 00 00             load_number_i32 r0, 1
        \\   7: 07 01 00 02 00 00 00             load_number_i32 r1, 2
        \\  14: 07 02 00 03 00 00 00             load_number_i32 r2, 3
        \\  21: 0c 03 00 02 00 00 00             array_create r3, 2
        \\  28: 0f 03 00 01 00 00 00 00 00       array_set r3, r1, 0
        \\  37: 0f 03 00 02 00 01 00 00 00       array_set r3, r2, 1
        \\  46: 09 01 00 00 00 00 00             load_string r1, @0 ("x")
        \\  53: 07 02 00 04 00 00 00             load_number_i32 r2, 4
        \\  60: 11 04 00                         object_create r4
        \\  63: 12 04 00 00 00 00 00 02 00       object_set r4, @0 ("x"), r2
        \\  72: 0c 01 00 04 00 00 00             array_create r1, 4
        \\  79: 0f 01 00 00 00 00 00 00 00       array_set r1, r0, 0
        \\  88: 0f 01 00 03 00 02 00 00 00       array_set r1, r3, 2
        \\  97: 0f 01 00 04 00 03 00 00 00       array_set r1, r4, 3
        \\ 106: 90 01 00                         return r1
        \\
        ,
    },

    // Object literal
    .{
        .source =
        \\var a = 1;
        \\var o = {c: 2};
        \\var p = {};
        \\({a, [2]: "two", b: 3, ...o, __proto__: p});
        \\
        ,
        .expected_result = .ignore,
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       one
        \\  %1: [  1..1  ]                       set_binding @0 ("a"), %0
        \\  %2: [  2..4  ]                       string @1 ("c")
        \\  %3: [  3..4  ]                       number 2
        \\  %4: [  4..5  ]                       object {%2: %3}
        \\  %5: [  5..5  ]                       set_binding @2 ("o"), %4
        \\  %6: [  6..7  ]                       object {}
        \\  %7: [  7..7  ]                       set_binding @3 ("p"), %6
        \\  %8: [  8..17 ]                       string @0 ("a")
        \\  %9: [  9..17 ]                       get_binding @0 ("a")
        \\ %10: [ 10..17 ]                       number 2
        \\ %11: [ 11..17 ]                       string @4 ("two")
        \\ %12: [ 12..17 ]                       string @5 ("b")
        \\ %13: [ 13..17 ]                       number 3
        \\ %14: [ 14..15 ]                       get_binding @2 ("o")
        \\ %15: [ 15..17 ]                       spread %14
        \\ %16: [ 16..17 ]                       get_binding @3 ("p")
        \\ %17: [ 17..18 ]                       object {%8: %9, %10: %11, %12: %13, none: %15, none: %16}
        \\ %18: [ 18..18 ]                       return %17
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 01 00 00 00             load_number_i32 r0, 1
        \\   7: 46 00 00 00 00 00 00             set_binding @0 ("a"), r0
        \\  14: 0b 01 00 00 00                   move r1, r0
        \\  19: 09 00 00 01 00 00 00             load_string r0, @1 ("c")
        \\  26: 07 01 00 02 00 00 00             load_number_i32 r1, 2
        \\  33: 11 02 00                         object_create r2
        \\  36: 12 02 00 01 00 00 00 01 00       object_set r2, @1 ("c"), r1
        \\  45: 46 02 00 00 00 02 00             set_binding @2 ("o"), r2
        \\  52: 0b 00 00 02 00                   move r0, r2
        \\  57: 11 00 00                         object_create r0
        \\  60: 46 03 00 00 00 00 00             set_binding @3 ("p"), r0
        \\  67: 0b 01 00 00 00                   move r1, r0
        \\  72: 09 00 00 00 00 00 00             load_string r0, @0 ("a")
        \\  79: 42 01 00 00 00 00 00             get_binding r1, @0 ("a")
        \\  86: 07 02 00 02 00 00 00             load_number_i32 r2, 2
        \\  93: 09 03 00 04 00 00 00             load_string r3, @4 ("two")
        \\ 100: 09 04 00 05 00 00 00             load_string r4, @5 ("b")
        \\ 107: 07 05 00 03 00 00 00             load_number_i32 r5, 3
        \\ 114: 42 06 00 02 00 00 00             get_binding r6, @2 ("o")
        \\ 121: 0b 07 00 06 00                   move r7, r6
        \\ 126: 42 06 00 03 00 00 00             get_binding r6, @3 ("p")
        \\ 133: 11 08 00                         object_create r8
        \\ 136: 12 08 00 00 00 00 00 01 00       object_set r8, @0 ("a"), r1
        \\ 145: 13 08 00 02 00 03 00             object_set_computed r8, r2, r3
        \\ 152: 12 08 00 05 00 00 00 05 00       object_set r8, @5 ("b"), r5
        \\ 161: 19 08 00 07 00                   object_spread r8, r7
        \\ 166: 18 08 00 06 00                   object_set_prototype r8, r6
        \\ 171: 90 08 00                         return r8
        \\
        ,
    },

    // Regular expression literal
    .{
        .source =
        \\/abc/gi;
        \\
        ,
        .expected_result = .ignore,
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       reg_exp @0 ("abc"), @1 ("gi")
        \\  %1: [  1..1  ]                       return %0
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 1a 00 00 00 00 00 00 01 00 00 00 reg_exp_create r0, @0 ("abc"), @1 ("gi")
        \\  11: 90 00 00                         return r0
        \\
        ,
    },

    // Variable statements
    .{
        .source =
        \\var x = 1;
        \\
        ,
        .expected_result = .{ .value = null },
        .expected_ir = null,
        .expected_bc = null,
    },
    .{
        .source =
        \\var x = 10, y = 20;
        \\x + y;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 30 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       number 10
        \\  %1: [  1..1  ]                       set_binding @0 ("x"), %0
        \\  %2: [  2..3  ]                       number 20
        \\  %3: [  3..3  ]                       set_binding @1 ("y"), %2
        \\  %4: [  4..6  ]                       get_binding @0 ("x")
        \\  %5: [  5..6  ]                       get_binding @1 ("y")
        \\  %6: [  6..7  ]                       add %4, %5
        \\  %7: [  7..7  ]                       return %6
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 0a 00 00 00             load_number_i32 r0, 10
        \\   7: 46 00 00 00 00 00 00             set_binding @0 ("x"), r0
        \\  14: 0b 01 00 00 00                   move r1, r0
        \\  19: 07 00 00 14 00 00 00             load_number_i32 r0, 20
        \\  26: 46 01 00 00 00 00 00             set_binding @1 ("y"), r0
        \\  33: 0b 01 00 00 00                   move r1, r0
        \\  38: 42 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  45: 42 01 00 01 00 00 00             get_binding r1, @1 ("y")
        \\  52: 25 02 00 00 00 01 00             add r2, r0, r1
        \\  59: 90 02 00                         return r2
        \\
        ,
    },

    // Lexical declarations
    .{
        .source =
        \\let a = 1;
        \\{
        \\  let a = 2;
        \\}
        \\a;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 1 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       one
        \\  %1: [  1..1  ]                       initialize_binding @0 ("a"), %0
        \\  %2: [  2..2  ]                       push_scope
        \\  %3: [  3..3  ]                       create_mutable_binding @0 ("a")
        \\  %4: [  4..5  ]                       number 2
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ]                       pop_scope
        \\  %7: [  7..8  ]                       get_binding @0 ("a")
        \\  %8: [  8..8  ]                       return %7
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 01 00 00 00             load_number_i32 r0, 1
        \\   7: 41 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  14: 0b 01 00 00 00                   move r1, r0
        \\  19: 3b                               push_scope
        \\  20: 3f 00 00 00 00                   create_mutable_binding @0 ("a")
        \\  25: 07 00 00 02 00 00 00             load_number_i32 r0, 2
        \\  32: 41 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  39: 0b 01 00 00 00                   move r1, r0
        \\  44: 3e                               pop_scope
        \\  45: 42 00 00 00 00 00 00             get_binding r0, @0 ("a")
        \\  52: 90 00 00                         return r0
        \\
        ,
    },

    // Increment/decrement operators
    .{
        .source =
        \\x = 5;
        \\++x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       number 5
        \\  %1: [  1..1  ]                       set_binding @0 ("x"), %0
        \\  %2: [  2..3  ]                       update_binding @0 ("x"), increment_prefix
        \\  %3: [  3..3  ]                       return %2
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 05 00 00 00             load_number_i32 r0, 5
        \\   7: 46 00 00 00 00 00 00             set_binding @0 ("x"), r0
        \\  14: 0b 01 00 00 00                   move r1, r0
        \\  19: 4e 00 00 00 00 00 00             increment_binding_prefix r0, @0 ("x")
        \\  26: 90 00 00                         return r0
        \\
        ,
    },
    .{
        .source = "x = 5; x++;",
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_ir = null,
        .expected_bc = null,
    },
    .{
        .source = "x = 10; --x;",
        .expected_result = .{ .value = .{ .number = 9 } },
        .expected_ir = null,
        .expected_bc = null,
    },
    .{
        .source = "x = 10; x--;",
        .expected_result = .{ .value = .{ .number = 10 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Logical expression
    .{
        .source =
        \\false && doesnotexist;
        \\true || doesnotexist;
        \\1 ?? doesnotexist;
        \\
        \\var x = 0;
        \\true && (x += 1);
        \\false || (x += 2);
        \\null ?? (x += 3);
        \\x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..0  ] dead                  false
        \\  %1: [  1..1  ] dead                  true
        \\  %2: [  2..2  ] dead                  one
        \\  %3: [  3..4  ]                       zero
        \\  %4: [  4..4  ]                       set_binding @0 ("x"), %3
        \\  %5: [  5..8  ]                       true
        \\  %6: [  6..6  ]                       br_cond %5, %9, %7
        \\  %7: [  7..7  ]                       label
        \\  %8: [  8..8  ]                       br %15, %5
        \\  %9: [  9..9  ]                       label
        \\ %10: [ 10..12 ]                       get_binding @0 ("x")
        \\ %11: [ 11..12 ]                       one
        \\ %12: [ 12..13 ]                       add %10, %11
        \\ %13: [ 13..14 ]                       set_binding @0 ("x"), %12
        \\ %14: [ 14..14 ]                       br %15, %13
        \\ %15: [ 15..15 ]                       label
        \\ %16: [ 16..19 ]                       false
        \\ %17: [ 17..17 ]                       br_cond %16, %18, %20
        \\ %18: [ 18..18 ]                       label
        \\ %19: [ 19..19 ]                       br %26, %16
        \\ %20: [ 20..20 ]                       label
        \\ %21: [ 21..23 ]                       get_binding @0 ("x")
        \\ %22: [ 22..23 ]                       number 2
        \\ %23: [ 23..24 ]                       add %21, %22
        \\ %24: [ 24..25 ]                       set_binding @0 ("x"), %23
        \\ %25: [ 25..25 ]                       br %26, %24
        \\ %26: [ 26..26 ]                       label
        \\ %27: [ 27..32 ]                       null
        \\ %28: [ 28..29 ]                       null
        \\ %29: [ 29..30 ]                       eq %27, %28
        \\ %30: [ 30..30 ]                       br_cond %29, %33, %31
        \\ %31: [ 31..31 ]                       label
        \\ %32: [ 32..32 ]                       br %39, %27
        \\ %33: [ 33..33 ]                       label
        \\ %34: [ 34..36 ]                       get_binding @0 ("x")
        \\ %35: [ 35..36 ]                       number 3
        \\ %36: [ 36..37 ]                       add %34, %35
        \\ %37: [ 37..38 ]                       set_binding @0 ("x"), %36
        \\ %38: [ 38..38 ]                       br %39, %37
        \\ %39: [ 39..39 ]                       label
        \\ %40: [ 40..41 ]                       get_binding @0 ("x")
        \\ %41: [ 41..41 ]                       return %40
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 00 00 00 00             load_number_i32 r0, 0
        \\   7: 46 00 00 00 00 00 00             set_binding @0 ("x"), r0
        \\  14: 0b 01 00 00 00                   move r1, r0
        \\  19: 05 00 00                         load_true r0
        \\  22: 01 00 00 05 00 00 00             jump_if_true r0, 5
        \\  29: 00 26 00 00 00                   jump 38
        \\  34: 42 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  41: 07 01 00 01 00 00 00             load_number_i32 r1, 1
        \\  48: 25 02 00 00 00 01 00             add r2, r0, r1
        \\  55: 46 00 00 00 00 02 00             set_binding @0 ("x"), r2
        \\  62: 0b 00 00 02 00                   move r0, r2
        \\  67: 00 00 00 00 00                   jump 0
        \\  72: 06 00 00                         load_false r0
        \\  75: 01 00 00 05 00 00 00             jump_if_true r0, 5
        \\  82: 00 05 00 00 00                   jump 5
        \\  87: 00 21 00 00 00                   jump 33
        \\  92: 42 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  99: 07 01 00 02 00 00 00             load_number_i32 r1, 2
        \\ 106: 25 02 00 00 00 01 00             add r2, r0, r1
        \\ 113: 46 00 00 00 00 02 00             set_binding @0 ("x"), r2
        \\ 120: 0b 00 00 02 00                   move r0, r2
        \\ 125: 04 00 00                         load_null r0
        \\ 128: 04 01 00                         load_null r1
        \\ 131: 37 02 00 00 00 01 00             eq r2, r0, r1
        \\ 138: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 145: 00 26 00 00 00                   jump 38
        \\ 150: 42 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\ 157: 07 01 00 03 00 00 00             load_number_i32 r1, 3
        \\ 164: 25 02 00 00 00 01 00             add r2, r0, r1
        \\ 171: 46 00 00 00 00 02 00             set_binding @0 ("x"), r2
        \\ 178: 0b 00 00 02 00                   move r0, r2
        \\ 183: 00 00 00 00 00                   jump 0
        \\ 188: 42 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\ 195: 90 00 00                         return r0
        \\
        ,
    },

    // Call expressions
    .{
        .source =
        \\Math.random();
        \\Number("1");
        \\JSON.stringify({ foo: "bar" }, null, 2)
        \\Math.max(1, 5, ...[3, 9], 2);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 9 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..2  ]                       get_binding @0 ("Math")
        \\  %1: [  1..2  ]                       get_property %0, @1 ("random")
        \\  %2: [  2..2  ]                       call %1, %0, []
        \\  %3: [  3..5  ]                       get_binding @2 ("Number")
        \\  %4: [  4..5  ]                       string @3 ("1")
        \\  %5: [  5..5  ]                       call %3, none, [%4]
        \\  %6: [  6..13 ]                       get_binding @4 ("JSON")
        \\  %7: [  7..13 ]                       get_property %6, @5 ("stringify")
        \\  %8: [  8..10 ]                       string @6 ("foo")
        \\  %9: [  9..10 ]                       string @7 ("bar")
        \\ %10: [ 10..13 ]                       object {%8: %9}
        \\ %11: [ 11..13 ]                       null
        \\ %12: [ 12..13 ]                       number 2
        \\ %13: [ 13..13 ]                       call %7, %6, [%10, %11, %12]
        \\ %14: [ 14..23 ]                       get_binding @0 ("Math")
        \\ %15: [ 15..23 ]                       get_property %14, @8 ("max")
        \\ %16: [ 16..23 ]                       one
        \\ %17: [ 17..23 ]                       number 5
        \\ %18: [ 18..20 ]                       number 3
        \\ %19: [ 19..20 ]                       number 9
        \\ %20: [ 20..21 ]                       array [%18, %19]
        \\ %21: [ 21..23 ]                       spread %20
        \\ %22: [ 22..23 ]                       number 2
        \\ %23: [ 23..24 ]                       call %15, %14, [%16, %17, %21, %22]
        \\ %24: [ 24..24 ]                       return %23
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 42 00 00 00 00 00 00             get_binding r0, @0 ("Math")
        \\   7: 43 01 00 00 00 01 00 00 00 00 00 get_property r1, r0, @1 ("random"), @0
        \\  18: 7b 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  25: 42 00 00 02 00 00 00             get_binding r0, @2 ("Number")
        \\  32: 09 01 00 03 00 00 00             load_string r1, @3 ("1")
        \\  39: 78 02 00 00 00 01 00             call1 r2, r0, r1
        \\  46: 42 00 00 04 00 00 00             get_binding r0, @4 ("JSON")
        \\  53: 43 01 00 00 00 05 00 00 00 01 00 get_property r1, r0, @5 ("stringify"), @1
        \\  64: 09 02 00 06 00 00 00             load_string r2, @6 ("foo")
        \\  71: 09 03 00 07 00 00 00             load_string r3, @7 ("bar")
        \\  78: 11 04 00                         object_create r4
        \\  81: 12 04 00 06 00 00 00 03 00       object_set r4, @6 ("foo"), r3
        \\  90: 04 02 00                         load_null r2
        \\  93: 07 03 00 02 00 00 00             load_number_i32 r3, 2
        \\ 100: 0c 07 00 00 00 00 00             array_create r7, 0
        \\ 107: 0d 07 00 04 00                   array_push r7, r4
        \\ 112: 0d 07 00 02 00                   array_push r7, r2
        \\ 117: 0d 07 00 03 00                   array_push r7, r3
        \\ 122: 7a 05 00 01 00 00 00 07 00       call_property r5, r1, r0, r7
        \\ 131: 42 00 00 00 00 00 00             get_binding r0, @0 ("Math")
        \\ 138: 43 01 00 00 00 08 00 00 00 02 00 get_property r1, r0, @8 ("max"), @2
        \\ 149: 07 02 00 01 00 00 00             load_number_i32 r2, 1
        \\ 156: 07 03 00 05 00 00 00             load_number_i32 r3, 5
        \\ 163: 07 04 00 03 00 00 00             load_number_i32 r4, 3
        \\ 170: 07 05 00 09 00 00 00             load_number_i32 r5, 9
        \\ 177: 0c 06 00 02 00 00 00             array_create r6, 2
        \\ 184: 0f 06 00 04 00 00 00 00 00       array_set r6, r4, 0
        \\ 193: 0f 06 00 05 00 01 00 00 00       array_set r6, r5, 1
        \\ 202: 0b 04 00 06 00                   move r4, r6
        \\ 207: 07 05 00 02 00 00 00             load_number_i32 r5, 2
        \\ 214: 0c 07 00 00 00 00 00             array_create r7, 0
        \\ 221: 0d 07 00 02 00                   array_push r7, r2
        \\ 226: 0d 07 00 03 00                   array_push r7, r3
        \\ 231: 10 07 00 04 00                   array_spread r7, r4
        \\ 236: 0d 07 00 05 00                   array_push r7, r5
        \\ 241: 7a 06 00 01 00 00 00 07 00       call_property r6, r1, r0, r7
        \\ 250: 90 06 00                         return r6
        \\
        ,
    },

    // Destructuring assignment
    .{
        .source =
        \\const {a, ...rest} = {a: 1, b: 2, c: 3};
        \\const [x, y] = [10, 20];
        \\const {d: {e}} = {d: {e: 5}};
        \\const {f = 99} = {f: undefined};
        \\const g = ({} = {g: 42}).g;
        \\
