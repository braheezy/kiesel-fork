        \\
        \\Bytecode (test)
        \\   0: 0d 00 00 00 00 00 00             array_create r0, 0
        \\   7: 4e 00 00 00 00 00 00             set_binding @0 ("log"), r0
        \\  14: 8b                               push_private_scope
