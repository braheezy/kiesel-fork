    // Switch statement
    .{
        .source =
        \\var x = 0;
        \\switch("b") {
        \\    case "a": x = 1; break;
        \\    case "b": let y = 2; x = y;
        \\    case "c": x = x + 3; break;
        \\    default: x = 100;
        \\}
        \\x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       zero
        \\  %1: [  1..1  ]                       set_binding @0 ("x"), %0
        \\  %2: [  2..17 ]                       string @1 ("b")
        \\  %3: [  3..3  ]                       push_scope
        \\  %4: [  4..4  ]                       create_mutable_binding @2 ("y")
