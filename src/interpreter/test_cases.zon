        \\ %10: [ 10..11 ]                       call %9, %8, []
        \\ %11: [ 11..12 ]                       await %10
        \\ %12: [ 12..12 ]                       set_binding @1 ("a"), %11
        \\ %13: [ 13..15 ]                       get_binding @0 ("gen")
        \\ %14: [ 14..15 ]                       get_property %13, @5 ("next")
        \\ %15: [ 15..16 ]                       call %14, %13, []
        \\ %16: [ 16..17 ]                       await %15
        \\ %17: [ 17..17 ]                       set_binding @2 ("b"), %16
        \\ %18: [ 18..20 ]                       get_binding @0 ("gen")
        \\ %19: [ 19..20 ]                       get_property %18, @5 ("next")
        \\ %20: [ 20..21 ]                       call %19, %18, []
        \\ %21: [ 21..22 ]                       await %20
        \\ %22: [ 22..22 ]                       set_binding @3 ("c"), %21
        \\ %23: [ 23..24 ]                       get_binding @1 ("a")
        \\ %24: [ 24..27 ]                       get_property %23, @6 ("value")
        \\ %25: [ 25..26 ]                       get_binding @2 ("b")
        \\ %26: [ 26..27 ]                       get_property %25, @6 ("value")
        \\ %27: [ 27..30 ]                       add %24, %26
        \\ %28: [ 28..29 ]                       get_binding @3 ("c")
        \\ %29: [ 29..30 ]                       get_property %28, @6 ("value")
        \\ %30: [ 30..31 ]                       add %27, %29
        \\ %31: [ 31..31 ]                       return %30
        \\ %32: [ 32..32 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 42 00 00 00 00                   create_var_binding @0 ("gen")
        \\   5: 42 01 00 00 00                   create_var_binding @1 ("a")
        \\  10: 42 02 00 00 00                   create_var_binding @2 ("b")
        \\  15: 42 03 00 00 00                   create_var_binding @3 ("c")
        \\  20: 3e                               push_scope
        \\  21: 46 00 00 04 00 00 00             get_binding r0, @4 ("g")
        \\  28: 5b 01 00 00 00                   call0 r1, r0
        \\  33: 4a 00 00 00 00 01 00             set_binding @0 ("gen"), r1
        \\  40: 46 00 00 00 00 00 00             get_binding r0, @0 ("gen")
        \\  47: 47 01 00 00 00 05 00 00 00 00 00 get_property r1, r0, @5 ("next"), @0
        \\  58: 5f 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  65: 75 00 00 02 00                   await r0, r2
        \\  70: 4a 01 00 00 00 00 00             set_binding @1 ("a"), r0
        \\  77: 46 00 00 00 00 00 00             get_binding r0, @0 ("gen")
        \\  84: 47 01 00 00 00 05 00 00 00 01 00 get_property r1, r0, @5 ("next"), @1
        \\  95: 5f 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\ 102: 75 00 00 02 00                   await r0, r2
        \\ 107: 4a 02 00 00 00 00 00             set_binding @2 ("b"), r0
        \\ 114: 46 00 00 00 00 00 00             get_binding r0, @0 ("gen")
        \\ 121: 47 01 00 00 00 05 00 00 00 02 00 get_property r1, r0, @5 ("next"), @2
        \\ 132: 5f 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\ 139: 75 00 00 02 00                   await r0, r2
        \\ 144: 4a 03 00 00 00 00 00             set_binding @3 ("c"), r0
        \\ 151: 46 00 00 01 00 00 00             get_binding r0, @1 ("a")
        \\ 158: 47 01 00 00 00 06 00 00 00 03 00 get_property r1, r0, @6 ("value"), @3
        \\ 169: 46 00 00 02 00 00 00             get_binding r0, @2 ("b")
        \\ 176: 47 02 00 00 00 06 00 00 00 04 00 get_property r2, r0, @6 ("value"), @4
        \\ 187: 28 00 00 01 00 02 00             add r0, r1, r2
        \\ 194: 46 01 00 03 00 00 00             get_binding r1, @3 ("c")
        \\ 201: 47 02 00 01 00 06 00 00 00 05 00 get_property r2, r1, @6 ("value"), @5
        \\ 212: 28 01 00 00 00 02 00             add r1, r0, r2
        \\ 219: 74 01 00                         return r1
        \\
        \\IR (g)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       one
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 2
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..7  ]                       number 3
        \\  %7: [  7..7  ]                       yield %6
        \\  %8: [  8..8  ]                       return none
