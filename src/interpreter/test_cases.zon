    // For-in/of statement
    .{
        .source =
        \\var sum = 0;
        \\for (var x of [1, 2, 3]) {
        \\  sum = sum + x;
        \\}
        \\sum;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       zero
        \\  %1: [  1..1  ]                       set_binding @0 ("sum"), %0
        \\  %2: [  2..10 ]                       array_create 3
        \\  %3: [  3..4  ]                       one
        \\  %4: [  4..4  ]                       array_push %2, %3
        \\  %5: [  5..6  ]                       number 2
        \\  %6: [  6..6  ]                       array_push %2, %5
        \\  %7: [  7..8  ]                       number 3
        \\  %8: [  8..8  ]                       array_push %2, %7
        \\  %9: [  9..11 ]                       undefined
        \\ %10: [ 10..23 ]                       get_iterator %2
        \\ %11: [ 11..11 ]                       br %12, %9
        \\ %12: [ 12..25 ]                       label
        \\ %13: [ 13..18 ]                       iterator_step_value %10
        \\ %14: [ 14..15 ]                       iterator_is_done %10
        \\ %15: [ 15..16 ]                       logical_not %14
        \\ %16: [ 16..16 ]                       br_cond %15, %17, %24
        \\ %17: [ 17..17 ]                       label
        \\ %18: [ 18..18 ]                       set_binding @1 ("x"), %13
        \\ %19: [ 19..21 ]                       get_binding @0 ("sum")
        \\ %20: [ 20..21 ]                       get_binding @1 ("x")
        \\ %21: [ 21..22 ]                       add %19, %20
        \\ %22: [ 22..23 ]                       set_binding @0 ("sum"), %21
        \\ %23: [ 23..23 ]                       br %12, %22
        \\ %24: [ 24..24 ]                       label
        \\ %25: [ 25..25 ]                       br %26, %12
        \\ %26: [ 26..26 ]                       label
        \\ %27: [ 27..28 ]                       get_binding @0 ("sum")
        \\ %28: [ 28..28 ]                       return %27
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 00                      load_number_i8 r0, 0
        \\   4: 47 00 00 00 00 00 00             set_binding @0 ("sum"), r0
        \\  11: 0d 00 00 03 00 00 00             array_create r0, 3
        \\  18: 07 01 00 01                      load_number_i8 r1, 1
        \\  22: 10 00 00 01 00 00 00 00 00       array_set r0, r1, 0
        \\  31: 07 01 00 02                      load_number_i8 r1, 2
        \\  35: 10 00 00 01 00 01 00 00 00       array_set r0, r1, 1
        \\  44: 07 01 00 03                      load_number_i8 r1, 3
        \\  48: 10 00 00 01 00 02 00 00 00       array_set r0, r1, 2
        \\  57: 03 01 00                         load_undefined r1
        \\  60: 86 02 00 00 00                   get_iterator r2, r0
        \\  65: 0c 00 00 01 00                   move r0, r1
        \\  70: 8a 01 00 02 00                   iterator_step_value r1, r2
        \\  75: 8d 03 00 02 00                   iterator_is_done r3, r2
        \\  80: 23 04 00 03 00                   logical_not r4, r3
        \\  85: 01 04 00 05 00 00 00             jump_if_true r4, 5
        \\  92: 00 32 00 00 00                   jump 50
        \\  97: 47 01 00 00 00 01 00             set_binding @1 ("x"), r1
        \\ 104: 43 01 00 00 00 00 00             get_binding r1, @0 ("sum")
        \\ 111: 43 03 00 01 00 00 00             get_binding r3, @1 ("x")
        \\ 118: 26 04 00 01 00 03 00             add r4, r1, r3
        \\ 125: 47 00 00 00 00 04 00             set_binding @0 ("sum"), r4
        \\ 132: 0c 01 00 04 00                   move r1, r4
        \\ 137: 0c 00 00 01 00                   move r0, r1
        \\ 142: 00 b3 ff ff ff                   jump -77
        \\ 147: 43 00 00 00 00 00 00             get_binding r0, @0 ("sum")
        \\ 154: 91 00 00                         return r0
        \\
        ,
    },

    // For-in/of with member expression LHS
    .{
        .source =
        \\var x = {};
        \\for (x.last in {a: 1, b: 2, c: 3});
        \\x.last;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "c" } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // With statement
    .{
        .source =
        \\var o = {x: 1};
        \\with (o) { x }
        \\
        ,
        .expected_result = .{ .value = .{ .number = 1 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..3  ]                       object_create
        \\  %1: [  1..2  ]                       one
        \\  %2: [  2..2  ]                       object_set %0, @0 ("x"), %1
        \\  %3: [  3..3  ]                       set_binding @1 ("o"), %0
        \\  %4: [  4..5  ]                       get_binding @1 ("o")
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..6  ]                       push_with_scope %5
        \\  %7: [  7..9  ]                       get_binding @0 ("x")
        \\  %8: [  8..8  ]                       pop_scope
        \\  %9: [  9..9  ]                       return %7
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 07 01 00 01                      load_number_i8 r1, 1
        \\   7: 13 00 00 00 00 00 00 01 00       object_set r0, @0 ("x"), r1
        \\  16: 47 01 00 00 00 00 00             set_binding @1 ("o"), r0
        \\  23: 43 00 00 01 00 00 00             get_binding r0, @1 ("o")
        \\  30: 20 01 00 00 00                   to_object r1, r0
        \\  35: 3e 01 00                         push_with_scope r1
        \\  38: 43 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  45: 3f                               pop_scope
        \\  46: 91 00 00                         return r0
        \\
        ,
    },

    // Optional expression
    .{
        .source =
        \\var o = {a: {b: 123}};
        \\o.x?.y ?? o.a?.["b"];
        \\
        ,
        .expected_result = .{ .value = .{ .number = 123 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..5  ]                       object_create
        \\  %1: [  1..4  ]                       object_create
        \\  %2: [  2..3  ]                       number 123
        \\  %3: [  3..3  ]                       object_set %1, @1 ("b"), %2
        \\  %4: [  4..4  ]                       object_set %0, @0 ("a"), %1
        \\  %5: [  5..5  ]                       set_binding @2 ("o"), %0
        \\  %6: [  6..7  ]                       get_binding @2 ("o")
        \\  %7: [  7..12 ]                       get_property %6, @3 ("x")
        \\  %8: [  8..9  ]                       null
        \\  %9: [  9..10 ]                       eq %7, %8
        \\ %10: [ 10..10 ]                       br_cond %9, %14, %11
        \\ %11: [ 11..11 ]                       label
        \\ %12: [ 12..13 ]                       get_property %7, @4 ("y")
        \\ %13: [ 13..13 ]                       br %17, %12
        \\ %14: [ 14..14 ]                       label
        \\ %15: [ 15..16 ]                       undefined
        \\ %16: [ 16..16 ]                       br %17, %15
        \\ %17: [ 17..22 ]                       label
        \\ %18: [ 18..19 ]                       null
        \\ %19: [ 19..20 ]                       eq %17, %18
        \\ %20: [ 20..20 ]                       br_cond %19, %23, %21
        \\ %21: [ 21..21 ]                       label
        \\ %22: [ 22..22 ]                       br %37, %17
        \\ %23: [ 23..23 ]                       label
        \\ %24: [ 24..25 ]                       get_binding @2 ("o")
        \\ %25: [ 25..30 ]                       get_property %24, @0 ("a")
        \\ %26: [ 26..27 ]                       null
        \\ %27: [ 27..28 ]                       eq %25, %26
        \\ %28: [ 28..28 ]                       br_cond %27, %32, %29
        \\ %29: [ 29..29 ]                       label
        \\ %30: [ 30..31 ]                       get_property %25, @1 ("b")
        \\ %31: [ 31..31 ]                       br %35, %30
        \\ %32: [ 32..32 ]                       label
        \\ %33: [ 33..34 ]                       undefined
        \\ %34: [ 34..34 ]                       br %35, %33
        \\ %35: [ 35..36 ]                       label
        \\ %36: [ 36..36 ]                       br %37, %35
        \\ %37: [ 37..38 ]                       label
        \\ %38: [ 38..38 ]                       return %37
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 12 01 00                         object_create r1
        \\   6: 07 02 00 7b                      load_number_i8 r2, 123
        \\  10: 13 01 00 01 00 00 00 02 00       object_set r1, @1 ("b"), r2
        \\  19: 13 00 00 00 00 00 00 01 00       object_set r0, @0 ("a"), r1
        \\  28: 47 02 00 00 00 00 00             set_binding @2 ("o"), r0
        \\  35: 43 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\  42: 44 01 00 00 00 03 00 00 00 00 00 get_property r1, r0, @3 ("x"), @0
        \\  53: 04 00 00                         load_null r0
        \\  56: 38 02 00 01 00 00 00             eq r2, r1, r0
        \\  63: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  70: 00 08 00 00 00                   jump 8
        \\  75: 03 00 00                         load_undefined r0
        \\  78: 00 0b 00 00 00                   jump 11
        \\  83: 44 00 00 01 00 04 00 00 00 01 00 get_property r0, r1, @4 ("y"), @1
        \\  94: 04 01 00                         load_null r1
        \\  97: 38 02 00 00 00 01 00             eq r2, r0, r1
        \\ 104: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 111: 00 40 00 00 00                   jump 64
        \\ 116: 43 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\ 123: 44 01 00 00 00 00 00 00 00 02 00 get_property r1, r0, @0 ("a"), @2
        \\ 134: 04 00 00                         load_null r0
        \\ 137: 38 02 00 01 00 00 00             eq r2, r1, r0
        \\ 144: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 151: 00 08 00 00 00                   jump 8
        \\ 156: 03 00 00                         load_undefined r0
        \\ 159: 00 0b 00 00 00                   jump 11
        \\ 164: 44 00 00 01 00 01 00 00 00 03 00 get_property r0, r1, @1 ("b"), @3
        \\ 175: 00 00 00 00 00                   jump 0
        \\ 180: 91 00 00                         return r0
        \\
        ,
    },

    // Template literal
    .{
        .source =
        \\var empty = ``;
        \\`${empty}a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       string @0 ("")
        \\  %1: [  1..1  ]                       set_binding @1 ("empty"), %0
        \\  %2: [  2..3  ]                       get_binding @1 ("empty")
        \\  %3: [  3..5  ]                       to_string %2
        \\  %4: [  4..5  ]                       string @2 ("a")
        \\  %5: [  5..8  ]                       add %3, %4
        \\  %6: [  6..7  ]                       string @3 ("b")
        \\  %7: [  7..8  ]                       to_string %6
        \\  %8: [  8..10 ]                       add %5, %7
        \\  %9: [  9..10 ]                       string @4 ("c")
        \\ %10: [ 10..11 ]                       add %8, %9
        \\ %11: [ 11..11 ]                       return %10
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 0a 00 00 00 00 00 00             load_string r0, @0 ("")
        \\   7: 47 01 00 00 00 00 00             set_binding @1 ("empty"), r0
        \\  14: 43 00 00 01 00 00 00             get_binding r0, @1 ("empty")
        \\  21: 1f 01 00 00 00                   to_string r1, r0
        \\  26: 0a 00 00 02 00 00 00             load_string r0, @2 ("a")
        \\  33: 26 02 00 01 00 00 00             add r2, r1, r0
        \\  40: 0a 00 00 03 00 00 00             load_string r0, @3 ("b")
        \\  47: 1f 01 00 00 00                   to_string r1, r0
        \\  52: 26 00 00 02 00 01 00             add r0, r2, r1
        \\  59: 0a 01 00 04 00 00 00             load_string r1, @4 ("c")
        \\  66: 26 02 00 00 00 01 00             add r2, r0, r1
        \\  73: 91 02 00                         return r2
        \\
        ,
    },

    // Tagged template
    .{
        .source =
        \\String.raw`a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..14 ]                       get_binding @0 ("String")
        \\  %1: [  1..14 ]                       get_property %0, @1 ("raw")
        \\  %2: [  2..12 ]                       array_create 2
        \\  %3: [  3..4  ]                       string @2 ("a")
        \\  %4: [  4..4  ]                       array_push %2, %3
        \\  %5: [  5..6  ]                       string @3 ("c")
        \\  %6: [  6..6  ]                       array_push %2, %5
        \\  %7: [  7..12 ]                       array_create 2
        \\  %8: [  8..9  ]                       string @2 ("a")
        \\  %9: [  9..9  ]                       array_push %7, %8
        \\ %10: [ 10..11 ]                       string @3 ("c")
        \\ %11: [ 11..11 ]                       array_push %7, %10
        \\ %12: [ 12..14 ]                       get_template_object %2, %7, 0
        \\ %13: [ 13..14 ]                       string @4 ("b")
        \\ %14: [ 14..15 ]                       call %1, %0, [%12, %13]
        \\ %15: [ 15..15 ]                       return %14
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 43 00 00 00 00 00 00             get_binding r0, @0 ("String")
        \\   7: 44 01 00 00 00 01 00 00 00 00 00 get_property r1, r0, @1 ("raw"), @0
        \\  18: 0d 02 00 02 00 00 00             array_create r2, 2
        \\  25: 0a 03 00 02 00 00 00             load_string r3, @2 ("a")
        \\  32: 10 02 00 03 00 00 00 00 00       array_set r2, r3, 0
        \\  41: 0a 03 00 03 00 00 00             load_string r3, @3 ("c")
        \\  48: 10 02 00 03 00 01 00 00 00       array_set r2, r3, 1
        \\  57: 0d 03 00 02 00 00 00             array_create r3, 2
        \\  64: 0a 04 00 02 00 00 00             load_string r4, @2 ("a")
        \\  71: 10 03 00 04 00 00 00 00 00       array_set r3, r4, 0
        \\  80: 0a 04 00 03 00 00 00             load_string r4, @3 ("c")
        \\  87: 10 03 00 04 00 01 00 00 00       array_set r3, r4, 1
        \\  96: 85 04 00 02 00 03 00 00 00       get_template_object r4, r2, r3, 0
        \\ 105: 0a 02 00 04 00 00 00             load_string r2, @4 ("b")
        \\ 112: 7e 03 00 01 00 00 00 04 00 02 00 call_property2 r3, r1, r0, r4, r2
        \\ 123: 91 03 00                         return r3
        \\
        ,
    },

    // Functions
    .{
        .source =
        \\var f = ({a}, b = 0, ...rest) => a + b + rest.length;
        \\f({a: 1}, 2, 3, 4);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Arguments object
    .{
        .source =
        \\function mapped(a) {
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\function unmapped(a) {
        \\  "use strict";
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\mapped(1) - unmapped(1);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 98 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Getter/setter
    .{
        .source =
        \\var o = {
        \\  get x() { return this._x; },
        \\  set x(v) { this._x = v; },
        \\};
        \\o.x = 42;
        \\o.x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 42 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Generator
    .{
        .source =
        \\function* h() {
        \\  yield 4;
        \\  yield 5;
        \\}
        \\function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\  yield* h();
        \\}
        \\function f() {
        \\  var gen = g();
        \\  var sum = 0;
        \\  while (true) {
        \\    var result = gen.next();
        \\    if (result.done) break;
        \\    sum += result.value;
        \\  }
        \\  return sum;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 15 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Async Generator
    .{
        .source =
        \\async function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\}
        \\async function f() {
        \\  var gen = g();
        \\  var a = await gen.next();
        \\  var b = await gen.next();
        \\  var c = await gen.next();
        \\  return a.value + b.value + c.value;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .promise = .{ .fulfilled = .{ .number = 6 } } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Classes
    .{
        .source =
        \\class Foo {
        \\  #x;
        \\  constructor(x) { this.#x = x; }
        \\  getX() { return this.#x; }
        \\}
        \\class Bar extends Foo {
        \\  constructor(x) { super(x); }
        \\  getX() { return super.getX() + 1; }
        \\}
        \\var bar = new Bar(42);
        \\bar.getX();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 43 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Call expression LHS
    .{
        .source =
        \\var calls = 0;
        \\var caught = 0;
        \\function foo() { calls += 1; }
        \\
        \\try { foo() = 1; } catch { caught += 1; }
        \\try { foo() += 1; } catch { caught += 1; }
        \\try { foo()++; } catch { caught += 1; }
        \\try { ++foo(); } catch { caught += 1; }
        \\try { for (foo() in {a: 1}); } catch { caught += 1; }
        \\
        \\calls * 10 + caught;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 55 } },
        .expected_ir = null,
        .expected_bc = null,
    },
}
