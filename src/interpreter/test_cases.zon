        \\ %31: [ 31..32 ]                       add %29, %30
        \\ %32: [ 32..32 ]                       set_binding @0 ("x"), %31
        \\ %33: [ 33..33 ]                       throw %28
        \\ %34: [ 34..39 ]                       label
        \\ %35: [ 35..37 ]                       get_binding @0 ("x")
