    // Destructuring assignment
    .{
        .source =
        \\const {a, ...rest} = {a: 1, b: 2, c: 3};
        \\const {rest: {b, c}} = {rest};
        \\const [d, e] = [4, 5];
        \\const {f = 6} = {f: undefined};
        \\const g = ({} = {g: 7}).g;
        \\
        \\const obj = {};
        \\const arr = [];
        \\({x: obj.a} = {x: 8});
        \\[obj.b, obj.c, arr[0] = 11] = [9, 10];
        \\
        \\a + b + c + d + e + f + g + obj.a + obj.b + obj.c + arr[0];
        \\
        ,
        .expected_result = .{ .value = .{ .number = 66 } },
