    // Template literal
    .{
        .source =
        \\var empty = ``;
        \\`${empty}a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       string @0 ("")
        \\  %1: [  1..1  ]                       set_binding @1 ("empty"), %0
        \\  %2: [  2..3  ]                       get_binding @1 ("empty")
        \\  %3: [  3..5  ]                       to_string %2
        \\  %4: [  4..5  ]                       string @2 ("a")
        \\  %5: [  5..8  ]                       add %3, %4
        \\  %6: [  6..7  ]                       string @3 ("b")
        \\  %7: [  7..8  ]                       to_string %6
        \\  %8: [  8..10 ]                       add %5, %7
        \\  %9: [  9..10 ]                       string @4 ("c")
        \\ %10: [ 10..11 ]                       add %8, %9
        \\ %11: [ 11..11 ]                       return %10
        \\
        \\Bytecode (test)
        \\   0: 0a 00 00 00 00 00 00             load_string r0, @0 ("")
        \\   7: 4a 01 00 00 00 00 00             set_binding @1 ("empty"), r0
        \\  14: 46 00 00 01 00 00 00             get_binding r0, @1 ("empty")
        \\  21: 1f 01 00 00 00                   to_string r1, r0
        \\  26: 0a 00 00 02 00 00 00             load_string r0, @2 ("a")
        \\  33: 28 02 00 01 00 00 00             add r2, r1, r0
        \\  40: 0a 00 00 03 00 00 00             load_string r0, @3 ("b")
        \\  47: 1f 01 00 00 00                   to_string r1, r0
        \\  52: 28 00 00 02 00 01 00             add r0, r2, r1
        \\  59: 0a 01 00 04 00 00 00             load_string r1, @4 ("c")
        \\  66: 28 02 00 00 00 01 00             add r2, r0, r1
        \\  73: 74 02 00                         return r2
        \\
        ,
    },

    // Tagged template
    .{
        .source =
        \\String.raw`a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..14 ]                       get_binding @0 ("String")
        \\  %1: [  1..14 ]                       get_property %0, @1 ("raw")
        \\  %2: [  2..12 ]                       array_create 2
        \\  %3: [  3..4  ]                       string @2 ("a")
        \\  %4: [  4..4  ]                       array_push %2, %3
        \\  %5: [  5..6  ]                       string @3 ("c")
        \\  %6: [  6..6  ]                       array_push %2, %5
        \\  %7: [  7..12 ]                       array_create 2
        \\  %8: [  8..9  ]                       string @2 ("a")
        \\  %9: [  9..9  ]                       array_push %7, %8
        \\ %10: [ 10..11 ]                       string @3 ("c")
        \\ %11: [ 11..11 ]                       array_push %7, %10
        \\ %12: [ 12..14 ]                       get_template_object %2, %7, 0
        \\ %13: [ 13..14 ]                       string @4 ("b")
        \\ %14: [ 14..15 ]                       call %1, %0, [%12, %13]
        \\ %15: [ 15..15 ]                       return %14
        \\
        \\Bytecode (test)
        \\   0: 46 00 00 00 00 00 00             get_binding r0, @0 ("String")
        \\   7: 47 01 00 00 00 01 00 00 00 00 00 get_property r1, r0, @1 ("raw"), @0
        \\  18: 0d 02 00 02 00 00 00             array_create r2, 2
        \\  25: 0a 03 00 02 00 00 00             load_string r3, @2 ("a")
        \\  32: 10 02 00 03 00 00 00 00 00       array_set r2, r3, 0
        \\  41: 0a 03 00 03 00 00 00             load_string r3, @3 ("c")
        \\  48: 10 02 00 03 00 01 00 00 00       array_set r2, r3, 1
        \\  57: 0d 03 00 02 00 00 00             array_create r3, 2
        \\  64: 0a 04 00 02 00 00 00             load_string r4, @2 ("a")
        \\  71: 10 03 00 04 00 00 00 00 00       array_set r3, r4, 0
        \\  80: 0a 04 00 03 00 00 00             load_string r4, @3 ("c")
        \\  87: 10 03 00 04 00 01 00 00 00       array_set r3, r4, 1
        \\  96: 68 04 00 02 00 03 00 00 00       get_template_object r4, r2, r3, 0
        \\ 105: 0a 02 00 04 00 00 00             load_string r2, @4 ("b")
        \\ 112: 61 03 00 01 00 00 00 04 00 02 00 call_property2 r3, r1, r0, r4, r2
        \\ 123: 74 03 00                         return r3
        \\
        ,
    },

    // Functions
    .{
        .source =
        \\var f = ({a}, b = 0, ...rest) => a + b + rest.length;
        \\f({a: 1}, 2, 3, 4);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       create_function @0
        \\  %1: [  1..1  ]                       set_binding @0 ("f"), %0
        \\  %2: [  2..9  ]                       get_binding @0 ("f")
        \\  %3: [  3..9  ]                       object_create
        \\  %4: [  4..5  ]                       one
        \\  %5: [  5..5  ]                       object_set %3, @1 ("a"), %4
        \\  %6: [  6..9  ]                       number 2
        \\  %7: [  7..9  ]                       number 3
        \\  %8: [  8..9  ]                       number 4
        \\  %9: [  9..10 ]                       call %2, none, [%3, %6, %7, %8]
        \\ %10: [ 10..10 ]                       return %9
        \\
        \\Bytecode (test)
        \\   0: 78 00 00 00 00                   create_function r0, @0
        \\   5: 4a 00 00 00 00 00 00             set_binding @0 ("f"), r0
        \\  12: 46 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\  19: 12 01 00                         object_create r1
        \\  22: 07 02 00 01                      load_number_i8 r2, 1
        \\  26: 13 01 00 01 00 00 00 02 00       object_set r1, @1 ("a"), r2
        \\  35: 07 02 00 02                      load_number_i8 r2, 2
        \\  39: 07 03 00 03                      load_number_i8 r3, 3
        \\  43: 07 04 00 04                      load_number_i8 r4, 4
        \\  47: 0d 06 00 00 00 00 00             array_create r6, 0
        \\  54: 0e 06 00 01 00                   array_push r6, r1
        \\  59: 0e 06 00 02 00                   array_push r6, r2
        \\  64: 0e 06 00 03 00                   array_push r6, r3
        \\  69: 0e 06 00 04 00                   array_push r6, r4
        \\  74: 5a 05 00 00 00 06 00             call r5, r0, r6
        \\  81: 74 05 00                         return r5
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       create_mutable_binding @0 ("a")
        \\  %2: [  2..2  ]                       create_mutable_binding @1 ("b")
        \\  %3: [  3..3  ]                       create_mutable_binding @2 ("rest")
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..7  ]                       get_property %5, @0 ("a")
        \\  %7: [  7..7  ]                       initialize_binding @0 ("a"), %6
        \\  %8: [  8..16 ]                       get_argument 1
        \\  %9: [  9..10 ]                       undefined
        \\ %10: [ 10..11 ]                       eq_strict %8, %9
        \\ %11: [ 11..11 ]                       br_cond %10, %12, %15
        \\ %12: [ 12..12 ]                       label
        \\ %13: [ 13..14 ]                       zero
        \\ %14: [ 14..14 ]                       br %17, %13
        \\ %15: [ 15..15 ]                       label
        \\ %16: [ 16..16 ]                       br %17, %8
        \\ %17: [ 17..18 ]                       label
        \\ %18: [ 18..18 ]                       initialize_binding @1 ("b"), %17
        \\ %19: [ 19..20 ]                       get_rest_arguments 2
        \\ %20: [ 20..20 ]                       initialize_binding @2 ("rest"), %19
        \\ %21: [ 21..21 ]                       push_var_scope
        \\ %22: [ 22..22 ]                       push_scope
        \\ %23: [ 23..25 ]                       get_binding @0 ("a")
        \\ %24: [ 24..25 ]                       get_binding @1 ("b")
        \\ %25: [ 25..28 ]                       add %23, %24
        \\ %26: [ 26..27 ]                       get_binding @2 ("rest")
        \\ %27: [ 27..28 ]                       get_property %26, @3 ("length")
        \\ %28: [ 28..29 ]                       add %25, %27
        \\ %29: [ 29..29 ]                       return %28
        \\ %30: [ 30..30 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 3e                               push_scope
        \\   1: 43 00 00 00 00                   create_mutable_binding @0 ("a")
        \\   6: 43 01 00 00 00                   create_mutable_binding @1 ("b")
        \\  11: 43 02 00 00 00                   create_mutable_binding @2 ("rest")
        \\  16: 7d 00 00 00 00                   get_argument r0, 0
        \\  21: 20 01 00 00 00                   to_object r1, r0
        \\  26: 47 00 00 01 00 00 00 00 00 00 00 get_property r0, r1, @0 ("a"), @0
        \\  37: 45 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  44: 7d 00 00 01 00                   get_argument r0, 1
        \\  49: 03 01 00                         load_undefined r1
        \\  52: 3c 02 00 00 00 01 00             eq_strict r2, r0, r1
        \\  59: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  66: 00 0e 00 00 00                   jump 14
        \\  71: 07 01 00 00                      load_number_i8 r1, 0
        \\  75: 0c 00 00 01 00                   move r0, r1
        \\  80: 00 00 00 00 00                   jump 0
        \\  85: 45 01 00 00 00 00 00             initialize_binding @1 ("b"), r0
        \\  92: 7e 00 00 02 00                   get_rest_arguments r0, 2
        \\  97: 45 02 00 00 00 00 00             initialize_binding @2 ("rest"), r0
        \\ 104: 3f                               push_var_scope
        \\ 105: 3e                               push_scope
        \\ 106: 46 00 00 00 00 00 00             get_binding r0, @0 ("a")
        \\ 113: 46 01 00 01 00 00 00             get_binding r1, @1 ("b")
        \\ 120: 28 02 00 00 00 01 00             add r2, r0, r1
        \\ 127: 46 00 00 02 00 00 00             get_binding r0, @2 ("rest")
        \\ 134: 47 01 00 00 00 03 00 00 00 01 00 get_property r1, r0, @3 ("length"), @1
        \\ 145: 28 00 00 02 00 01 00             add r0, r2, r1
        \\ 152: 74 00 00                         return r0
        \\
        ,
    },

    // Arguments object
    .{
        .source =
        \\function mapped(a) {
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\function unmapped(a) {
        \\  "use strict";
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\mapped(1) - unmapped(1);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 98 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..2  ]                       get_binding @0 ("mapped")
        \\  %1: [  1..2  ]                       one
        \\  %2: [  2..6  ]                       call %0, none, [%1]
        \\  %3: [  3..5  ]                       get_binding @1 ("unmapped")
        \\  %4: [  4..5  ]                       one
        \\  %5: [  5..6  ]                       call %3, none, [%4]
        \\  %6: [  6..7  ]                       sub %2, %5
        \\  %7: [  7..7  ]                       return %6
        \\
        \\Bytecode (test)
        \\   0: 46 00 00 00 00 00 00             get_binding r0, @0 ("mapped")
        \\   7: 07 01 00 01                      load_number_i8 r1, 1
        \\  11: 5c 02 00 00 00 01 00             call1 r2, r0, r1
        \\  18: 46 00 00 01 00 00 00             get_binding r0, @1 ("unmapped")
        \\  25: 07 01 00 01                      load_number_i8 r1, 1
        \\  29: 5c 03 00 00 00 01 00             call1 r3, r0, r1
        \\  36: 29 00 00 02 00 03 00             sub r0, r2, r3
        \\  43: 74 00 00                         return r0
        \\
        \\IR (mapped)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("a")
        \\  %1: [  1..3  ]                       create_mapped_arguments_object
        \\  %2: [  2..2  ]                       create_mutable_binding @1 ("arguments")
        \\  %3: [  3..3  ]                       initialize_binding @1 ("arguments"), %1
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ]                       push_scope
        \\  %7: [  7..8  ]                       number 99
        \\  %8: [  8..8  ]                       set_binding @0 ("a"), %7
        \\  %9: [  9..10 ]                       get_binding @1 ("arguments")
        \\ %10: [ 10..11 ]                       get_property_indexed %9, 0
        \\ %11: [ 11..11 ]                       return %10
        \\ %12: [ 12..12 ] dead                  return none
        \\
        \\Bytecode (mapped)
        \\   0: 43 00 00 00 00                   create_mutable_binding @0 ("a")
        \\   5: 7c 00 00                         create_mapped_arguments_object r0
        \\   8: 43 01 00 00 00                   create_mutable_binding @1 ("arguments")
        \\  13: 45 01 00 00 00 00 00             initialize_binding @1 ("arguments"), r0
        \\  20: 7d 00 00 00 00                   get_argument r0, 0
        \\  25: 45 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  32: 3e                               push_scope
        \\  33: 07 00 00 63                      load_number_i8 r0, 99
        \\  37: 4a 00 00 00 00 00 00             set_binding @0 ("a"), r0
        \\  44: 46 00 00 01 00 00 00             get_binding r0, @1 ("arguments")
        \\  51: 49 01 00 00 00 00 00 00 00       get_property_indexed r1, r0, 0
        \\  60: 74 01 00                         return r1
        \\
        \\IR (unmapped)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("a")
        \\  %1: [  1..3  ]                       create_unmapped_arguments_object
        \\  %2: [  2..2  ]                       create_immutable_binding @1 ("arguments")
        \\  %3: [  3..3  ]                       initialize_binding @1 ("arguments"), %1
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ] dead                  string @2 ("use strict")
        \\  %7: [  7..8  ]                       number 99
        \\  %8: [  8..8  ]                       set_binding_strict @0 ("a"), %7
        \\  %9: [  9..10 ]                       get_binding @1 ("arguments")
        \\ %10: [ 10..11 ]                       get_property_indexed %9, 0
        \\ %11: [ 11..11 ]                       return %10
        \\ %12: [ 12..12 ] dead                  return none
        \\
        \\Bytecode (unmapped)
        \\   0: 43 00 00 00 00                   create_mutable_binding @0 ("a")
        \\   5: 7b 00 00                         create_unmapped_arguments_object r0
        \\   8: 44 01 00 00 00                   create_immutable_binding @1 ("arguments")
        \\  13: 45 01 00 00 00 00 00             initialize_binding @1 ("arguments"), r0
        \\  20: 7d 00 00 00 00                   get_argument r0, 0
        \\  25: 45 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  32: 07 00 00 63                      load_number_i8 r0, 99
        \\  36: 4b 00 00 00 00 00 00             set_binding_strict @0 ("a"), r0
        \\  43: 46 00 00 01 00 00 00             get_binding r0, @1 ("arguments")
        \\  50: 49 01 00 00 00 00 00 00 00       get_property_indexed r1, r0, 0
        \\  59: 74 01 00                         return r1
        \\
        ,
    },

    // Getter/setter
    .{
        .source =
        \\var o = {
        \\  get x() { return this._x; },
        \\  set x(v) { this._x = v; },
        \\};
        \\o.x = 42;
        \\o.x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 42 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..7  ]                       object_create
        \\  %1: [  1..2  ]                       create_function @0
        \\  %2: [  2..3  ]                       getter %1
        \\  %3: [  3..3  ]                       object_set %0, @0 ("x"), %2
        \\  %4: [  4..5  ]                       create_function @1
        \\  %5: [  5..6  ]                       setter %4
        \\  %6: [  6..6  ]                       object_set %0, @0 ("x"), %5
        \\  %7: [  7..7  ]                       set_binding @3 ("o"), %0
        \\  %8: [  8..10 ]                       get_binding @3 ("o")
        \\  %9: [  9..10 ]                       number 42
        \\ %10: [ 10..10 ]                       set_property %8, @0 ("x"), %9
        \\ %11: [ 11..12 ]                       get_binding @3 ("o")
        \\ %12: [ 12..13 ]                       get_property %11, @0 ("x")
        \\ %13: [ 13..13 ]                       return %12
        \\
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 78 01 00 00 00                   create_function r1, @0
        \\   8: 0c 02 00 01 00                   move r2, r1
        \\  13: 7a 02 00 00 00                   set_home_object r2, r0
        \\  18: 15 00 00 00 00 00 00 02 00       object_set_getter r0, @0 ("x"), r2
        \\  27: 78 01 00 01 00                   create_function r1, @1
        \\  32: 0c 02 00 01 00                   move r2, r1
        \\  37: 7a 02 00 00 00                   set_home_object r2, r0
        \\  42: 17 00 00 00 00 00 00 02 00       object_set_setter r0, @0 ("x"), r2
        \\  51: 4a 03 00 00 00 00 00             set_binding @3 ("o"), r0
        \\  58: 46 00 00 03 00 00 00             get_binding r0, @3 ("o")
        \\  65: 07 01 00 2a                      load_number_i8 r1, 42
        \\  69: 4c 00 00 01 00 00 00 00 00 00 00 set_property r0, r1, @0 ("x"), @0
        \\  80: 46 00 00 03 00 00 00             get_binding r0, @3 ("o")
        \\  87: 47 01 00 00 00 00 00 00 00 01 00 get_property r1, r0, @0 ("x"), @1
        \\  98: 74 01 00                         return r1
        \\
        \\IR (get x)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..2  ]                       this
        \\  %2: [  2..3  ]                       get_property %1, @0 ("_x")
        \\  %3: [  3..3  ]                       return %2
        \\  %4: [  4..4  ] dead                  return none
        \\
        \\Bytecode (get x)
        \\   0: 3e                               push_scope
        \\   1: 1c 00 00                         resolve_this_binding r0
        \\   4: 47 01 00 00 00 00 00 00 00 00 00 get_property r1, r0, @0 ("_x"), @0
        \\  15: 74 01 00                         return r1
        \\
        \\IR (set x)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("v")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("v"), %1
        \\  %3: [  3..3  ]                       push_scope
        \\  %4: [  4..6  ]                       this
        \\  %5: [  5..6  ]                       get_binding @0 ("v")
        \\  %6: [  6..6  ]                       set_property %4, @1 ("_x"), %5
        \\  %7: [  7..7  ]                       return none
        \\
        \\Bytecode (set x)
        \\   0: 43 00 00 00 00                   create_mutable_binding @0 ("v")
        \\   5: 7d 00 00 00 00                   get_argument r0, 0
        \\  10: 45 00 00 00 00 00 00             initialize_binding @0 ("v"), r0
        \\  17: 3e                               push_scope
        \\  18: 1c 00 00                         resolve_this_binding r0
        \\  21: 46 01 00 00 00 00 00             get_binding r1, @0 ("v")
        \\  28: 4c 00 00 01 00 01 00 00 00 00 00 set_property r0, r1, @1 ("_x"), @0
        \\  39: 74 ff ff                         return
        \\
        ,
    },

    // Generator
    .{
        .source =
        \\function* h() {
        \\  yield 4;
        \\  yield 5;
        \\}
        \\function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\  yield* h();
        \\}
        \\function f() {
        \\  var gen = g();
        \\  var sum = 0;
        \\  while (true) {
        \\    var result = gen.next();
        \\    if (result.done) break;
        \\    sum += result.value;
        \\  }
        \\  return sum;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 15 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       get_binding @0 ("f")
        \\  %1: [  1..2  ]                       call %0, none, []
        \\  %2: [  2..2  ]                       return %1
        \\
        \\Bytecode (test)
        \\   0: 46 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\   7: 5b 01 00 00 00                   call0 r1, r0
        \\  12: 74 01 00                         return r1
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       create_var_binding @0 ("gen")
        \\  %1: [  1..1  ]                       create_var_binding @1 ("sum")
        \\  %2: [  2..2  ]                       create_var_binding @2 ("result")
        \\  %3: [  3..3  ]                       push_scope
        \\  %4: [  4..5  ]                       get_binding @3 ("g")
        \\  %5: [  5..6  ]                       call %4, none, []
        \\  %6: [  6..6  ]                       set_binding @0 ("gen"), %5
        \\  %7: [  7..8  ]                       zero
        \\  %8: [  8..8  ]                       set_binding @1 ("sum"), %7
        \\  %9: [  9..35 ]                       undefined
        \\ %10: [ 10..10 ]                       br %11, %9
        \\ %11: [ 11..37 ]                       label
        \\ %12: [ 12..13 ]                       true
        \\ %13: [ 13..13 ]                       br_cond %12, %14, %36
        \\ %14: [ 14..14 ]                       label
        \\ %15: [ 15..17 ]                       get_binding @0 ("gen")
        \\ %16: [ 16..17 ]                       get_property %15, @4 ("next")
        \\ %17: [ 17..18 ]                       call %16, %15, []
        \\ %18: [ 18..18 ]                       set_binding @2 ("result"), %17
        \\ %19: [ 19..20 ]                       get_binding @2 ("result")
        \\ %20: [ 20..21 ]                       get_property %19, @5 ("done")
        \\ %21: [ 21..21 ]                       br_cond %20, %22, %26
        \\ %22: [ 22..22 ]                       label
        \\ %23: [ 23..23 ]                       br %38, %9
        \\ %24: [ 24..25 ] dead                  undefined
        \\ %25: [ 25..25 ] dead                  br %29, %24
        \\ %26: [ 26..26 ]                       label
        \\ %27: [ 27..28 ]                       undefined
        \\ %28: [ 28..28 ]                       br %29, %27
        \\ %29: [ 29..29 ]                       label
        \\ %30: [ 30..33 ]                       get_binding @1 ("sum")
        \\ %31: [ 31..32 ]                       get_binding @2 ("result")
        \\ %32: [ 32..33 ]                       get_property %31, @6 ("value")
        \\ %33: [ 33..34 ]                       add %30, %32
        \\ %34: [ 34..35 ]                       set_binding @1 ("sum"), %33
        \\ %35: [ 35..35 ]                       br %11, %34
        \\ %36: [ 36..36 ]                       label
        \\ %37: [ 37..37 ]                       br %38, %11
        \\ %38: [ 38..38 ]                       label
        \\ %39: [ 39..40 ]                       get_binding @1 ("sum")
        \\ %40: [ 40..40 ]                       return %39
        \\ %41: [ 41..41 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 42 00 00 00 00                   create_var_binding @0 ("gen")
        \\   5: 42 01 00 00 00                   create_var_binding @1 ("sum")
        \\  10: 42 02 00 00 00                   create_var_binding @2 ("result")
        \\  15: 3e                               push_scope
        \\  16: 46 00 00 03 00 00 00             get_binding r0, @3 ("g")
        \\  23: 5b 01 00 00 00                   call0 r1, r0
        \\  28: 4a 00 00 00 00 01 00             set_binding @0 ("gen"), r1
        \\  35: 07 00 00 00                      load_number_i8 r0, 0
        \\  39: 4a 01 00 00 00 00 00             set_binding @1 ("sum"), r0
        \\  46: 03 00 00                         load_undefined r0
        \\  49: 0c 01 00 00 00                   move r1, r0
        \\  54: 05 02 00                         load_true r2
        \\  57: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  64: 00 7c 00 00 00                   jump 124
        \\  69: 46 02 00 00 00 00 00             get_binding r2, @0 ("gen")
        \\  76: 47 03 00 02 00 04 00 00 00 00 00 get_property r3, r2, @4 ("next"), @0
        \\  87: 5f 04 00 03 00 02 00             call_property0 r4, r3, r2
        \\  94: 4a 02 00 00 00 04 00             set_binding @2 ("result"), r4
        \\ 101: 46 02 00 02 00 00 00             get_binding r2, @2 ("result")
        \\ 108: 47 03 00 02 00 05 00 00 00 01 00 get_property r3, r2, @5 ("done"), @1
        \\ 119: 01 03 00 05 00 00 00             jump_if_true r3, 5
        \\ 126: 00 05 00 00 00                   jump 5
        \\ 131: 00 39 00 00 00                   jump 57
        \\ 136: 03 02 00                         load_undefined r2
        \\ 139: 46 02 00 01 00 00 00             get_binding r2, @1 ("sum")
        \\ 146: 46 03 00 02 00 00 00             get_binding r3, @2 ("result")
        \\ 153: 47 04 00 03 00 06 00 00 00 02 00 get_property r4, r3, @6 ("value"), @2
        \\ 164: 28 03 00 02 00 04 00             add r3, r2, r4
        \\ 171: 4a 01 00 00 00 03 00             set_binding @1 ("sum"), r3
        \\ 178: 0c 02 00 03 00                   move r2, r3
        \\ 183: 0c 01 00 02 00                   move r1, r2
        \\ 188: 00 75 ff ff ff                   jump -139
        \\ 193: 46 00 00 01 00 00 00             get_binding r0, @1 ("sum")
        \\ 200: 74 00 00                         return r0
        \\
        \\IR (g)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       one
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 2
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..7  ]                       number 3
        \\  %7: [  7..7  ]                       yield %6
        \\  %8: [  8..9  ]                       get_binding @0 ("h")
        \\  %9: [  9..10 ]                       call %8, none, []
        \\ %10: [ 10..11 ]                       get_iterator %9
        \\ %11: [ 11..11 ]                       yield_star %10
        \\ %12: [ 12..12 ]                       return none
        \\
        \\Bytecode (g)
        \\   0: 3e                               push_scope
        \\   1: 76 ff ff ff ff                   yield
        \\   6: 07 00 00 01                      load_number_i8 r0, 1
        \\  10: 76 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 02                      load_number_i8 r0, 2
        \\  19: 76 01 00 00 00                   yield r1, r0
        \\  24: 07 00 00 03                      load_number_i8 r0, 3
        \\  28: 76 01 00 00 00                   yield r1, r0
        \\  33: 46 00 00 00 00 00 00             get_binding r0, @0 ("h")
        \\  40: 5b 01 00 00 00                   call0 r1, r0
        \\  45: 69 00 00 01 00                   get_iterator r0, r1
        \\  50: 03 01 00                         load_undefined r1
        \\  53: 77 01 00 00 00                   yield_star r1, r0
        \\  58: 74 ff ff                         return
        \\
        \\IR (h)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       number 4
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 5
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..6  ]                       return none
        \\
        \\Bytecode (h)
        \\   0: 3e                               push_scope
        \\   1: 76 ff ff ff ff                   yield
        \\   6: 07 00 00 04                      load_number_i8 r0, 4
        \\  10: 76 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 05                      load_number_i8 r0, 5
        \\  19: 76 01 00 00 00                   yield r1, r0
        \\  24: 74 ff ff                         return
        \\
        ,
    },

    // Async Generator
    .{
        .source =
        \\async function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\}
        \\async function f() {
        \\  var gen = g();
        \\  var a = await gen.next();
        \\  var b = await gen.next();
        \\  var c = await gen.next();
        \\  return a.value + b.value + c.value;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .promise = .{ .fulfilled = .{ .number = 6 } } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       get_binding @0 ("f")
        \\  %1: [  1..2  ]                       call %0, none, []
        \\  %2: [  2..2  ]                       return %1
        \\
        \\Bytecode (test)
        \\   0: 46 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\   7: 5b 01 00 00 00                   call0 r1, r0
        \\  12: 74 01 00                         return r1
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       create_var_binding @0 ("gen")
        \\  %1: [  1..1  ]                       create_var_binding @1 ("a")
        \\  %2: [  2..2  ]                       create_var_binding @2 ("b")
        \\  %3: [  3..3  ]                       create_var_binding @3 ("c")
        \\  %4: [  4..4  ]                       push_scope
        \\  %5: [  5..6  ]                       get_binding @4 ("g")
        \\  %6: [  6..7  ]                       call %5, none, []
        \\  %7: [  7..7  ]                       set_binding @0 ("gen"), %6
