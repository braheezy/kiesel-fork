        \\  94: 04 01 00                         load_null r1
        \\  97: 3a 02 00 00 00 01 00             eq r2, r0, r1
        \\ 104: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 111: 00 40 00 00 00                   jump 64
        \\ 116: 46 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\ 123: 47 01 00 00 00 00 00 00 00 02 00 get_property r1, r0, @0 ("a"), @2
        \\ 134: 04 00 00                         load_null r0
