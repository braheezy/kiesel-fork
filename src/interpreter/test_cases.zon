        \\ 137: 0c 00 00 01 00                   move r0, r1
        \\ 142: 00 b3 ff ff ff                   jump -77
        \\ 147: 49 00 00 00 00 00 00             get_binding r0, @0 ("sum")
        \\ 154: 78 00 00                         return r0
        \\
        ,
    },

    // For-in/of with member expression LHS
    .{
        .source =
        \\var x = {};
        \\for (x.last in {a: 1, b: 2, c: 3});
        \\x.last;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "c" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       object_create
        \\  %1: [  1..1  ]                       set_binding @0 ("x"), %0
        \\  %2: [  2..14 ]                       object_create
        \\  %3: [  3..4  ]                       number 1
        \\  %4: [  4..4  ]                       object_set %2, @1 ("a"), %3
        \\  %5: [  5..6  ]                       number 2
        \\  %6: [  6..6  ]                       object_set %2, @2 ("b"), %5
        \\  %7: [  7..8  ]                       number 3
        \\  %8: [  8..8  ]                       object_set %2, @3 ("c"), %7
        \\  %9: [  9..28 ]                       undefined
        \\ %10: [ 10..11 ]                       null
        \\ %11: [ 11..12 ]                       eq %2, %10
        \\ %12: [ 12..12 ]                       br_cond %11, %27, %13
        \\ %13: [ 13..13 ]                       label
        \\ %14: [ 14..24 ]                       get_for_in_iterator %2
        \\ %15: [ 15..15 ]                       br %16, %9
        \\ %16: [ 16..26 ]                       label
        \\ %17: [ 17..23 ]                       iterator_step_value %14
        \\ %18: [ 18..19 ]                       iterator_is_done %14
        \\ %19: [ 19..20 ]                       logical_not %18
        \\ %20: [ 20..20 ]                       br_cond %19, %21, %25
        \\ %21: [ 21..21 ]                       label
        \\ %22: [ 22..23 ]                       get_binding @0 ("x")
        \\ %23: [ 23..23 ]                       set_property %22, @4 ("last"), %17
        \\ %24: [ 24..24 ]                       br %16, %9
        \\ %25: [ 25..25 ]                       label
        \\ %26: [ 26..26 ]                       br %29, %16
        \\ %27: [ 27..27 ]                       label
        \\ %28: [ 28..28 ]                       br %29, %9
        \\ %29: [ 29..29 ]                       label
        \\ %30: [ 30..31 ]                       get_binding @0 ("x")
        \\ %31: [ 31..32 ]                       get_property %30, @4 ("last")
        \\ %32: [ 32..32 ]                       return %31
        \\
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 4e 00 00 00 00 00 00             set_binding @0 ("x"), r0
        \\  10: 12 00 00                         object_create r0
        \\  13: 07 01 00 01                      load_number_i8 r1, 1
        \\  17: 13 00 00 01 00 00 00 01 00       object_set r0, @1 ("a"), r1
        \\  26: 07 01 00 02                      load_number_i8 r1, 2
        \\  30: 13 00 00 02 00 00 00 01 00       object_set r0, @2 ("b"), r1
        \\  39: 07 01 00 03                      load_number_i8 r1, 3
        \\  43: 13 00 00 03 00 00 00 01 00       object_set r0, @3 ("c"), r1
        \\  52: 03 01 00                         load_undefined r1
        \\  55: 04 02 00                         load_null r2
        \\  58: 3c 03 00 00 00 02 00             eq r3, r0, r2
        \\  65: 01 03 00 05 00 00 00             jump_if_true r3, 5
        \\  72: 00 05 00 00 00                   jump 5
        \\  77: 00 41 00 00 00                   jump 65
        \\  82: 6f 02 00 00 00                   get_for_in_iterator r2, r0
        \\  87: 0c 00 00 01 00                   move r0, r1
        \\  92: 71 03 00 02 00                   iterator_step_value r3, r2
        \\  97: 74 04 00 02 00                   iterator_is_done r4, r2
        \\ 102: 26 05 00 04 00                   logical_not r5, r4
        \\ 107: 01 05 00 05 00 00 00             jump_if_true r5, 5
        \\ 114: 00 1c 00 00 00                   jump 28
        \\ 119: 49 04 00 00 00 00 00             get_binding r4, @0 ("x")
        \\ 126: 50 04 00 03 00 04 00 00 00 00 00 set_property r4, r3, @4 ("last"), @0
        \\ 137: 0c 00 00 01 00                   move r0, r1
        \\ 142: 00 c9 ff ff ff                   jump -55
        \\ 147: 49 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\ 154: 4a 01 00 00 00 04 00 00 00 00 00 get_property r1, r0, @4 ("last"), @0
        \\ 165: 78 01 00                         return r1
        \\
        ,
    },

    // With statement
    .{
        .source =
        \\var o = {x: 1};
        \\with (o) { x }
        \\
        ,
        .expected_result = .{ .value = .{ .number = 1 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..3  ]                       object_create
        \\  %1: [  1..2  ]                       number 1
        \\  %2: [  2..2  ]                       object_set %0, @0 ("x"), %1
        \\  %3: [  3..3  ]                       set_binding @1 ("o"), %0
        \\  %4: [  4..5  ]                       get_binding @1 ("o")
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..6  ]                       push_with_scope %5
        \\  %7: [  7..9  ]                       get_binding @0 ("x")
        \\  %8: [  8..8  ]                       pop_scope
        \\  %9: [  9..9  ]                       return %7
        \\
        \\Bytecode (test)
        \\   0: 12 00 00                         object_create r0
        \\   3: 07 01 00 01                      load_number_i8 r1, 1
        \\   7: 13 00 00 00 00 00 00 01 00       object_set r0, @0 ("x"), r1
        \\  16: 4e 01 00 00 00 00 00             set_binding @1 ("o"), r0
        \\  23: 49 00 00 01 00 00 00             get_binding r0, @1 ("o")
        \\  30: 21 01 00 00 00                   to_object r1, r0
        \\  35: 42 01 00                         push_with_scope r1
        \\  38: 49 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  45: 43                               pop_scope
        \\  46: 78 00 00                         return r0
        \\
        ,
    },

    // Optional expression
    .{
        .source =
