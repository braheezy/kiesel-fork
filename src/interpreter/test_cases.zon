    // Try statement
    .{
        .source =
        \\try {} catch {}
        \\
        ,
        .expected_result = .{ .value = .undefined },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..4  ]                       label
        \\  %1: [  1..2  ]                       undefined
        \\  %2: [  2..2  ]                       br %7, %1
        \\  %3: [  3..4  ]                       label
        \\  %4: [  4..4  ]                       exception_handler %0, %3, %3
        \\  %5: [  5..6  ]                       undefined
