    // For-in/of statement
    .{
        .source =
        \\var sum = 0;
        \\for (var x of [1, 2, 3]) {
        \\  sum = sum + x;
        \\}
        \\sum;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       zero
        \\  %1: [  1..1  ]                       set_binding @0 ("sum"), %0
        \\  %2: [  2..5  ]                       one
        \\  %3: [  3..5  ]                       number 2
        \\  %4: [  4..5  ]                       number 3
        \\  %5: [  5..7  ]                       array [%2, %3, %4]
        \\  %6: [  6..8  ]                       undefined
        \\  %7: [  7..19 ]                       get_iterator %5
        \\  %8: [  8..8  ]                       br %9, %6
        \\  %9: [  9..21 ]                       label
        \\ %10: [ 10..14 ]                       iterator_step_value %7
        \\ %11: [ 11..12 ]                       iterator_is_done %7
        \\ %12: [ 12..12 ]                       br_cond %11, %20, %13
        \\ %13: [ 13..13 ]                       label
        \\ %14: [ 14..14 ]                       set_binding @1 ("x"), %10
        \\ %15: [ 15..17 ]                       get_binding @0 ("sum")
        \\ %16: [ 16..17 ]                       get_binding @1 ("x")
        \\ %17: [ 17..18 ]                       add %15, %16
        \\ %18: [ 18..19 ]                       set_binding @0 ("sum"), %17
        \\ %19: [ 19..19 ]                       br %9, %18
        \\ %20: [ 20..20 ]                       label
        \\ %21: [ 21..21 ]                       br %22, %9
        \\ %22: [ 22..22 ]                       label
        \\ %23: [ 23..24 ]                       get_binding @0 ("sum")
        \\ %24: [ 24..24 ]                       return %23
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 00 00 00 00             load_number_i32 r0, 0
        \\   7: 45 00 00 00 00 00 00             set_binding @0 ("sum"), r0
        \\  14: 0b 01 00 00 00                   move r1, r0
        \\  19: 07 00 00 01 00 00 00             load_number_i32 r0, 1
        \\  26: 07 01 00 02 00 00 00             load_number_i32 r1, 2
        \\  33: 07 02 00 03 00 00 00             load_number_i32 r2, 3
        \\  40: 0c 03 00 03 00 00 00             array_create r3, 3
        \\  47: 0f 03 00 00 00 00 00 00 00       array_set r3, r0, 0
        \\  56: 0f 03 00 01 00 01 00 00 00       array_set r3, r1, 1
        \\  65: 0f 03 00 02 00 02 00 00 00       array_set r3, r2, 2
        \\  74: 03 00 00                         load_undefined r0
        \\  77: 84 01 00 03 00                   get_iterator r1, r3
        \\  82: 88 02 00 01 00                   iterator_step_value r2, r1
        \\  87: 8b 03 00 01 00                   iterator_is_done r3, r1
        \\  92: 01 03 00 05 00 00 00             jump_if_true r3, 5
        \\  99: 00 0a 00 00 00                   jump 10
        \\ 104: 41 00 00 00 00 00 00             get_binding r0, @0 ("sum")
        \\ 111: 8f 00 00                         return r0
        \\ 114: 45 01 00 00 00 02 00             set_binding @1 ("x"), r2
        \\ 121: 0b 03 00 02 00                   move r3, r2
        \\ 126: 41 02 00 00 00 00 00             get_binding r2, @0 ("sum")
        \\ 133: 41 03 00 01 00 00 00             get_binding r3, @1 ("x")
        \\ 140: 24 04 00 02 00 03 00             add r4, r2, r3
        \\ 147: 45 00 00 00 00 04 00             set_binding @0 ("sum"), r4
        \\ 154: 0b 02 00 04 00                   move r2, r4
        \\ 159: 0b 00 00 02 00                   move r0, r2
        \\ 164: 00 a9 ff ff ff                   jump -87
        \\
        ,
    },

    // For-in/of with member expression LHS
    .{
        .source =
        \\var x = {};
        \\for (x.last in {a: 1, b: 2, c: 3});
        \\x.last;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "c" } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // With statement
    .{
        .source =
        \\var o = {x: 1};
        \\with (o) { x }
        \\
        ,
        .expected_result = .{ .value = .{ .number = 1 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..2  ]                       string @0 ("x")
        \\  %1: [  1..2  ]                       one
        \\  %2: [  2..3  ]                       object {%0: %1}
        \\  %3: [  3..3  ]                       set_binding @1 ("o"), %2
        \\  %4: [  4..5  ]                       get_binding @1 ("o")
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..6  ]                       push_with_scope %5
        \\  %7: [  7..9  ]                       get_binding @0 ("x")
        \\  %8: [  8..8  ]                       pop_scope
        \\  %9: [  9..9  ]                       return %7
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 09 00 00 00 00 00 00             load_string r0, @0 ("x")
        \\   7: 07 01 00 01 00 00 00             load_number_i32 r1, 1
        \\  14: 11 02 00                         object_create r2
        \\  17: 12 02 00 00 00 00 00 01 00       object_set r2, @0 ("x"), r1
        \\  26: 45 01 00 00 00 02 00             set_binding @1 ("o"), r2
        \\  33: 0b 00 00 02 00                   move r0, r2
        \\  38: 41 00 00 01 00 00 00             get_binding r0, @1 ("o")
        \\  45: 1e 01 00 00 00                   to_object r1, r0
        \\  50: 3c 01 00                         push_with_scope r1
        \\  53: 41 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  60: 3d                               pop_scope
        \\  61: 8f 00 00                         return r0
        \\
        ,
    },

    // Optional expression
    .{
        .source =
        \\var o = {a: {b: 123}};
        \\o.x?.y ?? o.a?.["b"];
        \\
        ,
        .expected_result = .{ .value = .{ .number = 123 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..4  ]                       string @0 ("a")
        \\  %1: [  1..3  ]                       string @1 ("b")
        \\  %2: [  2..3  ]                       number 123
        \\  %3: [  3..4  ]                       object {%1: %2}
        \\  %4: [  4..5  ]                       object {%0: %3}
        \\  %5: [  5..5  ]                       set_binding @2 ("o"), %4
        \\  %6: [  6..7  ]                       get_binding @2 ("o")
        \\  %7: [  7..12 ]                       get_property %6, @3 ("x")
        \\  %8: [  8..9  ]                       null
        \\  %9: [  9..10 ]                       eq %7, %8
        \\ %10: [ 10..10 ]                       br_cond %9, %14, %11
        \\ %11: [ 11..11 ]                       label
        \\ %12: [ 12..13 ]                       get_property %7, @4 ("y")
        \\ %13: [ 13..13 ]                       br %17, %12
        \\ %14: [ 14..14 ]                       label
        \\ %15: [ 15..16 ]                       undefined
        \\ %16: [ 16..16 ]                       br %17, %15
        \\ %17: [ 17..22 ]                       label
        \\ %18: [ 18..19 ]                       null
        \\ %19: [ 19..20 ]                       eq %17, %18
        \\ %20: [ 20..20 ]                       br_cond %19, %23, %21
        \\ %21: [ 21..21 ]                       label
        \\ %22: [ 22..22 ]                       br %37, %17
        \\ %23: [ 23..23 ]                       label
        \\ %24: [ 24..25 ]                       get_binding @2 ("o")
        \\ %25: [ 25..30 ]                       get_property %24, @0 ("a")
        \\ %26: [ 26..27 ]                       null
        \\ %27: [ 27..28 ]                       eq %25, %26
        \\ %28: [ 28..28 ]                       br_cond %27, %32, %29
        \\ %29: [ 29..29 ]                       label
        \\ %30: [ 30..31 ]                       get_property %25, @1 ("b")
        \\ %31: [ 31..31 ]                       br %35, %30
        \\ %32: [ 32..32 ]                       label
        \\ %33: [ 33..34 ]                       undefined
        \\ %34: [ 34..34 ]                       br %35, %33
        \\ %35: [ 35..36 ]                       label
        \\ %36: [ 36..36 ]                       br %37, %35
        \\ %37: [ 37..38 ]                       label
        \\ %38: [ 38..38 ]                       return %37
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 09 00 00 00 00 00 00             load_string r0, @0 ("a")
        \\   7: 09 01 00 01 00 00 00             load_string r1, @1 ("b")
        \\  14: 07 02 00 7b 00 00 00             load_number_i32 r2, 123
        \\  21: 11 03 00                         object_create r3
        \\  24: 12 03 00 01 00 00 00 02 00       object_set r3, @1 ("b"), r2
        \\  33: 11 01 00                         object_create r1
        \\  36: 12 01 00 00 00 00 00 03 00       object_set r1, @0 ("a"), r3
        \\  45: 45 02 00 00 00 01 00             set_binding @2 ("o"), r1
        \\  52: 0b 00 00 01 00                   move r0, r1
        \\  57: 41 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\  64: 42 01 00 00 00 03 00 00 00       get_property r1, r0, @3 ("x")
        \\  73: 04 00 00                         load_null r0
        \\  76: 36 02 00 01 00 00 00             eq r2, r1, r0
        \\  83: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  90: 00 08 00 00 00                   jump 8
        \\  95: 03 00 00                         load_undefined r0
        \\  98: 00 09 00 00 00                   jump 9
        \\ 103: 42 00 00 01 00 04 00 00 00       get_property r0, r1, @4 ("y")
        \\ 112: 04 01 00                         load_null r1
        \\ 115: 36 02 00 00 00 01 00             eq r2, r0, r1
        \\ 122: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 129: 00 3c 00 00 00                   jump 60
        \\ 134: 41 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\ 141: 42 01 00 00 00 00 00 00 00       get_property r1, r0, @0 ("a")
        \\ 150: 04 00 00                         load_null r0
        \\ 153: 36 02 00 01 00 00 00             eq r2, r1, r0
        \\ 160: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 167: 00 08 00 00 00                   jump 8
        \\ 172: 03 00 00                         load_undefined r0
        \\ 175: 00 09 00 00 00                   jump 9
        \\ 180: 42 00 00 01 00 01 00 00 00       get_property r0, r1, @1 ("b")
        \\ 189: 00 00 00 00 00                   jump 0
        \\ 194: 8f 00 00                         return r0
        \\
        ,
    },

    // Tagged template
    .{
        .source =
        \\String.raw`a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..10 ]                       get_binding @0 ("String")
        \\  %1: [  1..10 ]                       get_property %0, @1 ("raw")
        \\  %2: [  2..4  ]                       string @2 ("a")
        \\  %3: [  3..4  ]                       string @3 ("c")
        \\  %4: [  4..8  ]                       array [%2, %3]
        \\  %5: [  5..7  ]                       string @2 ("a")
        \\  %6: [  6..7  ]                       string @3 ("c")
        \\  %7: [  7..8  ]                       array [%5, %6]
        \\  %8: [  8..10 ]                       get_template_object %4, %7, 0
        \\  %9: [  9..10 ]                       string @4 ("b")
        \\ %10: [ 10..11 ]                       call %1, %0, [%8, %9]
        \\ %11: [ 11..11 ]                       return %10
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 41 00 00 00 00 00 00             get_binding r0, @0 ("String")
        \\   7: 42 01 00 00 00 01 00 00 00       get_property r1, r0, @1 ("raw")
        \\  16: 09 02 00 02 00 00 00             load_string r2, @2 ("a")
        \\  23: 09 03 00 03 00 00 00             load_string r3, @3 ("c")
        \\  30: 0c 04 00 02 00 00 00             array_create r4, 2
        \\  37: 0f 04 00 02 00 00 00 00 00       array_set r4, r2, 0
        \\  46: 0f 04 00 03 00 01 00 00 00       array_set r4, r3, 1
        \\  55: 09 02 00 02 00 00 00             load_string r2, @2 ("a")
        \\  62: 09 03 00 03 00 00 00             load_string r3, @3 ("c")
        \\  69: 0c 05 00 02 00 00 00             array_create r5, 2
        \\  76: 0f 05 00 02 00 00 00 00 00       array_set r5, r2, 0
        \\  85: 0f 05 00 03 00 01 00 00 00       array_set r5, r3, 1
        \\  94: 83 02 00 04 00 05 00 00 00       get_template_object r2, r4, r5, 0
        \\ 103: 09 03 00 04 00 00 00             load_string r3, @4 ("b")
        \\ 110: 7c 04 00 01 00 00 00 02 00 03 00 call_property2 r4, r1, r0, r2, r3
        \\ 121: 8f 04 00                         return r4
        \\
        ,
    },

    // Functions
    .{
        .source =
        \\var f = ({a}, b = 0, ...rest) => a + b + rest.length;
        \\f({a: 1}, 2, 3, 4);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Arguments object
    .{
        .source =
        \\function mapped(a) {
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\function unmapped(a) {
        \\  "use strict";
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\mapped(1) - unmapped(1);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 98 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Getter/setter
    .{
        .source =
        \\var o = {
        \\  get x() { return this._x; },
        \\  set x(v) { this._x = v; },
        \\};
        \\o.x = 42;
        \\o.x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 42 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Generator
    .{
        .source =
        \\function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\}
        \\function f() {
        \\  var gen = g();
        \\  var a = gen.next();
        \\  var b = gen.next();
        \\  var c = gen.next();
        \\  return a.value + b.value + c.value;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Async Generator
    .{
        .source =
        \\async function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\}
        \\async function f() {
        \\  var gen = g();
        \\  var a = await gen.next();
        \\  var b = await gen.next();
        \\  var c = await gen.next();
        \\  return a.value + b.value + c.value;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .promise = .{ .fulfilled = .{ .number = 6 } } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Classes
    .{
        .source =
        \\class Foo {
        \\  #x;
        \\  constructor(x) { this.#x = x; }
        \\  getX() { return this.#x; }
        \\}
        \\class Bar extends Foo {
        \\  constructor(x) { super(x); }
        \\  getX() { return super.getX() + 1; }
        \\}
        \\var bar = new Bar(42);
        \\bar.getX();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 43 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Call expression LHS
    .{
        .source =
        \\var calls = 0;
        \\var caught = 0;
        \\function foo() { calls += 1; }
        \\
        \\try { foo() = 1; } catch { caught += 1; }
        \\try { foo() += 1; } catch { caught += 1; }
        \\try { foo()++; } catch { caught += 1; }
        \\try { ++foo(); } catch { caught += 1; }
        \\try { for (foo() in {a: 1}); } catch { caught += 1; }
        \\
        \\calls * 10 + caught;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 55 } },
        .expected_ir = null,
        .expected_bc = null,
    },
}
