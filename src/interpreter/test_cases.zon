    // For-of with destructuring
    .{
        .source =
        \\var result = 0;
        \\for (const [a, b] of [[1, 2], [3, 4]]) {
        \\  result += a + b;
        \\}
        \\for (var {d, c} of [{c: 5, d: 6}]) {
        \\  result += c + d;
        \\}
        \\for ([e, f] of [[7, 8]]) {
        \\  result += e + f;
        \\}
        \\result;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 36 } },
        .expected_output =
