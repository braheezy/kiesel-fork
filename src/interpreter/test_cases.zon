.{
    // Empty script
    .{
        .source = "",
        .expected_result = .{ .value = null },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..0  ]                       return none
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 91 ff ff                         return
        \\
        ,
    },

    // Simple expression statement
    .{
        .source =
        \\42;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 42 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       number 42
        \\  %1: [  1..1  ]                       return %0
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 2a                      load_number_i8 r0, 42
        \\   4: 91 00 00                         return r0
        \\
        ,
    },

    // Dead code elimination
    .{
        .source =
        \\1;
        \\while (true) {
        \\  2;
        \\  break;
        \\  3;
        \\}
        \\4;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 4 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..0  ] dead                  one
        \\  %1: [  1..2  ]                       undefined
        \\  %2: [  2..2  ]                       br %3, %1
        \\  %3: [  3..12 ]                       label
        \\  %4: [  4..5  ]                       true
        \\  %5: [  5..5  ]                       br_cond %4, %6, %11
        \\  %6: [  6..6  ]                       label
        \\  %7: [  7..8  ]                       number 2
        \\  %8: [  8..8  ]                       br %13, %7
        \\  %9: [  9..10 ] dead                  number 3
        \\ %10: [ 10..10 ] dead                  br %3, %9
        \\ %11: [ 11..11 ]                       label
        \\ %12: [ 12..12 ]                       br %13, %3
        \\ %13: [ 13..13 ]                       label
        \\ %14: [ 14..15 ]                       number 4
        \\ %15: [ 15..15 ]                       return %14
        \\
        ,
        .expected_bc = null,
    },

    // Constant folding and propagation
    .{
        .source =
        \\if (null ?? "foo") {
        \\  do {
        \\    1 + 2 + 3;
        \\  } while (0);
        \\}
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..8  ]                       label
        \\  %1: [  1..1  ] dead                  undefined
        \\  %2: [  2..3  ]                       number 6
        \\  %3: [  3..3  ]                       br %4, %2
        \\  %4: [  4..10 ]                       label
        \\  %5: [  5..6  ]                       zero
        \\  %6: [  6..6  ]                       br_cond %5, %7, %9
        \\  %7: [  7..7  ]                       label
        \\  %8: [  8..8  ]                       br %0, %4
        \\  %9: [  9..9  ]                       label
        \\ %10: [ 10..10 ]                       br %11, %4
        \\ %11: [ 11..12 ]                       label
        \\ %12: [ 12..12 ]                       return %11
        \\
        ,
        .expected_bc = null,
    },

    // Array literal
    .{
        .source =
        \\[1, , [2, 3], {x: 4}];
        \\
        ,
        .expected_result = .ignore,
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..14 ]                       array_create 4
        \\  %1: [  1..2  ]                       one
        \\  %2: [  2..2  ]                       array_push %0, %1
        \\  %3: [  3..3  ]                       array_push %0, none
        \\  %4: [  4..9  ]                       array_create 2
        \\  %5: [  5..6  ]                       number 2
        \\  %6: [  6..6  ]                       array_push %4, %5
        \\  %7: [  7..8  ]                       number 3
        \\  %8: [  8..8  ]                       array_push %4, %7
        \\  %9: [  9..9  ]                       array_push %0, %4
        \\ %10: [ 10..13 ]                       object_create
        \\ %11: [ 11..12 ]                       number 4
        \\ %12: [ 12..12 ]                       object_set %10, @0 ("x"), %11
        \\ %13: [ 13..13 ]                       array_push %0, %10
        \\ %14: [ 14..14 ]                       return %0
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 0d 00 00 04 00 00 00             array_create r0, 4
        \\   7: 07 01 00 01                      load_number_i8 r1, 1
        \\  11: 10 00 00 01 00 00 00 00 00       array_set r0, r1, 0
        \\  20: 0d 01 00 02 00 00 00             array_create r1, 2
        \\  27: 07 02 00 02                      load_number_i8 r2, 2
        \\  31: 10 01 00 02 00 00 00 00 00       array_set r1, r2, 0
        \\  40: 07 02 00 03                      load_number_i8 r2, 3
        \\  44: 10 01 00 02 00 01 00 00 00       array_set r1, r2, 1
        \\  53: 10 00 00 01 00 02 00 00 00       array_set r0, r1, 2
        \\  62: 12 01 00                         object_create r1
        \\  65: 07 02 00 04                      load_number_i8 r2, 4
        \\  69: 13 01 00 00 00 00 00 02 00       object_set r1, @0 ("x"), r2
        \\  78: 10 00 00 01 00 03 00 00 00       array_set r0, r1, 3
        \\  87: 91 00 00                         return r0
        \\
        ,
    },

    // Object literal
    .{
        .source =
        \\var a = 1;
        \\var o = {c: 2};
        \\var p = {};
        \\({a, [2]: "two", b: 3, ...o, __proto__: p});
        \\
        ,
        .expected_result = .ignore,
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       one
        \\  %1: [  1..1  ]                       set_binding @0 ("a"), %0
        \\  %2: [  2..5  ]                       object_create
        \\  %3: [  3..4  ]                       number 2
        \\  %4: [  4..4  ]                       object_set %2, @1 ("c"), %3
        \\  %5: [  5..5  ]                       set_binding @2 ("o"), %2
        \\  %6: [  6..7  ]                       object_create
        \\  %7: [  7..7  ]                       set_binding @3 ("p"), %6
        \\  %8: [  8..20 ]                       object_create
        \\  %9: [  9..10 ]                       get_binding @0 ("a")
        \\ %10: [ 10..10 ]                       object_set %8, @0 ("a"), %9
        \\ %11: [ 11..13 ]                       number 2
        \\ %12: [ 12..13 ]                       string @4 ("two")
        \\ %13: [ 13..13 ]                       object_set_computed %8, %11, %12
        \\ %14: [ 14..15 ]                       number 3
        \\ %15: [ 15..15 ]                       object_set %8, @5 ("b"), %14
        \\ %16: [ 16..17 ]                       get_binding @2 ("o")
        \\ %17: [ 17..17 ]                       object_spread %8, %16
        \\ %18: [ 18..19 ]                       get_binding @3 ("p")
        \\ %19: [ 19..19 ]                       object_set_prototype %8, %18
        \\ %20: [ 20..20 ]                       return %8
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 01                      load_number_i8 r0, 1
        \\   4: 47 00 00 00 00 00 00             set_binding @0 ("a"), r0
        \\  11: 12 00 00                         object_create r0
        \\  14: 07 01 00 02                      load_number_i8 r1, 2
        \\  18: 13 00 00 01 00 00 00 01 00       object_set r0, @1 ("c"), r1
        \\  27: 47 02 00 00 00 00 00             set_binding @2 ("o"), r0
        \\  34: 12 00 00                         object_create r0
        \\  37: 47 03 00 00 00 00 00             set_binding @3 ("p"), r0
        \\  44: 12 00 00                         object_create r0
        \\  47: 43 01 00 00 00 00 00             get_binding r1, @0 ("a")
        \\  54: 13 00 00 00 00 00 00 01 00       object_set r0, @0 ("a"), r1
        \\  63: 07 01 00 02                      load_number_i8 r1, 2
        \\  67: 0a 02 00 04 00 00 00             load_string r2, @4 ("two")
        \\  74: 14 00 00 01 00 02 00             object_set_computed r0, r1, r2
        \\  81: 07 01 00 03                      load_number_i8 r1, 3
        \\  85: 13 00 00 05 00 00 00 01 00       object_set r0, @5 ("b"), r1
        \\  94: 43 01 00 02 00 00 00             get_binding r1, @2 ("o")
        \\ 101: 1a 00 00 01 00                   object_spread r0, r1
        \\ 106: 43 01 00 03 00 00 00             get_binding r1, @3 ("p")
        \\ 113: 19 00 00 01 00                   object_set_prototype r0, r1
        \\ 118: 91 00 00                         return r0
        \\
        ,
    },

    // Regular expression literal
    .{
        .source =
        \\/abc/gi;
        \\
        ,
        .expected_result = .ignore,
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       reg_exp @0 ("abc"), @1 ("gi")
        \\  %1: [  1..1  ]                       return %0
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 1b 00 00 00 00 00 00 01 00 00 00 reg_exp_create r0, @0 ("abc"), @1 ("gi")
        \\  11: 91 00 00                         return r0
        \\
        ,
    },

    // Variable statements
    .{
        .source =
        \\var x = 1;
        \\
        ,
        .expected_result = .{ .value = null },
        .expected_ir = null,
        .expected_bc = null,
    },
    .{
        .source =
        \\var x = 10, y = 20;
        \\x + y;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 30 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       number 10
        \\  %1: [  1..1  ]                       set_binding @0 ("x"), %0
        \\  %2: [  2..3  ]                       number 20
        \\  %3: [  3..3  ]                       set_binding @1 ("y"), %2
        \\  %4: [  4..6  ]                       get_binding @0 ("x")
        \\  %5: [  5..6  ]                       get_binding @1 ("y")
        \\  %6: [  6..7  ]                       add %4, %5
        \\  %7: [  7..7  ]                       return %6
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 0a                      load_number_i8 r0, 10
        \\   4: 47 00 00 00 00 00 00             set_binding @0 ("x"), r0
        \\  11: 07 00 00 14                      load_number_i8 r0, 20
        \\  15: 47 01 00 00 00 00 00             set_binding @1 ("y"), r0
        \\  22: 43 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  29: 43 01 00 01 00 00 00             get_binding r1, @1 ("y")
        \\  36: 26 02 00 00 00 01 00             add r2, r0, r1
        \\  43: 91 02 00                         return r2
        \\
        ,
    },

    // Lexical declarations
    .{
        .source =
        \\let a = 1;
        \\{
        \\  let a = 2;
        \\}
        \\a;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 1 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       one
        \\  %1: [  1..1  ]                       initialize_binding @0 ("a"), %0
        \\  %2: [  2..2  ]                       push_scope
        \\  %3: [  3..3  ]                       create_mutable_binding @0 ("a")
        \\  %4: [  4..5  ]                       number 2
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ]                       pop_scope
        \\  %7: [  7..8  ]                       get_binding @0 ("a")
        \\  %8: [  8..8  ]                       return %7
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 01                      load_number_i8 r0, 1
        \\   4: 42 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  11: 3c                               push_scope
        \\  12: 40 00 00 00 00                   create_mutable_binding @0 ("a")
        \\  17: 07 00 00 02                      load_number_i8 r0, 2
        \\  21: 42 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  28: 3f                               pop_scope
        \\  29: 43 00 00 00 00 00 00             get_binding r0, @0 ("a")
        \\  36: 91 00 00                         return r0
        \\
        ,
    },

    // Increment/decrement operators
    .{
        .source =
        \\x = 5;
        \\++x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..1  ]                       number 5
        \\  %1: [  1..1  ]                       set_binding @0 ("x"), %0
        \\  %2: [  2..3  ]                       update_binding @0 ("x"), increment_prefix
        \\  %3: [  3..3  ]                       return %2
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 05                      load_number_i8 r0, 5
        \\   4: 47 00 00 00 00 00 00             set_binding @0 ("x"), r0
        \\  11: 4f 00 00 00 00 00 00             increment_binding_prefix r0, @0 ("x")
        \\  18: 91 00 00                         return r0
        \\
        ,
    },
    .{
        .source = "x = 5; x++;",
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_ir = null,
        .expected_bc = null,
    },
    .{
        .source = "x = 10; --x;",
        .expected_result = .{ .value = .{ .number = 9 } },
        .expected_ir = null,
        .expected_bc = null,
    },
    .{
        .source = "x = 10; x--;",
        .expected_result = .{ .value = .{ .number = 10 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Logical expression
    .{
        .source =
        \\false && doesnotexist;
        \\true || doesnotexist;
        \\1 ?? doesnotexist;
        \\
        \\var x = 0;
        \\true && (x += 1);
        \\false || (x += 2);
        \\null ?? (x += 3);
        \\x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..0  ] dead                  false
        \\  %1: [  1..1  ] dead                  true
        \\  %2: [  2..2  ] dead                  one
        \\  %3: [  3..4  ]                       zero
        \\  %4: [  4..4  ]                       set_binding @0 ("x"), %3
        \\  %5: [  5..8  ]                       true
        \\  %6: [  6..6  ]                       br_cond %5, %9, %7
        \\  %7: [  7..7  ]                       label
        \\  %8: [  8..8  ]                       br %15, %5
        \\  %9: [  9..9  ]                       label
        \\ %10: [ 10..12 ]                       get_binding @0 ("x")
        \\ %11: [ 11..12 ]                       one
        \\ %12: [ 12..13 ]                       add %10, %11
        \\ %13: [ 13..14 ]                       set_binding @0 ("x"), %12
        \\ %14: [ 14..14 ]                       br %15, %13
        \\ %15: [ 15..15 ]                       label
        \\ %16: [ 16..19 ]                       false
        \\ %17: [ 17..17 ]                       br_cond %16, %18, %20
        \\ %18: [ 18..18 ]                       label
        \\ %19: [ 19..19 ]                       br %26, %16
        \\ %20: [ 20..20 ]                       label
        \\ %21: [ 21..23 ]                       get_binding @0 ("x")
        \\ %22: [ 22..23 ]                       number 2
        \\ %23: [ 23..24 ]                       add %21, %22
        \\ %24: [ 24..25 ]                       set_binding @0 ("x"), %23
        \\ %25: [ 25..25 ]                       br %26, %24
        \\ %26: [ 26..26 ]                       label
        \\ %27: [ 27..32 ]                       null
        \\ %28: [ 28..29 ]                       null
        \\ %29: [ 29..30 ]                       eq %27, %28
        \\ %30: [ 30..30 ]                       br_cond %29, %33, %31
        \\ %31: [ 31..31 ]                       label
        \\ %32: [ 32..32 ]                       br %39, %27
        \\ %33: [ 33..33 ]                       label
        \\ %34: [ 34..36 ]                       get_binding @0 ("x")
        \\ %35: [ 35..36 ]                       number 3
        \\ %36: [ 36..37 ]                       add %34, %35
        \\ %37: [ 37..38 ]                       set_binding @0 ("x"), %36
        \\ %38: [ 38..38 ]                       br %39, %37
        \\ %39: [ 39..39 ]                       label
        \\ %40: [ 40..41 ]                       get_binding @0 ("x")
        \\ %41: [ 41..41 ]                       return %40
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 07 00 00 00                      load_number_i8 r0, 0
        \\   4: 47 00 00 00 00 00 00             set_binding @0 ("x"), r0
        \\  11: 05 00 00                         load_true r0
        \\  14: 01 00 00 05 00 00 00             jump_if_true r0, 5
        \\  21: 00 23 00 00 00                   jump 35
        \\  26: 43 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  33: 07 01 00 01                      load_number_i8 r1, 1
        \\  37: 26 02 00 00 00 01 00             add r2, r0, r1
        \\  44: 47 00 00 00 00 02 00             set_binding @0 ("x"), r2
        \\  51: 0c 00 00 02 00                   move r0, r2
        \\  56: 00 00 00 00 00                   jump 0
        \\  61: 06 00 00                         load_false r0
        \\  64: 01 00 00 05 00 00 00             jump_if_true r0, 5
        \\  71: 00 05 00 00 00                   jump 5
        \\  76: 00 1e 00 00 00                   jump 30
        \\  81: 43 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  88: 07 01 00 02                      load_number_i8 r1, 2
        \\  92: 26 02 00 00 00 01 00             add r2, r0, r1
        \\  99: 47 00 00 00 00 02 00             set_binding @0 ("x"), r2
        \\ 106: 0c 00 00 02 00                   move r0, r2
        \\ 111: 04 00 00                         load_null r0
        \\ 114: 04 01 00                         load_null r1
        \\ 117: 38 02 00 00 00 01 00             eq r2, r0, r1
        \\ 124: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 131: 00 23 00 00 00                   jump 35
        \\ 136: 43 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\ 143: 07 01 00 03                      load_number_i8 r1, 3
        \\ 147: 26 02 00 00 00 01 00             add r2, r0, r1
        \\ 154: 47 00 00 00 00 02 00             set_binding @0 ("x"), r2
        \\ 161: 0c 00 00 02 00                   move r0, r2
        \\ 166: 00 00 00 00 00                   jump 0
        \\ 171: 43 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\ 178: 91 00 00                         return r0
        \\
        ,
    },

    // Call expressions
    .{
        .source =
        \\Math.random();
        \\Number("1");
        \\JSON.stringify({ foo: "bar" }, null, 2)
        \\Math.max(1, 5, ...[3, 9], 2);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 9 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..2  ]                       get_binding @0 ("Math")
        \\  %1: [  1..2  ]                       get_property %0, @1 ("random")
        \\  %2: [  2..2  ]                       call %1, %0, []
        \\  %3: [  3..5  ]                       get_binding @2 ("Number")
        \\  %4: [  4..5  ]                       string @3 ("1")
        \\  %5: [  5..5  ]                       call %3, none, [%4]
        \\  %6: [  6..13 ]                       get_binding @4 ("JSON")
        \\  %7: [  7..13 ]                       get_property %6, @5 ("stringify")
        \\  %8: [  8..13 ]                       object_create
        \\  %9: [  9..10 ]                       string @7 ("bar")
        \\ %10: [ 10..10 ]                       object_set %8, @6 ("foo"), %9
        \\ %11: [ 11..13 ]                       null
        \\ %12: [ 12..13 ]                       number 2
        \\ %13: [ 13..13 ]                       call %7, %6, [%8, %11, %12]
        \\ %14: [ 14..25 ]                       get_binding @0 ("Math")
        \\ %15: [ 15..25 ]                       get_property %14, @8 ("max")
        \\ %16: [ 16..25 ]                       one
        \\ %17: [ 17..25 ]                       number 5
        \\ %18: [ 18..23 ]                       array_create 2
        \\ %19: [ 19..20 ]                       number 3
        \\ %20: [ 20..20 ]                       array_push %18, %19
        \\ %21: [ 21..22 ]                       number 9
        \\ %22: [ 22..22 ]                       array_push %18, %21
        \\ %23: [ 23..25 ]                       spread %18
        \\ %24: [ 24..25 ]                       number 2
        \\ %25: [ 25..26 ]                       call %15, %14, [%16, %17, %23, %24]
        \\ %26: [ 26..26 ]                       return %25
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 43 00 00 00 00 00 00             get_binding r0, @0 ("Math")
        \\   7: 44 01 00 00 00 01 00 00 00 00 00 get_property r1, r0, @1 ("random"), @0
        \\  18: 7c 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  25: 43 00 00 02 00 00 00             get_binding r0, @2 ("Number")
        \\  32: 0a 01 00 03 00 00 00             load_string r1, @3 ("1")
        \\  39: 79 02 00 00 00 01 00             call1 r2, r0, r1
        \\  46: 43 00 00 04 00 00 00             get_binding r0, @4 ("JSON")
        \\  53: 44 01 00 00 00 05 00 00 00 01 00 get_property r1, r0, @5 ("stringify"), @1
        \\  64: 12 02 00                         object_create r2
        \\  67: 0a 03 00 07 00 00 00             load_string r3, @7 ("bar")
        \\  74: 13 02 00 06 00 00 00 03 00       object_set r2, @6 ("foo"), r3
        \\  83: 04 03 00                         load_null r3
        \\  86: 07 04 00 02                      load_number_i8 r4, 2
        \\  90: 0d 07 00 00 00 00 00             array_create r7, 0
        \\  97: 0e 07 00 02 00                   array_push r7, r2
        \\ 102: 0e 07 00 03 00                   array_push r7, r3
        \\ 107: 0e 07 00 04 00                   array_push r7, r4
        \\ 112: 7b 05 00 01 00 00 00 07 00       call_property r5, r1, r0, r7
        \\ 121: 43 00 00 00 00 00 00             get_binding r0, @0 ("Math")
        \\ 128: 44 01 00 00 00 08 00 00 00 02 00 get_property r1, r0, @8 ("max"), @2
        \\ 139: 07 02 00 01                      load_number_i8 r2, 1
        \\ 143: 07 03 00 05                      load_number_i8 r3, 5
        \\ 147: 0d 04 00 02 00 00 00             array_create r4, 2
        \\ 154: 07 05 00 03                      load_number_i8 r5, 3
        \\ 158: 10 04 00 05 00 00 00 00 00       array_set r4, r5, 0
        \\ 167: 07 05 00 09                      load_number_i8 r5, 9
        \\ 171: 10 04 00 05 00 01 00 00 00       array_set r4, r5, 1
        \\ 180: 0c 05 00 04 00                   move r5, r4
        \\ 185: 07 04 00 02                      load_number_i8 r4, 2
        \\ 189: 0d 07 00 00 00 00 00             array_create r7, 0
        \\ 196: 0e 07 00 02 00                   array_push r7, r2
        \\ 201: 0e 07 00 03 00                   array_push r7, r3
        \\ 206: 11 07 00 05 00                   array_spread r7, r5
        \\ 211: 0e 07 00 04 00                   array_push r7, r4
        \\ 216: 7b 06 00 01 00 00 00 07 00       call_property r6, r1, r0, r7
        \\ 225: 91 06 00                         return r6
        \\
        ,
    },

    // Destructuring assignment
    .{
        .source =
        \\const {a, ...rest} = {a: 1, b: 2, c: 3};
        \\const [x, y] = [10, 20];
        \\const {d: {e}} = {d: {e: 5}};
        \\const {f = 99} = {f: undefined};
        \\const g = ({} = {g: 42}).g;
        \\
        \\rest.b + x + e + f + g;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 158 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..7  ]                       object_create
        \\  %1: [  1..2  ]                       one
        \\  %2: [  2..2  ]                       object_set %0, @0 ("a"), %1
        \\  %3: [  3..4  ]                       number 2
        \\  %4: [  4..4  ]                       object_set %0, @1 ("b"), %3
        \\  %5: [  5..6  ]                       number 3
