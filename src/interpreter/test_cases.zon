    // Destructuring assignment
    .{
        .source =
        \\const {a, ...rest} = {a: 1, b: 2, c: 3};
        \\const [x, y] = [10, 20];
        \\const {d: {e}} = {d: {e: 5}};
        \\const {f = 99} = {f: undefined};
        \\const g = ({} = {g: 42}).g;
        \\
        \\rest.b + x + e + f + g;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 158 } },
        .expected_output =
