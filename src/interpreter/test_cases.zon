        \\  10: 76 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 02                      load_number_i8 r0, 2
        \\  19: 76 01 00 00 00                   yield r1, r0
        \\  24: 07 00 00 03                      load_number_i8 r0, 3
        \\  28: 76 01 00 00 00                   yield r1, r0
        \\  33: 74 ff ff                         return
        \\
        ,
    },

    // Classes
    .{
        .source =
        \\class Foo {
        \\  #x;
        \\  constructor(x) { this.#x = x; }
        \\  getX() { return this.#x; }
        \\}
        \\class Bar extends Foo {
        \\  constructor(x) { super(x); }
        \\  getX() { return super.getX() + 1; }
        \\}
        \\var bar = new Bar(42);
        \\bar.getX();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 43 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..0  ]                       push_private_scope
        \\  %1: [  1..3  ]                       create_private_element @1 ("x")
        \\  %2: [  2..3  ]                       string @2 ("getX")
        \\  %3: [  3..5  ]                       create_class @0, none, [%1, %2]
        \\  %4: [  4..4  ]                       pop_private_scope
        \\  %5: [  5..5  ]                       initialize_binding @0 ("Foo"), %3
        \\  %6: [  6..9  ]                       get_binding @0 ("Foo")
        \\  %7: [  7..7  ]                       push_private_scope
        \\  %8: [  8..9  ]                       string @2 ("getX")
        \\  %9: [  9..11 ]                       create_class @1, %6, [%8]
        \\ %10: [ 10..10 ]                       pop_private_scope
        \\ %11: [ 11..11 ]                       initialize_binding @3 ("Bar"), %9
        \\ %12: [ 12..14 ]                       get_binding @3 ("Bar")
        \\ %13: [ 13..14 ]                       number 42
        \\ %14: [ 14..15 ]                       construct %12, [%13]
        \\ %15: [ 15..15 ]                       set_binding @4 ("bar"), %14
        \\ %16: [ 16..18 ]                       get_binding @4 ("bar")
        \\ %17: [ 17..18 ]                       get_property %16, @2 ("getX")
        \\ %18: [ 18..19 ]                       call %17, %16, []
        \\ %19: [ 19..19 ]                       return %18
        \\
        \\Bytecode (test)
        \\   0: 87                               push_private_scope
        \\   1: 89 00 00 01 00 00 00             create_private_element r0, @1 ("x")
        \\   8: 0a 01 00 02 00 00 00             load_string r1, @2 ("getX")
        \\  15: 79 02 00 00 00                   create_class r2, @0
        \\  20: 88                               pop_private_scope
        \\  21: 45 00 00 00 00 02 00             initialize_binding @0 ("Foo"), r2
        \\  28: 46 00 00 00 00 00 00             get_binding r0, @0 ("Foo")
        \\  35: 87                               push_private_scope
        \\  36: 0a 01 00 02 00 00 00             load_string r1, @2 ("getX")
        \\  43: 79 02 00 01 00                   create_class r2, @1
        \\  48: 88                               pop_private_scope
        \\  49: 45 03 00 00 00 02 00             initialize_binding @3 ("Bar"), r2
        \\  56: 46 00 00 03 00 00 00             get_binding r0, @3 ("Bar")
        \\  63: 07 01 00 2a                      load_number_i8 r1, 42
        \\  67: 66 02 00 00 00 01 00             construct1 r2, r0, r1
        \\  74: 4a 04 00 00 00 02 00             set_binding @4 ("bar"), r2
        \\  81: 46 00 00 04 00 00 00             get_binding r0, @4 ("bar")
        \\  88: 47 01 00 00 00 02 00 00 00 00 00 get_property r1, r0, @2 ("getX"), @0
        \\  99: 5f 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\ 106: 74 02 00                         return r2
        \\
        \\IR (Bar)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("x")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("x"), %1
        \\  %3: [  3..4  ]                       get_binding @0 ("x")
        \\  %4: [  4..4  ]                       super_call [%3]
        \\  %5: [  5..5  ]                       return none
        \\
        \\Bytecode (Bar)
        \\   0: 43 00 00 00 00                   create_mutable_binding @0 ("x")
        \\   5: 7d 00 00 00 00                   get_argument r0, 0
        \\  10: 45 00 00 00 00 00 00             initialize_binding @0 ("x"), r0
        \\  17: 46 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  24: 0d 02 00 00 00 00 00             array_create r2, 0
        \\  31: 0e 02 00 00 00                   array_push r2, r0
        \\  36: 80 01 00 02 00                   super_call r1, r2
        \\  41: 74 ff ff                         return
        \\
        \\IR (Foo)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("x")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("x"), %1
        \\  %3: [  3..5  ]                       this
        \\  %4: [  4..5  ]                       get_binding @0 ("x")
        \\  %5: [  5..5  ]                       set_private_element %3, @0 ("x"), %4
        \\  %6: [  6..6  ]                       return none
        \\
        \\Bytecode (Foo)
        \\   0: 43 00 00 00 00                   create_mutable_binding @0 ("x")
        \\   5: 7d 00 00 00 00                   get_argument r0, 0
        \\  10: 45 00 00 00 00 00 00             initialize_binding @0 ("x"), r0
        \\  17: 1c 00 00                         resolve_this_binding r0
        \\  20: 46 01 00 00 00 00 00             get_binding r1, @0 ("x")
        \\  27: 8c 00 00 00 00 00 00 01 00       set_private_element r0, @0 ("x"), r1
        \\  36: 74 ff ff                         return
        \\
        \\IR (getX)
        \\  %0: [  0..2  ]                       this
        \\  %1: [  1..2  ]                       get_super_property @0 ("getX")
        \\  %2: [  2..4  ]                       call %1, %0, []
        \\  %3: [  3..4  ]                       one
        \\  %4: [  4..5  ]                       add %2, %3
        \\  %5: [  5..5  ]                       return %4
        \\  %6: [  6..6  ] dead                  return none
        \\
        \\Bytecode (getX)
        \\   0: 1c 00 00                         resolve_this_binding r0
        \\   3: 81 01 00 00 00 00 00             get_super_property r1, @0 ("getX")
        \\  10: 5f 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  17: 07 00 00 01                      load_number_i8 r0, 1
        \\  21: 28 01 00 02 00 00 00             add r1, r2, r0
        \\  28: 74 01 00                         return r1
        \\
        \\IR (getX)
        \\  %0: [  0..1  ]                       this
        \\  %1: [  1..2  ]                       get_private_element %0, @0 ("x")
        \\  %2: [  2..2  ]                       return %1
        \\  %3: [  3..3  ] dead                  return none
        \\
        \\Bytecode (getX)
        \\   0: 1c 00 00                         resolve_this_binding r0
        \\   3: 8b 01 00 00 00 00 00 00 00       get_private_element r1, r0, @0 ("x")
        \\  12: 74 01 00                         return r1
        \\
        ,
    },

    // Call expression LHS
    .{
        .source =
        \\var calls = 0;
        \\var caught = 0;
        \\function foo() { calls += 1; }
        \\
        \\try { foo() = 1; } catch { caught += 1; }
        \\try { foo() += 1; } catch { caught += 1; }
        \\try { foo()++; } catch { caught += 1; }
        \\try { ++foo(); } catch { caught += 1; }
        \\try { for (foo() in {a: 1}); } catch { caught += 1; }
        \\
        \\calls * 10 + caught;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 55 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       zero
