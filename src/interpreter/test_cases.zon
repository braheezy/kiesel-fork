        \\ %24: [ 24..26 ]                       set_binding @0 ("x"), %23
        \\ %25: [ 25..25 ]                       label
        \\ %26: [ 26..26 ]                       br %34, %24
        \\ %27: [ 27..28 ]                       label
        \\ %28: [ 28..33 ]                       exception_handler %20, %27, %27, 0
        \\ %29: [ 29..31 ]                       get_binding @0 ("x")
