        \\  40: 0c 03 00 03 00 00 00             array_create r3, 3
        \\  47: 0f 03 00 00 00 00 00 00 00       array_set r3, r0, 0
        \\  56: 0f 03 00 01 00 01 00 00 00       array_set r3, r1, 1
        \\  65: 0f 03 00 02 00 02 00 00 00       array_set r3, r2, 2
        \\  74: 03 00 00                         load_undefined r0
        \\  77: 85 01 00 03 00                   get_iterator r1, r3
        \\  82: 89 02 00 01 00                   iterator_step_value r2, r1
        \\  87: 8c 03 00 01 00                   iterator_is_done r3, r1
        \\  92: 22 04 00 03 00                   logical_not r4, r3
        \\  97: 01 04 00 05 00 00 00             jump_if_true r4, 5
        \\ 104: 00 37 00 00 00                   jump 55
        \\ 109: 46 01 00 00 00 02 00             set_binding @1 ("x"), r2
        \\ 116: 0b 03 00 02 00                   move r3, r2
        \\ 121: 42 02 00 00 00 00 00             get_binding r2, @0 ("sum")
        \\ 128: 42 03 00 01 00 00 00             get_binding r3, @1 ("x")
        \\ 135: 25 04 00 02 00 03 00             add r4, r2, r3
        \\ 142: 46 00 00 00 00 04 00             set_binding @0 ("sum"), r4
        \\ 149: 0b 02 00 04 00                   move r2, r4
        \\ 154: 0b 00 00 02 00                   move r0, r2
        \\ 159: 00 ae ff ff ff                   jump -82
        \\ 164: 42 00 00 00 00 00 00             get_binding r0, @0 ("sum")
        \\ 171: 90 00 00                         return r0
        \\
        ,
    },

    // For-in/of with member expression LHS
    .{
        .source =
        \\var x = {};
        \\for (x.last in {a: 1, b: 2, c: 3});
        \\x.last;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "c" } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // With statement
    .{
        .source =
        \\var o = {x: 1};
        \\with (o) { x }
        \\
        ,
        .expected_result = .{ .value = .{ .number = 1 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..2  ]                       string @0 ("x")
        \\  %1: [  1..2  ]                       one
        \\  %2: [  2..3  ]                       object {%0: %1}
        \\  %3: [  3..3  ]                       set_binding @1 ("o"), %2
        \\  %4: [  4..5  ]                       get_binding @1 ("o")
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..6  ]                       push_with_scope %5
        \\  %7: [  7..9  ]                       get_binding @0 ("x")
        \\  %8: [  8..8  ]                       pop_scope
        \\  %9: [  9..9  ]                       return %7
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 09 00 00 00 00 00 00             load_string r0, @0 ("x")
        \\   7: 07 01 00 01 00 00 00             load_number_i32 r1, 1
        \\  14: 11 02 00                         object_create r2
        \\  17: 12 02 00 00 00 00 00 01 00       object_set r2, @0 ("x"), r1
        \\  26: 46 01 00 00 00 02 00             set_binding @1 ("o"), r2
        \\  33: 0b 00 00 02 00                   move r0, r2
        \\  38: 42 00 00 01 00 00 00             get_binding r0, @1 ("o")
        \\  45: 1f 01 00 00 00                   to_object r1, r0
        \\  50: 3d 01 00                         push_with_scope r1
        \\  53: 42 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  60: 3e                               pop_scope
        \\  61: 90 00 00                         return r0
        \\
        ,
    },

    // Optional expression
    .{
        .source =
        \\var o = {a: {b: 123}};
        \\o.x?.y ?? o.a?.["b"];
        \\
        ,
        .expected_result = .{ .value = .{ .number = 123 } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..4  ]                       string @0 ("a")
        \\  %1: [  1..3  ]                       string @1 ("b")
        \\  %2: [  2..3  ]                       number 123
        \\  %3: [  3..4  ]                       object {%1: %2}
        \\  %4: [  4..5  ]                       object {%0: %3}
        \\  %5: [  5..5  ]                       set_binding @2 ("o"), %4
        \\  %6: [  6..7  ]                       get_binding @2 ("o")
        \\  %7: [  7..12 ]                       get_property %6, @3 ("x")
        \\  %8: [  8..9  ]                       null
        \\  %9: [  9..10 ]                       eq %7, %8
        \\ %10: [ 10..10 ]                       br_cond %9, %14, %11
        \\ %11: [ 11..11 ]                       label
        \\ %12: [ 12..13 ]                       get_property %7, @4 ("y")
        \\ %13: [ 13..13 ]                       br %17, %12
        \\ %14: [ 14..14 ]                       label
        \\ %15: [ 15..16 ]                       undefined
        \\ %16: [ 16..16 ]                       br %17, %15
        \\ %17: [ 17..22 ]                       label
        \\ %18: [ 18..19 ]                       null
        \\ %19: [ 19..20 ]                       eq %17, %18
        \\ %20: [ 20..20 ]                       br_cond %19, %23, %21
        \\ %21: [ 21..21 ]                       label
        \\ %22: [ 22..22 ]                       br %37, %17
        \\ %23: [ 23..23 ]                       label
        \\ %24: [ 24..25 ]                       get_binding @2 ("o")
        \\ %25: [ 25..30 ]                       get_property %24, @0 ("a")
        \\ %26: [ 26..27 ]                       null
        \\ %27: [ 27..28 ]                       eq %25, %26
        \\ %28: [ 28..28 ]                       br_cond %27, %32, %29
        \\ %29: [ 29..29 ]                       label
        \\ %30: [ 30..31 ]                       get_property %25, @1 ("b")
        \\ %31: [ 31..31 ]                       br %35, %30
        \\ %32: [ 32..32 ]                       label
        \\ %33: [ 33..34 ]                       undefined
        \\ %34: [ 34..34 ]                       br %35, %33
        \\ %35: [ 35..36 ]                       label
        \\ %36: [ 36..36 ]                       br %37, %35
        \\ %37: [ 37..38 ]                       label
        \\ %38: [ 38..38 ]                       return %37
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 09 00 00 00 00 00 00             load_string r0, @0 ("a")
        \\   7: 09 01 00 01 00 00 00             load_string r1, @1 ("b")
        \\  14: 07 02 00 7b 00 00 00             load_number_i32 r2, 123
        \\  21: 11 03 00                         object_create r3
        \\  24: 12 03 00 01 00 00 00 02 00       object_set r3, @1 ("b"), r2
        \\  33: 11 01 00                         object_create r1
        \\  36: 12 01 00 00 00 00 00 03 00       object_set r1, @0 ("a"), r3
        \\  45: 46 02 00 00 00 01 00             set_binding @2 ("o"), r1
        \\  52: 0b 00 00 01 00                   move r0, r1
        \\  57: 42 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\  64: 43 01 00 00 00 03 00 00 00 00 00 get_property r1, r0, @3 ("x"), @0
        \\  75: 04 00 00                         load_null r0
        \\  78: 37 02 00 01 00 00 00             eq r2, r1, r0
        \\  85: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  92: 00 08 00 00 00                   jump 8
        \\  97: 03 00 00                         load_undefined r0
        \\ 100: 00 0b 00 00 00                   jump 11
        \\ 105: 43 00 00 01 00 04 00 00 00 01 00 get_property r0, r1, @4 ("y"), @1
        \\ 116: 04 01 00                         load_null r1
        \\ 119: 37 02 00 00 00 01 00             eq r2, r0, r1
        \\ 126: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 133: 00 40 00 00 00                   jump 64
        \\ 138: 42 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\ 145: 43 01 00 00 00 00 00 00 00 02 00 get_property r1, r0, @0 ("a"), @2
        \\ 156: 04 00 00                         load_null r0
        \\ 159: 37 02 00 01 00 00 00             eq r2, r1, r0
        \\ 166: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 173: 00 08 00 00 00                   jump 8
        \\ 178: 03 00 00                         load_undefined r0
        \\ 181: 00 0b 00 00 00                   jump 11
        \\ 186: 43 00 00 01 00 01 00 00 00 03 00 get_property r0, r1, @1 ("b"), @3
        \\ 197: 00 00 00 00 00                   jump 0
        \\ 202: 90 00 00                         return r0
        \\
        ,
    },

    // Tagged template
    .{
        .source =
        \\String.raw`a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..10 ]                       get_binding @0 ("String")
        \\  %1: [  1..10 ]                       get_property %0, @1 ("raw")
        \\  %2: [  2..4  ]                       string @2 ("a")
        \\  %3: [  3..4  ]                       string @3 ("c")
        \\  %4: [  4..8  ]                       array [%2, %3]
        \\  %5: [  5..7  ]                       string @2 ("a")
        \\  %6: [  6..7  ]                       string @3 ("c")
        \\  %7: [  7..8  ]                       array [%5, %6]
        \\  %8: [  8..10 ]                       get_template_object %4, %7, 0
        \\  %9: [  9..10 ]                       string @4 ("b")
        \\ %10: [ 10..11 ]                       call %1, %0, [%8, %9]
        \\ %11: [ 11..11 ]                       return %10
        \\
        ,
        .expected_bc =
        \\Bytecode (test)
        \\   0: 42 00 00 00 00 00 00             get_binding r0, @0 ("String")
        \\   7: 43 01 00 00 00 01 00 00 00 00 00 get_property r1, r0, @1 ("raw"), @0
        \\  18: 09 02 00 02 00 00 00             load_string r2, @2 ("a")
        \\  25: 09 03 00 03 00 00 00             load_string r3, @3 ("c")
        \\  32: 0c 04 00 02 00 00 00             array_create r4, 2
        \\  39: 0f 04 00 02 00 00 00 00 00       array_set r4, r2, 0
        \\  48: 0f 04 00 03 00 01 00 00 00       array_set r4, r3, 1
        \\  57: 09 02 00 02 00 00 00             load_string r2, @2 ("a")
        \\  64: 09 03 00 03 00 00 00             load_string r3, @3 ("c")
        \\  71: 0c 05 00 02 00 00 00             array_create r5, 2
        \\  78: 0f 05 00 02 00 00 00 00 00       array_set r5, r2, 0
        \\  87: 0f 05 00 03 00 01 00 00 00       array_set r5, r3, 1
        \\  96: 84 02 00 04 00 05 00 00 00       get_template_object r2, r4, r5, 0
        \\ 105: 09 03 00 04 00 00 00             load_string r3, @4 ("b")
        \\ 112: 7d 04 00 01 00 00 00 02 00 03 00 call_property2 r4, r1, r0, r2, r3
        \\ 123: 90 04 00                         return r4
        \\
        ,
    },

    // Functions
    .{
        .source =
        \\var f = ({a}, b = 0, ...rest) => a + b + rest.length;
        \\f({a: 1}, 2, 3, 4);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Arguments object
    .{
        .source =
        \\function mapped(a) {
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\function unmapped(a) {
        \\  "use strict";
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\mapped(1) - unmapped(1);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 98 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Getter/setter
    .{
        .source =
        \\var o = {
        \\  get x() { return this._x; },
        \\  set x(v) { this._x = v; },
        \\};
        \\o.x = 42;
        \\o.x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 42 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Generator
    .{
        .source =
        \\function* h() {
        \\  yield 4;
        \\  yield 5;
        \\}
        \\function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\  yield* h();
        \\}
        \\function f() {
        \\  var gen = g();
        \\  var sum = 0;
        \\  while (true) {
        \\    var result = gen.next();
        \\    if (result.done) break;
        \\    sum += result.value;
        \\  }
        \\  return sum;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 15 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Async Generator
    .{
        .source =
        \\async function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\}
        \\async function f() {
        \\  var gen = g();
        \\  var a = await gen.next();
        \\  var b = await gen.next();
        \\  var c = await gen.next();
        \\  return a.value + b.value + c.value;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .promise = .{ .fulfilled = .{ .number = 6 } } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Classes
    .{
        .source =
        \\class Foo {
        \\  #x;
        \\  constructor(x) { this.#x = x; }
        \\  getX() { return this.#x; }
        \\}
        \\class Bar extends Foo {
        \\  constructor(x) { super(x); }
        \\  getX() { return super.getX() + 1; }
        \\}
        \\var bar = new Bar(42);
        \\bar.getX();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 43 } },
        .expected_ir = null,
        .expected_bc = null,
    },

    // Call expression LHS
    .{
        .source =
        \\var calls = 0;
        \\var caught = 0;
        \\function foo() { calls += 1; }
        \\
        \\try { foo() = 1; } catch { caught += 1; }
        \\try { foo() += 1; } catch { caught += 1; }
        \\try { foo()++; } catch { caught += 1; }
        \\try { ++foo(); } catch { caught += 1; }
        \\try { for (foo() in {a: 1}); } catch { caught += 1; }
        \\
        \\calls * 10 + caught;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 55 } },
        .expected_ir = null,
        .expected_bc = null,
    },
}
