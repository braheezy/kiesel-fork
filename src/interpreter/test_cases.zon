    // Try statement
    .{
        .source =
        \\try {} catch {}
        \\
        ,
        .expected_result = .{ .value = .undefined },
        .expected_ir =
        \\IR (test)
        \\  %0: [  0..5  ]                       label
        \\  %1: [  1..3  ]                       undefined
        \\  %2: [  2..5  ]                       label
