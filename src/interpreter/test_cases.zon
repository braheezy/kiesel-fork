    // Loops
    .{
        .source =
        \\var x = 0;
        \\while(x < 3) { x = x + 1; }
        \\do { x = x + 1; } while(x < 5);
        \\for(var i = 0; i < 3; i++) { x = x + i; }
        \\x;
